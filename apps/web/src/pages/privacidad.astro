---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import SectionIndex from '../components/ui/SectionIndex.astro';
import { contact, telUrl } from '../data/contact';
import { SITE_CLAIMS, isLegalTextApproved, technicalProviders } from '../data/legal';
import { shouldRenderNewsletterForm } from '../data/newsletter';

/**
 * Privacidad.
 *
 * Página breve y de lectura directa. Dice qué datos recibe OrigenLab, por qué
 * canal llegan, qué no hace el sitio y quién interviene como proveedor
 * técnico. No declara cumplimiento legal completo, no inventa identidad
 * societaria y no enseña al visitante la lista de lo que falta por confirmar:
 * ese seguimiento es interno y vive en `docs/design/CONTENT_NEEDED.md`.
 *
 * Mientras `isLegalTextApproved()` sea falso la ruta va con `noindex`, fuera
 * del sitemap, con `Disallow` en robots.txt y con `X-Robots-Tag` en .htaccess.
 * Es una decisión de publicación, no un mensaje para el lector, y por eso no
 * aparece en la página.
 *
 * La frase sobre formularios sigue al hecho de **esta compilación**:
 * `validate:dist` falla si el sitio tiene formulario y sigue diciendo que no
 * tiene ninguno, o al revés.
 */
const approved = isLegalTextApproved();
const formRendered = shouldRenderNewsletterForm();
---

<Layout
  title="Privacidad"
  description="Qué hace OrigenLab con los datos que usted entrega al escribirnos, y qué no hace este sitio."
  noindex={!approved}
>
  <div class="shell">
    <PageIntro
      title="Privacidad"
      lead="OrigenLab usa los datos que usted entrega voluntariamente al escribirnos para responder su consulta comercial. Esta página explica en pocas líneas qué significa eso."
      crumbs={[{ label: 'Privacidad' }]}
    />
  </div>

  <section class="shell section rule-top" aria-labelledby="datos-title">
    <SectionIndex index={1} label="Sus datos" />
    <h2 id="datos-title" class="t-h2">Qué datos usamos y para qué</h2>

    <div class="prose mt-6">
      <p class="t-body">
        Usamos lo que usted nos entrega voluntariamente al escribirnos por correo, llamarnos por
        teléfono o abrir una conversación de WhatsApp: su nombre, su dirección de correo o su
        teléfono, el laboratorio al que pertenece y lo que nos cuente de su necesidad. Lo usamos
        para responder esa consulta comercial y para preparar la cotización que nos pide.
      </p>
      <p class="t-body">
        No compramos listas, no compartimos sus datos con terceros para su publicidad y no los
        usamos para perfilarlo.
      </p>
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="sitio-title">
    <SectionIndex index={2} label="El sitio" />
    <h2 id="sitio-title" class="t-h2">Qué no hace este sitio</h2>

    <div class="prose mt-6">
      <p class="t-body">
        No tiene cuentas de usuario, ni carrito, ni píxeles publicitarios, ni analítica, ni
        formularios comerciales activos.{' '}
        {!formRendered && <>{SITE_CLAIMS.noForms}: entrega páginas y nada más.</>}
        {formRendered && (
          <>
            El único formulario de esta compilación es el de suscripción, y envía a una ruta del
            propio dominio.
          </>
        )}
      </p>
      <p class="t-body">
        Tampoco carga scripts, tipografías, hojas de estilo ni imágenes de otro dominio. El detalle
        de cookies y almacenamiento del navegador está en{' '}
        <a class="link-plain" href="/cookies/">cookies</a>.
      </p>
      <p class="t-body">El boletín no está disponible actualmente.</p>
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="proveedores-title">
    <SectionIndex index={3} label="Proveedores" />
    <h2 id="proveedores-title" class="t-h2">Quién interviene</h2>

    <div class="prose mt-6">
      <p class="t-body">
        {technicalProviders.map((provider, index) => (
          <>
            {index > 0 && (index === technicalProviders.length - 1 ? ' y ' : ', ')}
            <strong>{provider.label}</strong> {provider.role}
          </>
        ))}. Intervienen como proveedores técnicos y sólo en la medida necesaria para operar el
        sitio y los canales de contacto.
      </p>
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="consultas-title">
    <SectionIndex index={4} label="Consultas" />
    <h2 id="consultas-title" class="t-h2">Consultas sobre privacidad</h2>

    <div class="prose mt-6">
      <p class="t-body">
        Escriba a <a class="link-plain" href={`mailto:${contact.email}`}>{contact.email}</a> y le
        respondemos por ese mismo canal. También puede llamarnos al{' '}
        <a class="link-plain" href={telUrl()}>{contact.phoneDisplay}</a>, de lunes a viernes entre
        las {contact.hours}.
      </p>
    </div>
  </section>
</Layout>

<style>
  .prose {
    max-width: 66ch;
  }
  .prose :global(p + p) {
    margin-top: 1rem;
  }
  .prose :global(p) {
    color: var(--color-ink-600);
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-ink-900);
  }
</style>

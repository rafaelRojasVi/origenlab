---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import SectionIndex from '../components/ui/SectionIndex.astro';
import ClosingQuoteBand from '../components/ui/ClosingQuoteBand.astro';
import Icon from '../components/ui/Icon.astro';
import LitCard from '../components/ui/LitCard.astro';
import IndustryTiles from '../components/ui/IndustryTiles.astro';
import { applications } from '../data/applications';
import { ctaLabels } from '../lib/ctaLabels';
import { familyForScope, familyHref } from '../lib/modelos';
import { rankFamilies, rankModels } from '../lib/ranking';
import { site } from '../config/site';
import type { Modelo } from '../content.config';

/**
 * Aplicaciones, por tarea (dueño, 2026-11-08: «llévame directo a la ficha»).
 *
 * Cada tarea es un bloque: una línea que dice qué se intenta hacer con la
 * muestra y, debajo, los modelos que la resuelven como `LitCard` (sobre el
 * tinte de su familia) que llevan directo a su ficha (sin pasar por la página de familia). Lo que
 * conviene traer a la conversación queda plegado bajo cada bloque.
 *
 * Orden comercial de `lib/ranking.ts`: las tareas por su familia principal
 * (`rankFamilies`: sonicación primero, dispersión al final) y los modelos por
 * `rankModels` (3D primero, IKA al final). Los modelos salen de la colección
 * `modelos`, nunca de este archivo; `validate:catalog` comprueba que ninguna
 * aplicación se quede sin familia.
 *
 * Debajo, las industrias (`IndustryTiles`, las mismas de la portada), cada una
 * hacia el bloque de su tarea: la otra forma de entrar.
 */
const all = (await getCollection('modelos')).map((item) => item.data as Modelo);
const ranked = rankModels(all.map((entry) => ({ id: entry.slug, entry }))).map(({ entry }) => entry);
const segment = (familyId: string) => {
  const slug = familyForScope(familyId);
  return slug ? (familyHref(slug).split('/')[2] ?? '') : '';
};
const tasks = rankFamilies(applications, (application) => segment(application.familyIds[0] ?? '')).map((application) => {
  const slugs = application.familyIds.map((id) => familyForScope(id)).filter(Boolean);
  return { application, models: ranked.filter((entry) => slugs.includes(entry.family)) };
});
---

<Layout
  title="Aplicaciones"
  description="Seis tareas de laboratorio y el equipo que las resuelve: ruptura celular, dispersión, centrifugación, pesaje, osmolalidad y electroforesis."
>
  <div class="shell">
    <PageIntro
      title="Aplicaciones"
      lead="Si sabe qué necesita hacer con la muestra pero no qué equipo pedir, empiece por aquí. Cada tarea muestra los equipos que la resuelven: toque uno y llega directo a su ficha."
      crumbs={[{ label: 'Aplicaciones' }]}
    />
  </div>

  <section class="shell section rule-top" aria-labelledby="tareas-title">
    <SectionIndex index={1} label="Por tarea" />
    <div class="tasks-head">
      <h2 id="tareas-title" class="t-h2">Qué necesita hacer con la muestra</h2>
      <p class="t-body tasks-head__body">
        No es una secuencia. Son seis trabajos independientes: un laboratorio puede necesitar sólo
        uno, o combinarlos en el orden que pida su método. Dos tareas pueden resolverse con la misma
        familia de equipo, y una familia sirve a más de una tarea.
      </p>
    </div>

    <div class="tasks">
      {
        tasks.map(({ application, models }, index) => (
          <article id={application.slug} class="task" aria-labelledby={`${application.slug}-title`}>
            <div class="task__lead">
              <p class="t-data task__num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3 id={`${application.slug}-title`} class="task__name">{application.name}</h3>
              <p class="task__task">{application.task}</p>
            </div>
            <ul class="task__models" aria-label={`Equipos para ${application.name.toLowerCase()}`}>
              {models.map((entry) => (
                <li>
                  <LitCard entry={entry} kicker="brand" heading="h4" />
                </li>
              ))}
            </ul>
            <div class="task__foot">
              <details class="task__bring">
                <summary>Qué traer a la conversación</summary>
                <ul>
                  {application.bring.map((item) => <li>{item}</li>)}
                </ul>
              </details>
              <a href={site.quoteHref} class="link-arrow task__cta">
                {ctaLabels.contarAplicacion}
                <Icon name="arrow-right" size={18} class="arrow" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="industrias-title">
    <SectionIndex index={2} label="Por industria" />
    <h2 id="industrias-title" class="t-h2 industries-title">Por industria</h2>
    <IndustryTiles />
  </section>

  <ClosingQuoteBand
    title="Describa la tarea, no el modelo."
    body="Con el tipo de muestra, el volumen de trabajo y la resolución o la fuerza que pide su método podemos acotar alternativas antes de emitir una cotización."
  />
</Layout>

<style>
  .tasks-head {
    display: grid;
    gap: 1.25rem;
  }
  .tasks-head__body {
    color: var(--color-ink-600);
  }
  .tasks {
    margin-top: 3rem;
  }
  .task {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--color-hairline);
    scroll-margin-top: 5rem;
  }
  .task__num {
    font-size: 0.8125rem;
    color: var(--color-teal-700);
  }
  .task__name {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--color-ink-950);
  }
  .task__task {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink-600);
    max-width: 62ch;
  }
  .task__models {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .task__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .task__bring summary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-ink-800);
    font-weight: 600;
    cursor: pointer;
  }
  .task__bring ul {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    max-width: 60ch;
  }
  .task__bring li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-600);
  }
  .task__bring li + li {
    margin-top: 0.4375rem;
  }
  /* Guion dibujado, no un carácter: un signo suelto en la copia lo marcaría
     `validate:dist` como semirraya. */
  .task__bring li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.4375rem;
    height: 1px;
    background-color: var(--color-teal-700);
  }
  .task__cta {
    min-height: 2.75rem;
  }

  .industries-title {
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .task__models {
      grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
      gap: 2.5rem 1.375rem;
    }
    .tasks-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 3rem;
      align-items: baseline;
    }
  }
</style>

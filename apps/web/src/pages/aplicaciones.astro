---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import SectionIndex from '../components/ui/SectionIndex.astro';
import ApplicationList from '../components/ui/ApplicationList.astro';
import ClosingQuoteBand from '../components/ui/ClosingQuoteBand.astro';
import Icon from '../components/ui/Icon.astro';
import { categories } from '../data/categories';
import { company } from '../data/company';
---

<Layout
  title="Aplicaciones"
  description="Las tres líneas de trabajo de OrigenLab: alimentos, control de calidad y laboratorio clínico, y los tipos de laboratorio que atendemos en todo Chile."
>
  <div class="shell">
    <PageIntro
      title="Aplicaciones"
      lead="Si sabe qué necesita hacer en el laboratorio pero no qué equipo pedir, empiece por aquí. Cada línea reúne lo que conviene traer a la conversación antes de cotizar."
      crumbs={[{ label: 'Aplicaciones' }]}
    />
  </div>

  <section class="shell section rule-top" aria-labelledby="lineas-title">
    <SectionIndex index={1} label="Líneas de trabajo" />
    <h2 id="lineas-title" class="t-h2">Tres entornos, un mismo proceso de cotización</h2>
    <ApplicationList size="lg" class="mt-12" />
  </section>

  <section class="shell section rule-top" aria-labelledby="sectores-title">
    <SectionIndex index={2} label="A quién atendemos" />
    <div class="sectors">
      <div>
        <h2 id="sectores-title" class="t-h2">Tipos de laboratorio</h2>
        <p class="t-body sectors__intro">{company.homeIntro}</p>
      </div>
      <ul class="sectors__list">
        {company.audience.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <ClosingQuoteBand
    index={3}
    title="Describa el ensayo, no el modelo."
    body="Con el tipo de análisis, el volumen de trabajo y la norma que maneja (si aplica) podemos acotar alternativas antes de emitir una cotización."
  />
</Layout>

<style>

  .sectors {
    display: grid;
    gap: 2.5rem;
  }
  .sectors__intro {
    margin-top: 1.25rem;
  }
  .sectors__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-ink-950);
  }
  .sectors__list li {
    padding-block: 0.875rem;
    font-size: 1rem;
    color: var(--color-ink-800);
    border-bottom: 1px solid var(--color-hairline);
  }
  @media (min-width: 768px) {
    .sectors {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 4rem;
      align-items: start;
    }
  }
</style>

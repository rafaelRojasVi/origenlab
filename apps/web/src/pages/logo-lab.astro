---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import OrigenMark from '../components/logo/OrigenMark.astro';
import OrigenMarkAnimated from '../components/logo/OrigenMarkAnimated.astro';
import SiteLogo from '../components/SiteLogo.astro';
import {
  MARK_CANVAS,
  MARK_NODES,
  MARK_NODE_RADIUS,
  MARK_STROKE_WIDTH,
} from '../lib/logo/generatedMark';

/**
 * Sistema de marca. Superficie interna: `noindex`, fuera del sitemap y con
 * `Disallow` en robots.txt (comprobado por `validate:dist`).
 *
 * No es una galería de opciones: la decisión ya está tomada y las tres
 * exploraciones viven en `design/logo-explorations/`. Esta página es la regla
 * de uso, para que quien tenga que aplicar la marca no tenga que adivinarla.
 */
const SIZES = [16, 24, 32, 48, 64];

const files = [
  ['origenlab-mark-light.svg', 'Marca sobre papel'],
  ['origenlab-mark-dark.svg', 'Marca sobre tinta o color de marca'],
  ['origenlab-mark-mono.svg', 'Una tinta (hereda el color del contexto)'],
  ['origenlab-mark-favicon.svg', 'Marca reforzada para 16 a 24 px'],
  ['origenlab-lockup-light.svg', 'Lockup horizontal sobre papel'],
  ['origenlab-lockup-dark.svg', 'Lockup horizontal sobre tinta'],
  ['origenlab-lockup-stacked-light.svg', 'Lockup apilado sobre papel'],
  ['origenlab-lockup-stacked-dark.svg', 'Lockup apilado sobre tinta'],
];

const colours = [
  ['Traza sobre papel', 'ink-950', '#141617', '17.4:1'],
  ['Nodos sobre papel', 'teal-700', '#0f766e', '5.2:1'],
  ['Traza sobre tinta', 'paper', '#fafaf7', '17.4:1'],
  ['Nodos sobre tinta', 'teal-500', '#14b8a6', '7.3:1'],
];
---

<Layout
  title="Sistema de marca | OrigenLab"
  description="Construcción, área de respeto, tamaño mínimo, colores permitidos y reglas de animación de la marca OrigenLab."
  noindex
>
  <PageIntro
    title="Sistema de marca"
    lead="La marca es la lemniscata de la coreografía en ocho de los tres cuerpos, con los tres cuerpos macizos sobre ella. Un solo trazo, tres nodos y ninguna transparencia."
  />

  <section class="shell section" aria-labelledby="construccion">
    <h2 id="construccion" class="t-h2">Construcción</h2>
    <p class="t-body mt-4">
      Lienzo de {MARK_CANVAS} por {MARK_CANVAS}, centro en 24, 24. La trayectoria es una
      lemniscata de Bernoulli estirada en vertical y girada 30 grados: la misma curva que
      describen tres cuerpos de igual masa en la coreografía en ocho de Moore y Chenciner. Los
      tres nodos se reparten por longitud de arco, no por parámetro, y su peso crece de izquierda
      a derecha, de la muestra al resultado.
    </p>
    <div class="grid mt-8">
      <div class="cell">
        <OrigenMark size={160} tone="ink" />
        <p class="t-label mt-4">Marca sobre papel</p>
      </div>
      <div class="cell cell--ink">
        <OrigenMark size={160} tone="paper" />
        <p class="t-label mt-4 on-ink-label">Marca sobre tinta</p>
      </div>
      <div class="cell cell--brand">
        <OrigenMark size={160} tone="paper" />
        <p class="t-label mt-4 on-ink-label">Marca sobre color de marca</p>
      </div>
    </div>
    <dl class="facts mt-8">
      <div><dt class="t-label">Grosor de traza</dt><dd class="t-data">{MARK_STROKE_WIDTH} / 48</dd></div>
      <div><dt class="t-label">Radio de nodo</dt><dd class="t-data">{MARK_NODE_RADIUS} / 48</dd></div>
      <div><dt class="t-label">Nodos</dt><dd class="t-data">{MARK_NODES.length}</dd></div>
      <div><dt class="t-label">Opacidad mínima</dt><dd class="t-data">1</dd></div>
    </dl>
  </section>

  <section class="shell section rule-top" aria-labelledby="tamanos">
    <h2 id="tamanos" class="t-h2">Tamaño mínimo</h2>
    <p class="t-body mt-4">
      El mínimo es 16 px. Por debajo, los tres nodos dejan de contarse y la marca pasa a ser una
      mancha. A 24 px e inferiores se usa la variante reforzada, con la traza un 25 por ciento
      más gruesa y los nodos un 12 por ciento mayores: es la misma marca con más cuerpo, no un
      dibujo distinto.
    </p>
    <div class="sizes mt-8">
      {
        SIZES.map((size) => (
          <figure class="size">
            <OrigenMark size={size} tone="ink" />
            <figcaption class="t-data">{size} px</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="sizes sizes--ink mt-3">
      {
        SIZES.map((size) => (
          <figure class="size">
            <OrigenMark size={size} tone="paper" />
            <figcaption class="t-data on-ink-label">{size} px</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="respeto">
    <h2 id="respeto" class="t-h2">Área de respeto</h2>
    <p class="t-body mt-4">
      Alrededor de la marca queda libre, como mínimo, un cuarto de su lado. Nada entra en esa
      banda: ni texto, ni filete, ni borde de imagen. En el lockup, la separación entre marca y
      palabra es fija y no se ajusta a ojo.
    </p>
    <div class="clearspace mt-8">
      <div class="clearspace__box">
        <OrigenMark size={96} tone="ink" />
      </div>
      <p class="t-small clearspace__note">
        La banda punteada marca el cuarto de lado que queda libre a cada lado.
      </p>
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="colores">
    <h2 id="colores" class="t-h2">Colores permitidos</h2>
    <p class="t-body mt-4">
      Dos parejas y una tinta única. No hay degradados, no hay sombras y no hay ninguna
      aplicación con opacidad reducida: si la marca no cabe a plena tinta, se usa a menor tamaño,
      no más tenue. El contraste indicado es contra el fondo previsto y todos superan el 3 a 1
      que exige WCAG 1.4.11 para gráficos no textuales.
    </p>
    <table class="table mt-8">
      <thead>
        <tr><th>Uso</th><th>Token</th><th>Valor</th><th>Contraste</th></tr>
      </thead>
      <tbody>
        {
          colours.map(([use, token, value, ratio]) => (
            <tr>
              <td>{use}</td>
              <td class="t-data">{token}</td>
              <td class="t-data">{value}</td>
              <td class="t-data">{ratio}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h3 class="t-h3 mt-10">Una tinta</h3>
    <p class="t-body mt-3">
      Para grabado, sello, fax y cualquier soporte de un solo color. Hereda el color del
      contexto; los nodos llevan un recorte del fondo para no fundirse con la traza.
    </p>
    <div class="grid mt-6">
      <div class="cell mono-ink"><OrigenMark size={120} tone="mono" /></div>
      <div class="cell cell--ink mono-paper"><OrigenMark size={120} tone="mono" /></div>
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="lockup">
    <h2 id="lockup" class="t-h2">Lockup</h2>
    <p class="t-body mt-4">
      En el sitio, el lockup se compone con HTML: la palabra es texto real, seleccionable y
      traducible, y no un trazado dentro del SVG. Los archivos de <code class="t-data">public/logo/</code>
      llevan el texto vectorizado sólo porque se entregan a terceros.
    </p>
    <div class="grid mt-8">
      <div class="cell"><SiteLogo /></div>
      <div class="cell cell--ink"><SiteLogo tone="paper" /></div>
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="animacion">
    <h2 id="animacion" class="t-h2">Animación</h2>
    <p class="t-body mt-4">
      La marca es estática en todas partes menos en el hero de la portada. Allí los tres cuerpos
      recorren la propia trayectoria, desfasados un tercio de vuelta, en un bucle de 34 segundos.
      Es <code class="t-data">offset-path</code> sobre la misma curva: sólo compone, no toca el
      layout y no lleva JavaScript.
    </p>
    <p class="t-body mt-4">
      No se anima en cabecera ni en pie. Un bucle permanente en el shell del sitio no tendría
      control de pausa y eso incumpliría WCAG 2.2.2. Con <code class="t-data">prefers-reduced-motion:
      reduce</code> la animación no llega a declararse y los cuerpos se quedan donde los deja la
      marca estática.
    </p>
    <div class="grid mt-8">
      <div class="cell"><OrigenMarkAnimated size={160} /></div>
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="archivos">
    <h2 id="archivos" class="t-h2">Archivos</h2>
    <p class="t-body mt-4">
      Todos salen de <code class="t-data">scripts/lib/mark-geometry.mjs</code> con
      <code class="t-data">npm run build:brand</code>. No se editan a mano: un archivo retocado
      deja de coincidir con la marca del sitio.
    </p>
    <ul class="index-list mt-8">
      {
        files.map(([name, note]) => (
          <li class="index-row file">
            <a href={`/logo/${name}`} class="file__name t-data">{name}</a>
            <span class="t-small file__note">{note}</span>
          </li>
        ))
      }
    </ul>
    <p class="t-small mt-6">
      Las tres exploraciones y la hoja de comparación con la que se eligió esta viven en
      <code class="t-data">design/logo-explorations/</code>, fuera de <code class="t-data">public/</code>.
    </p>
  </section>
</Layout>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    min-height: 15rem;
    padding: 2rem;
    border: 1px solid var(--color-hairline);
  }
  .cell--ink {
    background-color: var(--color-ink-950);
    border-color: var(--color-onink-hairline);
  }
  .cell--brand {
    background-color: var(--color-teal-800);
    border-color: var(--color-teal-800);
  }
  .on-ink-label {
    color: var(--color-onink-500);
  }
  /* La versión a una tinta hereda el color: aquí se le da uno distinto en cada
     celda para comprobar justamente eso. */
  .mono-ink {
    color: var(--color-ink-950);
    --mark-void: var(--color-paper);
  }
  .mono-paper {
    color: var(--color-paper);
    --mark-void: var(--color-ink-950);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.5rem;
    border-top: 1px solid var(--color-ink-950);
    padding-top: 1.25rem;
  }
  .facts dt {
    margin-bottom: 0.375rem;
  }
  .facts dd {
    margin: 0;
  }

  .sizes {
    display: flex;
    align-items: flex-end;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding: 2rem;
    border: 1px solid var(--color-hairline);
  }
  .sizes--ink {
    background-color: var(--color-ink-950);
    border-color: var(--color-onink-hairline);
  }
  .size {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }
  .size figcaption {
    font-size: 0.75rem;
    color: var(--color-ink-500);
  }

  .clearspace__box {
    display: inline-flex;
    padding: 1.5rem; /* un cuarto de 96 px */
    outline: 1px dashed var(--color-teal-700);
    outline-offset: -1px;
  }
  .clearspace__note {
    margin-top: 1rem;
    color: var(--color-ink-500);
  }

  .table {
    width: 100%;
    border-collapse: collapse;
  }
  .table th,
  .table td {
    text-align: left;
    padding: 0.75rem 1.5rem 0.75rem 0;
    border-bottom: 1px solid var(--color-hairline);
  }
  .table th {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-500);
    border-bottom-color: var(--color-ink-950);
  }

  .file {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-block: 0.875rem;
  }
  .file__name {
    color: var(--color-teal-800);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .file__note {
    color: var(--color-ink-500);
  }

  .mt-3 { margin-top: 0.75rem; }
  .mt-4 { margin-top: 1rem; }
  .mt-6 { margin-top: 1.5rem; }
  .mt-8 { margin-top: 2rem; }
  .mt-10 { margin-top: 2.5rem; }
</style>

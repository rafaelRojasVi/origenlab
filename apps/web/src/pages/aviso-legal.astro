---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import SectionIndex from '../components/ui/SectionIndex.astro';
import { site } from '../config/site';
import { contact, telUrl, whatsappUrl } from '../data/contact';
import { isLegalTextApproved } from '../data/legal';

/**
 * Aviso legal y condiciones de uso.
 *
 * El título es «Aviso legal» y no «Condiciones de venta» a propósito: este
 * sitio no tiene carrito, pasarela ni ningún punto en el que se cierre una
 * compra. Regula el uso de un sitio informativo. Lo acordado en una operación
 * vive en la cotización escrita, que es otro documento.
 *
 * El negocio decidió el 2026-09-21 presentarse con el nombre comercial
 * OrigenLab y no publicar RUT, representante legal, razón social ni domicilio.
 * Esta página no inventa ninguno de esos datos. Mientras falten, la ruta va con
 * `noindex` y fuera del sitemap; es una decisión de publicación y no se explica
 * al lector.
 */
const approved = isLegalTextApproved();
---

<Layout
  title="Aviso legal"
  description="Condiciones de uso del sitio de OrigenLab. Es un sitio informativo: no vende en línea y toda operación se acuerda por cotización escrita."
  noindex={!approved}
>
  <div class="shell">
    <PageIntro
      title="Aviso legal"
      lead="Condiciones de uso de este sitio informativo. No son condiciones de venta: aquí no se compra nada, y lo acordado en una operación vive en la cotización correspondiente."
      crumbs={[{ label: 'Aviso legal' }]}
    />
  </div>

  <section class="shell section rule-top" aria-labelledby="sitio-title">
    <SectionIndex index={1} label="El sitio" />
    <h2 id="sitio-title" class="t-h2">Qué es y qué no es este sitio</h2>

    <div class="terms">
      <div class="terms__row">
        <h3 class="terms__title">Sitio informativo</h3>
        <p class="t-body terms__body">
          {site.domain} lo opera OrigenLab, con base en {contact.locationPublic} y atención
          comercial en todo Chile. El sitio publica información sobre equipamiento de laboratorio y
          canales de contacto. Ninguna página constituye una oferta contractual: toda operación se
          acuerda mediante cotización escrita.
        </p>
      </div>
      <div class="terms__row">
        <h3 class="terms__title">Sin compra en línea</h3>
        <p class="t-body terms__body">
          No hay pagos, ni carrito, ni medio de pago, ni compra en línea. El sitio tampoco publica
          precios ni stock: la configuración, los accesorios, la disponibilidad, la garantía y los
          plazos se confirman en cada cotización.
        </p>
      </div>
      <div class="terms__row">
        <h3 class="terms__title">Información técnica de producto</h3>
        <p class="t-body terms__body">
          Las especificaciones publicadas provienen de la documentación pública de cada fabricante y
          se atribuyen en la ficha correspondiente. OrigenLab no fabrica estos equipos. Ante una
          discrepancia, manda la documentación vigente del fabricante.
        </p>
      </div>
      <div class="terms__row">
        <h3 class="terms__title">Marcas de terceros</h3>
        <p class="t-body terms__body">
          Los nombres y logotipos de fabricante pertenecen a sus titulares y se usan para
          identificar las líneas que OrigenLab cotiza. OrigenLab no declara representación oficial,
          distribución exclusiva ni certificación de ninguna de esas marcas.
        </p>
      </div>
      <div class="terms__row">
        <h3 class="terms__title">Enlaces externos</h3>
        <p class="t-body terms__body">
          El sitio enlaza a sitios de fabricante y a WhatsApp. Esos destinos son ajenos y se rigen
          por sus propias condiciones. El sitio no carga ningún recurso de terceros al mostrarse.
        </p>
      </div>
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="contacto-title">
    <SectionIndex index={2} label="Contacto" />
    <h2 id="contacto-title" class="t-h2">Cómo contactarnos</h2>

    <div class="prose mt-6">
      <p class="t-body">
        Por correo a <a class="link-plain" href={`mailto:${contact.email}`}>{contact.email}</a>, por
        teléfono al <a class="link-plain" href={telUrl()}>{contact.phoneDisplay}</a> o por{' '}
        <a class="link-plain" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          WhatsApp
          <span class="sr-only">(abre WhatsApp en una pestaña nueva)</span>
        </a>, de lunes a viernes entre las {contact.hours}.
      </p>
      <p class="t-body">
        Para consultas sobre datos personales, vea <a class="link-plain" href="/privacidad/">privacidad</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .terms {
    margin-top: 3rem;
    border-top: 1px solid var(--color-ink-950);
  }
  .terms__row {
    display: grid;
    gap: 0.625rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .terms__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink-950);
  }
  .terms__body {
    color: var(--color-ink-600);
  }
  .prose {
    max-width: 66ch;
  }
  .prose :global(p + p) {
    margin-top: 1rem;
  }
  .prose :global(p) {
    color: var(--color-ink-600);
  }
  @media (min-width: 768px) {
    .terms__row {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: 3rem;
      padding-block: 2rem;
    }
  }
</style>

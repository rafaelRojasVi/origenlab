---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import ClosingQuoteBand from '../components/ui/ClosingQuoteBand.astro';
import BrandLogo from '../components/ui/BrandLogo.astro';
import Notice from '../components/ui/Notice.astro';
import Icon from '../components/ui/Icon.astro';
import BrandModelCard from '../components/brand/BrandModelCard.astro';
import { brands, brandsWallHeading } from '../data/brands';
import { scopeById } from '../data/equipmentScope';
import { getCollection } from 'astro:content';
import type { Modelo } from '../content.config';
import { brandEntries, featuredEntries, has3d } from '../lib/brandShowcase';

/**
 * Índice de marcas: una tarjeta por fabricante, las siete con el mismo peso.
 *
 * Cada tarjeta lleva el logotipo en claro sobre el grafito (nunca una caja
 * blanca), qué fabrica la marca en una línea, su familia de equipo, cuántos
 * modelos tienen ficha aquí y tres modelos iluminados: primero los que giran en
 * 3D, luego los que se presentan en la caja de luz. Tres y no más, para que
 * ninguna marca pese más que otra por tener más modelos. Los modelos y los
 * conteos salen de la colección `modelos`; la línea y la familia, de
 * `brands.ts` y `equipmentScope.ts`.
 *
 * SERVA va última, como en toda lista del sitio: es la única línea de reactivos
 * e insumos y puesta antes desplazaría a las familias de equipo.
 */
const all = (await getCollection('modelos')).map((item) => item.data as Modelo);

const cards = brands.map((brand) => {
  const entries = brandEntries(brand.id, all);
  return {
    brand,
    family: scopeById(brand.familyId),
    count: entries.length,
    spinning: entries.filter(has3d).length,
    featured: featuredEntries(entries, 3),
  };
});
---

<Layout
  title="Marcas"
  description="Marcas con las que trabaja OrigenLab: Hielscher, Ortoalresa, IKA, Adam Equipment, OHAUS, Löser y SERVA. Catálogo, documentación y cotización."
>
  <div class="brands-stage">
    <div class="shell">
      <PageIntro
        title="Marcas"
        lead="Siete fabricantes, cada uno con su familia de equipo y sus modelos documentados desde la fuente oficial. La disponibilidad, la documentación técnica y las condiciones se confirman al cotizar."
        crumbs={[{ label: 'Marcas' }]}
      />
    </div>
  </div>

  <section class="shell brands-sec" aria-labelledby="marcas-title">
    <h2 id="marcas-title" class="sr-only">{brandsWallHeading}</h2>
    <ul class="brand-cards">
      {
        cards.map(({ brand, family, count, spinning, featured }, index) => (
          <li>
            <article class="brand-card card-lit" aria-labelledby={`marca-${brand.slug}`}>
              <div class="brand-card__info">
                <a href={`/marcas/${brand.slug}/`} class="brand-card__logo" tabindex="-1" aria-hidden="true">
                  <BrandLogo brand={brand} scale={1.35} alt="" loading={index < 2 ? 'eager' : 'lazy'} />
                </a>
                <h3 id={`marca-${brand.slug}`} class="brand-card__name" translate="no">
                  <a href={`/marcas/${brand.slug}/`}>{brand.name}</a>
                </h3>
                {brand.legalName && <p class="brand-card__legal">{brand.legalName}</p>}
                <p class="brand-card__summary">{brand.listSummary}</p>
                <dl class="brand-card__facts">
                  {family && (
                    <div>
                      <dt>Familia</dt>
                      <dd>{family.name}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Modelos con ficha</dt>
                    <dd>
                      {count}
                      {spinning > 0 && <span class="brand-card__spin">· {spinning} en 3D</span>}
                    </dd>
                  </div>
                </dl>
                <a href={`/marcas/${brand.slug}/`} class="link-arrow brand-card__go">
                  Ver {brand.name}
                  <Icon name="arrow-right" size={18} class="arrow" />
                </a>
              </div>
              <ul class="brand-card__models" aria-label={`Modelos de ${brand.name}`}>
                {featured.map((entry) => (
                  <li>
                    <BrandModelCard entry={entry} brandName={brand.name} variant="tile" loading={index === 0 ? 'eager' : 'lazy'} />
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ul>

    <Notice class="mt-12">
      Es una lista cerrada de siete marcas. OrigenLab no declara representación oficial,
      distribución exclusiva ni certificación de ninguna de ellas. El alcance comercial de cada
      línea se confirma por escrito al cotizar. Los datos de producto se redactaron desde la
      documentación pública de cada fabricante y la fuente se enlaza en cada modelo.
    </Notice>
  </section>

  <ClosingQuoteBand
    title="¿Busca una marca o un modelo concreto?"
    body="Indíquenos la marca, el modelo de referencia y para qué laboratorio es. Le confirmamos qué podemos gestionar y en qué condiciones."
  />
</Layout>

<style>
  /* Foco de escenario detrás de la cabecera: la luz del lanzamiento. */
  .brands-stage {
    background: radial-gradient(60% 100% at 70% 0%, var(--color-glow), transparent 70%);
  }
  .brands-sec {
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .brand-cards {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .brand-card {
    display: grid;
    gap: 2rem;
    padding: 1.5rem 1.25rem;
  }
  .brand-card__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .brand-card__logo {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    margin-bottom: 1.25rem;
  }
  .brand-card__name {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-ink-950);
  }
  .brand-card__name a:hover {
    color: var(--color-teal-800);
  }
  .brand-card__legal {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-ink-500);
  }
  .brand-card__summary {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-800);
    max-width: 44ch;
  }
  .brand-card__facts {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-hairline);
  }
  .brand-card__facts dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }
  .brand-card__facts dd {
    margin: 0.125rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink-900);
  }
  .brand-card__spin {
    margin-left: 0.375rem;
    font-weight: 500;
    color: var(--color-teal-700);
  }
  .brand-card__go {
    margin-top: 1.5rem;
  }
  .brand-card__models {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Teléfono: el primero, en grande; los otros dos, debajo. */
  .brand-card__models > li:first-child {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .brand-card {
      padding: 2rem;
    }
    .brand-card__models {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .brand-card__models > li:first-child {
      grid-column: auto;
    }
  }
  @media (min-width: 1024px) {
    .brand-card {
      grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
      gap: 3rem;
      align-items: center;
      padding: 2rem 2rem 2rem 2.5rem;
    }
  }
</style>

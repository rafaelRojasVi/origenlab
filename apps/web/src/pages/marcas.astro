---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import ClosingQuoteBand from '../components/ui/ClosingQuoteBand.astro';
import BrandLogo from '../components/ui/BrandLogo.astro';
import Icon from '../components/ui/Icon.astro';
import LitCard from '../components/ui/LitCard.astro';
import { brands, brandsWallHeading } from '../data/brands';
import { scopeById } from '../data/equipmentScope';
import { getCollection } from 'astro:content';
import type { Modelo } from '../content.config';
import { brandEntries, featuredEntries, has3d } from '../lib/brandShowcase';
import { rankBrands } from '../lib/ranking';
import { publicClaim } from '../data/claims';

/**
 * Índice de marcas: una tarjeta por fabricante, las siete con el mismo peso.
 *
 * Cada fila (sobre blanco, separadas por un filete) lleva el logotipo en su
 * tinta, qué fabrica la marca en una línea, su familia de equipo, cuántos
 * modelos tienen ficha aquí y tres modelos como `LitCard` compactas sobre el
 * tinte de su familia: primero los que giran en 3D. Tres y no más, para que
 * ninguna marca pese más que otra por tener más modelos. Los modelos y los
 * conteos salen de la colección `modelos`; la línea y la familia, de
 * `brands.ts` y `equipmentScope.ts`.
 *
 * Orden comercial del sitio (`rankBrands`, dueño 2026-11-08): Hielscher y
 * OHAUS primero, IKA al final. El titular de la lista es la afirmación
 * aprobada «directo con el fabricante» (`claims.ts`); nunca «distribuidor
 * oficial» ni «exclusivo».
 */
const all = (await getCollection('modelos')).map((item) => item.data as Modelo);

const heading = publicClaim('directo-con-el-fabricante') ?? brandsWallHeading;
const cards = rankBrands(brands).map((brand) => {
  const entries = brandEntries(brand.id, all);
  return {
    brand,
    family: scopeById(brand.familyId),
    count: entries.length,
    spinning: entries.filter(has3d).length,
    featured: featuredEntries(entries, 3),
  };
});
---

<Layout
  title="Marcas"
  description="Marcas con las que trabaja OrigenLab: Hielscher, Ortoalresa, IKA, Adam Equipment, OHAUS, Löser y SERVA. Catálogo, documentación y cotización."
>
  <div class="shell">
    <PageIntro
      title="Marcas"
      lead="Siete fabricantes, cada uno con su familia de equipo y sus modelos documentados desde la fuente oficial. La disponibilidad, la documentación técnica y las condiciones se confirman al cotizar."
      crumbs={[{ label: 'Marcas' }]}
    />
  </div>

  <section class="shell brands-sec" aria-labelledby="marcas-title">
    <h2 id="marcas-title" class="brands-sec__title">{heading}</h2>
    <ul class="brand-cards">
      {
        cards.map(({ brand, family, count, spinning, featured }, index) => (
          <li>
            <article class="brand-card" aria-labelledby={`marca-${brand.slug}`}>
              <div class="brand-card__info">
                <a href={`/marcas/${brand.slug}/`} class="brand-card__logo" tabindex="-1" aria-hidden="true">
                  <BrandLogo brand={brand} scale={1.35} alt="" loading={index < 2 ? 'eager' : 'lazy'} />
                </a>
                <h3 id={`marca-${brand.slug}`} class="brand-card__name" translate="no">
                  <a href={`/marcas/${brand.slug}/`}>{brand.name}</a>
                </h3>
                {brand.legalName && <p class="brand-card__legal">{brand.legalName}</p>}
                <p class="brand-card__summary">{brand.listSummary}</p>
                <dl class="brand-card__facts">
                  {family && (
                    <div>
                      <dt>Familia</dt>
                      <dd>{family.name}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Modelos con ficha</dt>
                    <dd>
                      {count}
                      {spinning > 0 && <span class="brand-card__spin">· {spinning} en 3D</span>}
                    </dd>
                  </div>
                </dl>
                <a href={`/marcas/${brand.slug}/`} class="link-arrow brand-card__go">
                  Ver {brand.name}
                  <Icon name="arrow-right" size={18} class="arrow" />
                </a>
              </div>
              <ul class="brand-card__models" aria-label={`Modelos de ${brand.name}`}>
                {featured.map((entry) => (
                  <li>
                    <LitCard entry={entry} variant="tile" ratio="1 / 1" kicker="none" heading="h4" loading={index === 0 ? 'eager' : 'lazy'} />
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ul>

  </section>

  <ClosingQuoteBand
    title="¿Busca una marca o un modelo concreto?"
    body="Indíquenos la marca, el modelo de referencia y para qué laboratorio es. Le confirmamos qué podemos gestionar y en qué condiciones."
  />
</Layout>

<style>
  .brands-sec {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .brands-sec__title {
    margin-bottom: 0.5rem;
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .brand-cards {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .brand-cards > li + li {
    border-top: 1px solid var(--color-hairline);
  }
  .brand-card {
    display: grid;
    gap: 2rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .brand-card__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .brand-card__logo {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    margin-bottom: 1.25rem;
  }
  .brand-card__name {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--color-ink-950);
  }
  .brand-card__name a:hover {
    color: var(--color-teal-800);
  }
  .brand-card__legal {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-ink-500);
  }
  .brand-card__summary {
    margin-top: 0.875rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-ink-600);
    max-width: 40ch;
  }
  .brand-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 1.25rem 0 0;
  }
  .brand-card__facts dt {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-500);
  }
  .brand-card__facts dd {
    margin: 0.125rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink-900);
  }
  .brand-card__spin {
    margin-left: 0.375rem;
    font-weight: 500;
    color: var(--color-teal-700);
  }
  .brand-card__go {
    margin-top: 1.5rem;
  }
  .brand-card__models {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Teléfono: el primero, en grande; los otros dos, debajo. */
  .brand-card__models > li:first-child {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .brand-card__models {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.375rem;
    }
    .brand-card__models > li:first-child {
      grid-column: auto;
    }
  }
  @media (min-width: 1024px) {
    .brand-card {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      gap: 4rem;
      align-items: center;
    }
  }
</style>

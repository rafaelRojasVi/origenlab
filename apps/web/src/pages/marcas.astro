---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import SectionIndex from '../components/ui/SectionIndex.astro';
import ClosingQuoteBand from '../components/ui/ClosingQuoteBand.astro';
import BrandLogo from '../components/ui/BrandLogo.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';
import Notice from '../components/ui/Notice.astro';
import Icon from '../components/ui/Icon.astro';
import { brandsWallHeading } from '../data/brands';
import { getCatalogBrands, getProductsByBrandId, getWorkingBrands } from '../lib/catalog';
import { scopeById } from '../data/equipmentScope';
import { sourceForBrand } from '../data/sourceRegistry';

const catalogBrands = getCatalogBrands();
const workingBrands = getWorkingBrands().map((brand) => ({
  brand,
  family: scopeById(brand.familyId),
  source: sourceForBrand(brand.id),
}));
---

<Layout
  title="Marcas"
  description="Marcas con las que trabaja OrigenLab: Hielscher, Ortoalresa, IKA, Adam Equipment, Löser y SERVA. Catálogo, condiciones y cotización."
>
  <div class="shell">
    <PageIntro
      title="Marcas"
      lead="Dos marcas con catálogo publicado en este sitio y cuatro más con las que trabajamos por cotización. La disponibilidad, la documentación técnica y las condiciones se confirman al cotizar."
      crumbs={[{ label: 'Marcas' }]}
    />
  </div>

  <section class="shell section rule-top" aria-labelledby="catalogo-title">
    <SectionIndex index={1} label="Con catálogo publicado" />
    <h2 id="catalogo-title" class="t-h2">Productos que puede ver en detalle</h2>

    <ul class="brand-rows">
      {
        catalogBrands.map((brand) => {
          const count = getProductsByBrandId(brand.id).length;
          return (
            <li class="brand-row">
              <a href={`/marcas/${brand.slug}/`}>
                <span class="brand-row__logo">
                  <BrandLogo brand={brand} scale={1.4} />
                </span>
                <span class="brand-row__body">
                  <span class="brand-row__name" translate="no">{brand.name}</span>
                  {brand.legalName && <span class="brand-row__legal">{brand.legalName}</span>}
                  <span class="brand-row__summary t-small">{brand.listSummary ?? brand.summary}</span>
                </span>
                <span class="brand-row__count">
                  <span class="brand-row__count-value t-data">{count}</span>
                  <span class="brand-row__count-label">
                    {count === 1 ? 'referencia publicada' : 'referencias publicadas'}
                  </span>
                </span>
                <Icon name="arrow-right" size={20} class="brand-row__go" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="shell section rule-top" aria-labelledby="trabajamos-title">
    <SectionIndex index={2} label="Otras marcas" />
    <h2 id="trabajamos-title" class="t-h2">{brandsWallHeading}</h2>
    <p class="t-lead mt-5">
      Fabricantes que forman parte de nuestro trabajo comercial y que aún no tienen catálogo
      publicado en el sitio. Se indica qué fabrica cada uno y se enlaza su documentación oficial.
      Consulte por equipos o insumos de estas líneas y le indicamos qué podemos gestionar.
    </p>

    <ul class="working-list">
      {
        workingBrands.map(({ brand, family, source }) => (
          <li class="working">
            <span class="working__logo">
              <BrandLogo brand={brand} scale={1.5} />
            </span>
            <span class="working__name" translate="no">{brand.name}</span>
            {family && <span class="working__family t-data">{family.name}</span>}
            <span class="t-small working__summary">{brand.listSummary}</span>
            <span class="working__links">
              {source && (
                <ExternalLink href={source.officialUrl} context={`productos de ${brand.name}`}>
                  Productos del fabricante
                </ExternalLink>
              )}
              {source?.officialPdfUrl && (
                <ExternalLink href={source.officialPdfUrl} context={`catálogo PDF de ${brand.name}`}>
                  Catálogo PDF del fabricante
                </ExternalLink>
              )}
            </span>
          </li>
        ))
      }
    </ul>

    <Notice class="mt-12">
      OrigenLab no declara representación oficial, distribución exclusiva ni certificación de
      ninguna de estas marcas. El alcance comercial de cada línea se confirma por escrito al
      cotizar.
    </Notice>
  </section>

  <ClosingQuoteBand
    index={3}
    title="¿Busca una marca o un modelo concreto?"
    body="Indíquenos la marca, el modelo de referencia y para qué laboratorio es. Le confirmamos qué podemos gestionar y en qué condiciones."
  />
</Layout>

<style>
  .brand-rows {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-ink-950);
  }
  .brand-row {
    border-bottom: 1px solid var(--color-hairline);
  }
  .brand-row a {
    display: grid;
    /* Móvil: logotipo y texto apilados en la primera columna, flecha en la
       segunda. Sin colocación explícita el navegador crea una tercera columna
       implícita y el texto se comprime a 24 px. */
    grid-template-columns: minmax(0, 1fr) 1.5rem;
    gap: 0 1.5rem;
    padding-block: 2rem;
    transition: background-color 150ms;
  }
  .brand-row__logo,
  .brand-row__body,
  .brand-row__count {
    grid-column: 1;
  }
  .brand-row__go {
    grid-column: 2;
    grid-row: 1 / span 3;
  }
  .brand-row a:hover {
    background-color: var(--color-surface);
  }
  .brand-row__logo {
    display: block;
    margin-bottom: 1.5rem;
  }
  .brand-row__name {
    display: block;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-ink-950);
    letter-spacing: -0.015em;
  }
  .brand-row__legal {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-ink-500);
  }
  .brand-row__summary {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-ink-600);
    max-width: 56ch;
  }
  .brand-row__count {
    display: block;
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-hairline);
  }
  .brand-row__count-value {
    font-size: 1.5rem;
    color: var(--color-ink-950);
  }
  .brand-row__count-label {
    display: block;
    margin-top: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }
  .brand-row__go {
    align-self: center;
    justify-self: end;
    color: var(--color-ink-500);
  }
  .brand-row a > * {
    min-width: 0;
  }
  .brand-row a:hover .brand-row__go {
    color: var(--color-teal-800);
  }

  .working-list {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }
  .working {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    min-width: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }
  .working__logo {
    /* Caja común: los lockups tienen proporciones muy distintas y sin una altura
       compartida la fila se lee desalineada. */
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    max-width: 100%;
    margin-bottom: 0.375rem;
  }
  .working__name {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink-950);
    letter-spacing: -0.012em;
  }
  .working__family {
    /* 13 px es el suelo del sitio: por debajo, `qa:screens` lo marca y en un
       móvil deja de leerse cómodamente. */
    font-size: 0.8125rem;
    color: var(--color-teal-800);
  }
  .working__summary {
    color: var(--color-ink-600);
    max-width: 40ch;
  }
  /* Los dos enlaces oficiales, apilados: son destinos externos y conviene que
     se lean como una lista corta y no como una frase con dos enlaces dentro. */
  .working__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 768px) {
    .brand-row a {
      grid-template-columns: 13rem minmax(0, 1fr) 9rem 2rem;
      align-items: center;
      gap: 3rem;
      padding-block: 2.5rem;
    }
    .brand-row__logo {
      margin-bottom: 0;
      grid-column: 1;
    }
    .brand-row__body {
      grid-column: 2;
    }
    .brand-row__count {
      grid-column: 3;
      grid-row: auto;
      margin-top: 0;
      padding-top: 0;
      border-top: none;
      text-align: right;
    }
    .brand-row__count-label {
      max-width: 7rem;
      margin-left: auto;
    }
    .brand-row__go {
      grid-column: 4;
      grid-row: auto;
    }
    .working-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3rem;
    }
  }
</style>

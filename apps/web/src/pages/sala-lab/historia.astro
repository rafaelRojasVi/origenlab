---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import ProductStory from '../../components/product/ProductStory.astro';
import ClosingQuoteBand from '../../components/ui/ClosingQuoteBand.astro';
import { story } from '../../lib/showroom/stories/hielscher-up400st';
import type { Modelo } from '../../content.config';

/**
 * Sala de pruebas de la historia de producto (`ProductStory`) con el UP400St.
 * Superficie interna, como /sala-lab/: `noindex`, fuera del sitemap, `Disallow`
 * en robots.txt y `X-Robots-Tag` en .htaccess (los cuatro cubren `/sala-lab/`
 * entero; `validate:dist` lo comprueba). Sirve para revisar el componente
 * hasta que exista la página pública del modelo (tarea 4A), que lo monta igual.
 * `?tier=high|medium|low` fija el nivel de calidad.
 */
const model = await getEntry('modelos', 'hielscher-up400st');
if (!model) throw new Error('sala-lab/historia: falta la ficha hielscher-up400st');
const entry = model.data as Modelo;
---

<Layout
  title="Sala de pruebas: historia de producto | OrigenLab"
  description="Revisión interna de la historia por scroll de una página de producto, con el equipo modelado en 3D y su ficha con fuente."
  noindex
>
  <PageIntro title={`Hielscher ${entry.name}`} lead={entry.lead} />
  <ProductStory config={story} entry={entry}>
    <ClosingQuoteBand title="¿Le sirve este equipo?" body="Cuéntenos su muestra y su volumen y le enviamos una propuesta formal." productName={entry.name} brandName="Hielscher Ultrasonics" />
  </ProductStory>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeFamilies from '../components/home/HomeFamilies.astro';
import HomeSteps from '../components/home/HomeSteps.astro';
import HomeBrands from '../components/home/HomeBrands.astro';
import HomeNotes from '../components/home/HomeNotes.astro';
import HomeReveal from '../components/home/HomeReveal.astro';
import QuoteTeaser from '../components/home/QuoteTeaser.astro';
import ClosingQuoteBand from '../components/ui/ClosingQuoteBand.astro';
import RegisteredStrip from '../components/ui/RegisteredStrip.astro';
import IndustryTiles from '../components/ui/IndustryTiles.astro';
import { site } from '../config/site';
import { publicClaim } from '../data/claims';
import { websiteJsonLd } from '../lib/jsonld';

/**
 * Portada («Blanco con color», maqueta elegida por los dueños 2026-11-08).
 *
 * Ritmo de la página (todo claro; el único oscuro es el pie):
 *
 *   blanco    primera pantalla: titular centrado, acciones y sala 3D sobre un resplandor
 *   blanco    elija el equipo: fila de modelos y las seis familias
 *   blanco    proveedor inscrito en: franja de logotipos aprobados
 *   blanco    industrias, seis tiles de texto hacia las aplicaciones
 *   aqua      revelado: el nombre gigante detrás del equipo
 *   blanco    marcas, rejilla de logotipos
 *   azul      cómo comprar en cuatro pasos y la hoja de cotización de ejemplo
 *   blanco    notas de aplicación, sólo si la colección tiene notas
 *   teal      banda de cierre (clara), antes del pie oscuro
 *
 * El titular B (cotización el mismo día, directo con el fabricante) sólo sale
 * si la promesa está aprobada en `claims.ts`. Con él en la primera pantalla, el
 * titular antiguo pasa a las familias; sin él, ocurre al revés. El
 * revelado al desplazarse es CSS puro (`.rv` en global.css), sin script.
 *
 * Las preguntas frecuentes viven en /contacto/, junto con su JSON-LD.
 */
const sameDay = Boolean(publicClaim('cotizacion-mismo-dia-habil'));
const headlineB = sameDay;
const bandBody = sameDay
  ? 'Le respondemos con una cotización el mismo día hábil, con la ficha técnica del fabricante.'
  : 'Le respondemos con una cotización por escrito, con la ficha técnica del fabricante.';
---

<Layout
  title={`${site.name} | ${site.tagline}`}
  description={site.description}
  isHome
  jsonLd={[websiteJsonLd()]}
>
  <HomeHero headlineB={headlineB} />
  <HomeFamilies headlineB={headlineB} />
  <section class="shell home-sec home-reg rv" aria-labelledby="inscrito-title">
    <RegisteredStrip heading />
  </section>
  <section class="shell home-sec home-ind" id="industrias" aria-labelledby="industrias-title">
    <div class="home-head rv">
      <h2 id="industrias-title" class="t-label">Industrias</h2>
    </div>
    <div class="rv"><IndustryTiles /></div>
  </section>
  <HomeReveal />
  <HomeBrands />
  <HomeSteps tone="raised">
    <QuoteTeaser />
  </HomeSteps>
  <HomeNotes />
  <ClosingQuoteBand
    title="Cuéntenos qué necesita hacer con la muestra."
    body={bandBody}
    primary="quote"
  />
</Layout>

<style>
  .home-ind {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }
  /* Es una etiqueta, no un titular de sección: sin el aire de `.home-head`. */
  .home-ind .home-head {
    margin-bottom: 1.5rem;
  }
</style>

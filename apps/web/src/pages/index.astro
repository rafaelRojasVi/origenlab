---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import BrandWall from '../components/home/BrandWall.astro';
import EquipmentFamilies from '../components/home/EquipmentFamilies.astro';
import ConsultationSection from '../components/home/ConsultationSection.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import AudienceSection from '../components/home/AudienceSection.astro';
import ClosingQuoteBand from '../components/ui/ClosingQuoteBand.astro';
import { site } from '../config/site';
import { organizationJsonLd, websiteJsonLd } from '../lib/jsonld';

/**
 * Portada.
 *
 * La portada no lleva índice numerado de secciones. En las páginas interiores
 * el numeral funciona como el índice de un manual, pero encadenado de 01 a 05
 * en la portada convertía la página en un documento formateado y no en un
 * primer encuentro comercial. Aquí la identidad de cada sección la da la
 * etiqueta mono y, sobre todo, el cambio de fondo, de escala y de densidad.
 *
 * Ritmo de la página, deliberadamente desigual:
 *
 *   papel     hero: titular, marca animada e índice de las seis familias
 *   superficie marcas, compacto, cada logotipo con su familia
 *   papel     familias: cuatro composiciones distintas
 *   superficie   dentro de ellas, la banda de preparación cambia de fondo
 *   papel     asesoría técnica, aire y preguntas a gran escala
 *   superficie proceso, denso
 *   papel     a quién atendemos, medio
 *   tinta     banda de cierre
 *
 * Las preguntas frecuentes se movieron a /contacto/, junto con su JSON-LD:
 * el acordeón de la portada repetía lo que la sección de asesoría ya resuelve
 * mejor, y los datos estructurados tienen que vivir donde está el contenido
 * visible que describen.
 */
---

<Layout
  title={`${site.name} | ${site.tagline}`}
  description={site.description}
  isHome
  jsonLd={[organizationJsonLd(), websiteJsonLd()]}
>
  <Hero />
  <BrandWall />
  <EquipmentFamilies />
  <ConsultationSection />
  <ProcessSection />
  <AudienceSection />

  <ClosingQuoteBand
    title="Cuéntenos qué necesita medir, separar o preparar."
    body="Con la aplicación, la institución y su ciudad acotamos alternativas y preparamos una cotización con configuración y condiciones por escrito."
  />
</Layout>

<script>
  /**
   * Revelado al desplazarse. Mejora progresiva estricta.
   *
   * Sin este script no se oculta nada: el estado inicial de `[data-reveal]`
   * sólo existe mientras el documento lleva `data-reveal-ready`, que se pone
   * aquí. Con movimiento reducido no se pone y la portada se pinta completa.
   *
   * No hay parallax, no hay secuestro del desplazamiento y ningún contenido
   * depende del movimiento para leerse. Cada elemento se observa una sola vez.
   */
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (targets.length > 0 && motionOk.matches && 'IntersectionObserver' in window) {
    document.documentElement.setAttribute('data-reveal-ready', '');

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.08 },
    );

    for (const target of targets) observer.observe(target);

    /* Si alguien pide movimiento reducido con la página abierta, se descarta el
       estado oculto en lugar de dejar contenido invisible. */
    motionOk.addEventListener('change', (event) => {
      if (event.matches) return;
      observer.disconnect();
      document.documentElement.removeAttribute('data-reveal-ready');
    });
  }
</script>

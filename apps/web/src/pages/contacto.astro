---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import SectionIndex from '../components/ui/SectionIndex.astro';
import Icon from '../components/ui/Icon.astro';
import { contact, telUrl } from '../data/contact';
import { company } from '../data/company';
import { faqItems } from '../data/faq';
import { buildQuoteMailtoWithTemplate, buildWhatsAppQuoteUrl } from '../lib/whatsapp';
import { ctaLabels } from '../lib/ctaLabels';
import { faqJsonLd } from '../lib/jsonld';

const mailtoHref = buildQuoteMailtoWithTemplate();
const whatsappHref = buildWhatsAppQuoteUrl();

/**
 * Lista de intake operativa de docs/company-scope.md. Es lo mínimo que
 * necesitamos para responder con algo concreto en el primer intercambio.
 */
const intake = [
  {
    title: 'Quién compra',
    body: 'Institución o empresa, nombre y cargo de quien coordina, y un correo o teléfono de contacto.',
  },
  {
    title: 'Qué necesita hacer',
    body: 'La aplicación o el ensayo, no sólo el nombre del equipo. Si conoce requisitos técnicos (capacidad, rango, resolución, norma asociada), inclúyalos.',
  },
  {
    title: 'Dónde y cuándo',
    body: 'Ciudad y región para entrega o facturación, y cuándo necesita el equipo operativo.',
  },
  {
    title: 'Cuánto',
    body: 'Cantidad y, si corresponde, si hay varias líneas o alternativas que quiera comparar.',
  },
];

const steps = [
  { num: '01', text: 'Recibimos su solicitud y le respondemos en horario hábil.' },
  { num: '02', text: 'Preparamos alternativas acotadas a su necesidad.' },
  { num: '03', text: 'Le respondemos en horario hábil: lunes a viernes, ' + contact.hours + '.' },
];
---

<Layout
  title="Contacto"
  description={`Cotizaciones y consultas técnicas de OrigenLab: ${contact.email}, teléfono y WhatsApp ${contact.phoneDisplay}, lunes a viernes ${contact.hours}. Atención en todo Chile.`}
  jsonLd={[faqJsonLd(faqItems)]}
>
  <div class="shell">
    <PageIntro
      title="Solicitar cotización"
      lead="Escríbanos por el canal que prefiera. Respondemos con alternativas acotadas a lo que su laboratorio necesita, no con un catálogo completo."
      crumbs={[{ label: 'Contacto' }]}
    />
  </div>

  {/* Section 01: Formulario */}
  <section class="shell section rule-top" aria-labelledby="solicitud-title">
    <SectionIndex index={1} label="Solicitud" />
    <div class="solicitud-grid">

      <div class="solicitud-main">
        <h2 id="solicitud-title" class="t-h2">¿Qué necesita cotizar?</h2>
        <p class="t-lead mt-5">
          Complete el formulario y le respondemos con una propuesta concreta.
          Si prefiere escribirnos directamente, use los datos del panel derecho.
        </p>

        {/* Success panel (hidden until JS shows it) */}
        <div id="solicitud-success" hidden tabindex="-1" class="solicitud-panel solicitud-panel--ok" role="status">
          <p class="t-body">
            <strong>Recibimos su solicitud.</strong>
            Le responderemos a <span data-success-email>su correo</span> a la brevedad.
          </p>
          <p class="mt-5">
            <a href="/" class="btn btn-secondary">Volver al inicio</a>
          </p>
        </div>

        {/* Network error panel (hidden until JS shows it) */}
        <div id="solicitud-network-error" hidden tabindex="-1" class="solicitud-panel solicitud-panel--err" role="alert">
          <p class="t-body">
            No pudimos enviar la solicitud. Escríbanos directamente a{' '}
            <a href={`mailto:${contact.email}`} class="link-plain" data-error-mailto>{contact.email}</a>.
          </p>
        </div>

        <form id="solicitud-form" method="post" action="/api/web/solicitud" novalidate class="sol-form">
          <input type="hidden" name="render_at" id="solicitud-render-at" />
          <input type="hidden" name="submission_id" id="solicitud-submission-id" />
          <div class="sol-trap-wrap">
            <input
              type="text"
              name="_trap"
              id="solicitud-trap"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
              class="sol-trap"
            />
          </div>

          <div
            data-error-summary
            role="alert"
            aria-live="polite"
            tabindex="-1"
            hidden
            class="sol-error-summary"
          ></div>

          <div class="sol-field">
            <label for="solicitud-need" class="sol-label">Qué necesita cotizar <span aria-hidden="true">*</span></label>
            <p id="solicitud-need-hint" class="t-small">
              Por ejemplo: autoclave de laboratorio 50 L, agitador orbital para cultivos celulares.
            </p>
            <textarea
              id="solicitud-need"
              name="need"
              required
              rows="4"
              maxlength="4000"
              aria-describedby="solicitud-need-hint solicitud-need-error"
              aria-invalid="false"
              class="sol-textarea"
            ></textarea>
            <p id="solicitud-need-error" role="alert" hidden class="sol-field-error"></p>
          </div>

          <div class="sol-field">
            <label for="solicitud-email" class="sol-label">Correo electrónico <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="solicitud-email"
              name="email"
              required
              maxlength="200"
              aria-describedby="solicitud-email-error"
              aria-invalid="false"
              class="sol-input"
            />
            <p id="solicitud-email-error" role="alert" hidden class="sol-field-error"></p>
          </div>

          <div class="sol-field">
            <label for="solicitud-org" class="sol-label">Institución o empresa <span aria-hidden="true">*</span></label>
            <input
              type="text"
              id="solicitud-org"
              name="org"
              required
              maxlength="200"
              aria-describedby="solicitud-org-error"
              aria-invalid="false"
              class="sol-input"
            />
            <p id="solicitud-org-error" role="alert" hidden class="sol-field-error"></p>
          </div>

          <details class="sol-optional">
            <summary class="sol-optional__summary t-small">Datos opcionales (nombre, teléfono, ciudad, plazo)</summary>
            <div class="sol-optional__body">
              <div class="sol-field">
                <label for="solicitud-name" class="sol-label">Nombre de contacto</label>
                <input type="text" id="solicitud-name" name="name" maxlength="200" class="sol-input" />
              </div>
              <div class="sol-field">
                <label for="solicitud-phone" class="sol-label">Teléfono</label>
                <input type="tel" id="solicitud-phone" name="phone" maxlength="200" class="sol-input" />
              </div>
              <div class="sol-field">
                <label for="solicitud-city" class="sol-label">Ciudad</label>
                <input type="text" id="solicitud-city" name="city" maxlength="200" class="sol-input" />
              </div>
              <div class="sol-field">
                <label for="solicitud-deadline" class="sol-label">Plazo estimado</label>
                <input type="text" id="solicitud-deadline" name="deadline" maxlength="200" placeholder="Ej: antes de diciembre" class="sol-input" />
              </div>
            </div>
          </details>

          <button type="submit" id="solicitud-btn" class="btn btn-primary" style="margin-top:0.5rem">
            Enviar solicitud
          </button>

          <p class="t-small" style="margin-top:1rem">
            Respondemos en horario hábil, de lunes a viernes entre las {contact.hours}.
          </p>
          <p class="t-small" style="margin-top:0.5rem">
            Usamos estos datos sólo para responder su solicitud.{' '}
            <a href="/privacidad/" class="link-plain">Privacidad</a>.
          </p>
        </form>
      </div>

      <aside class="solicitud-aside">
        <p class="t-data">Qué pasa después</p>
        <ol class="sol-steps">
          {steps.map((step) => (
            <li class="intake__item">
              <span class="intake__num" aria-hidden="true">{step.num}</span>
              <p class="intake__body t-small">{step.text}</p>
            </li>
          ))}
        </ol>
        <div class="sol-aside-actions">
          <a href={mailtoHref} class="btn btn-secondary sol-aside-btn">{ctaLabels.solicitarCotizacion}</a>
          <a href={whatsappHref} class="link-arrow" target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={18} />
            WhatsApp
            <span class="sr-only">(abre WhatsApp en una pestaña nueva)</span>
          </a>
        </div>
        <dl class="details mt-8">
          <div class="detail">
            <dt><Icon name="mail" size={18} />Correo</dt>
            <dd><a href={`mailto:${contact.email}`} class="link-plain">{contact.email}</a></dd>
          </div>
          <div class="detail">
            <dt><Icon name="clock" size={18} />Horario</dt>
            <dd class="t-data">Lunes a viernes, {contact.hours}</dd>
          </div>
          <div class="detail">
            <dt><Icon name="map-pin" size={18} />Cobertura</dt>
            <dd class="t-data">Todo {company.geography}</dd>
          </div>
        </dl>
      </aside>

    </div>
  </section>

  {/* Section 02: Canales */}
  <section class="shell section rule-top" aria-labelledby="canales-title">
    <SectionIndex index={2} label="Canales" />
    <div class="channels">
      <div>
        <h2 id="canales-title" class="t-h2">Tres formas de llegar a nosotros</h2>
        <p class="t-lead mt-5">
          El correo es el mejor canal para una cotización formal: permite adjuntar documentación y
          deja registro escrito. WhatsApp funciona bien para consultas rápidas.
        </p>
        <div class="channels__actions">
          <a href={mailtoHref} class="btn btn-primary">{ctaLabels.solicitarCotizacion}</a>
          <a href={whatsappHref} class="link-arrow" target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={18} />
            Escribir por WhatsApp
            <span class="sr-only">(abre WhatsApp en una pestaña nueva)</span>
          </a>
        </div>
        <p class="t-small channels__hint">
          El botón abre su cliente de correo con el asunto y los campos ya preparados. Si no se abre,
          escriba directamente a <a href={`mailto:${contact.email}`} class="link-plain">{contact.email}</a>.
        </p>
      </div>

      <dl class="details">
        <div class="detail">
          <dt><Icon name="mail" size={18} />Correo</dt>
          <dd><a href={`mailto:${contact.email}`} class="link-plain">{contact.email}</a></dd>
        </div>
        <div class="detail">
          <dt><Icon name="phone" size={18} />Teléfono y WhatsApp</dt>
          <dd><a href={telUrl()} class="link-plain">{contact.phoneDisplay}</a></dd>
        </div>
        <div class="detail">
          <dt><Icon name="clock" size={18} />Horario</dt>
          <dd class="t-data">Lunes a viernes, {contact.hours}</dd>
        </div>
        <div class="detail">
          <dt><Icon name="map-pin" size={18} />Ubicación</dt>
          <dd class="t-data">{contact.locationPublic}</dd>
        </div>
        <div class="detail">
          <dt><Icon name="arrow-right" size={18} />Cobertura</dt>
          <dd class="t-data">Todo {company.geography}</dd>
        </div>
      </dl>
    </div>
  </section>

  {/* Section 03: Qué incluir */}
  <section class="shell section rule-top" aria-labelledby="incluir-title">
    <SectionIndex index={3} label="Qué incluir" />
    <div class="intake-head">
      <h2 id="incluir-title" class="t-h2">Con estos cuatro datos respondemos mejor</h2>
      <p class="t-body intake-head__body">
        No es un requisito: puede escribirnos con lo que tenga. Pero mientras más concreto sea el
        punto de partida, menos ida y vuelta antes de una propuesta real.
      </p>
    </div>

    <ol class="intake">
      {
        intake.map((item, i) => (
          <li class="intake__item">
            <span class="intake__num t-data" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="intake__title">{item.title}</h3>
              <p class="intake__body t-small">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="mt-10">
      <a href={mailtoHref} class="btn btn-secondary">Escribir con estos datos</a>
    </p>
  </section>

  {/* Section 04: FAQ */}
  <section class="shell section rule-top" aria-labelledby="faq-title">
    <SectionIndex index={4} label="Preguntas frecuentes" />
    <h2 id="faq-title" class="t-h2">Antes de escribirnos</h2>
    <div class="faq">
      {
        faqItems.map((item) => (
          <details name="faq" class="faq__item">
            <summary>
              <span>{item.question}</span>
              <Icon name="chevron-down" size={20} class="faq__chevron" />
            </summary>
            <p class="t-body faq__answer">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>
</Layout>

<script is:inline>
(function(){
var form=document.getElementById('solicitud-form');
if(!form)return;
var btn=document.getElementById('solicitud-btn');
var okPanel=document.getElementById('solicitud-success');
var errPanel=document.getElementById('solicitud-network-error');
var summary=form.querySelector('[data-error-summary]');
var rat=document.getElementById('solicitud-render-at');
if(rat)rat.value=String(Date.now()/1000);
var sid=document.getElementById('solicitud-submission-id');
if(sid)sid.value=crypto.randomUUID();

function vf(f){
  var e=document.getElementById(f.id+'-error');
  if(!e)return true;
  var bad=f.required&&!f.value.trim();
  if(bad){
    f.setAttribute('aria-invalid','true');
    e.textContent='Campo obligatorio';
    e.removeAttribute('hidden');
  }else{
    f.removeAttribute('aria-invalid');
    e.setAttribute('hidden','');
    e.textContent='';
  }
  return !bad;
}

var reqs=[].slice.call(form.querySelectorAll('[required]'));
reqs.forEach(function(f){
  f.addEventListener('blur',function(){vf(f);});
  f.addEventListener('input',function(){if(f.getAttribute('aria-invalid')==='true')vf(f);});
});

function buildMailto(){
  var n=(form.querySelector('[name="need"]')||{}).value||'';
  var em=(form.querySelector('[name="email"]')||{}).value||'';
  var o=(form.querySelector('[name="org"]')||{}).value||'';
  return 'mailto:'+encodeURIComponent('contacto@origenlab.cl')+
    '?subject='+encodeURIComponent('Solicitud de cotización')+
    '&body='+encodeURIComponent((n?'Necesito: '+n.trim()+'\n':'')+(o?'Institución: '+o.trim()+'\n':'')+(em?'Correo: '+em.trim():''));
}

form.addEventListener('submit',function(ev){
  ev.preventDefault();
  var allOk=true,msgs=[];
  reqs.forEach(function(f){
    if(!vf(f)){
      allOk=false;
      var lbl=form.querySelector('label[for="'+f.id+'"]');
      msgs.push(lbl?lbl.textContent.replace(/\s*\*\s*/g,'').trim():f.name);
    }
  });
  if(!allOk){
    summary.textContent='Complete los campos obligatorios: '+msgs.join(', ');
    summary.removeAttribute('hidden');
    summary.focus();
    return;
  }
  summary.setAttribute('hidden','');
  btn.disabled=true;
  var orig=btn.textContent;
  btn.textContent='Enviando…';
  var data=Object.fromEntries(new FormData(form));
  fetch('/api/web/solicitud',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})
    .then(function(r){
      if(r.ok||r.redirected){
        var es=okPanel.querySelector('[data-success-email]');
        if(es)es.textContent=(form.querySelector('[name="email"]')||{}).value||'su correo';
        form.setAttribute('hidden','');
        okPanel.removeAttribute('hidden');
        okPanel.focus();
      }else{
        var ml=errPanel.querySelector('[data-error-mailto]');
        if(ml)ml.href=buildMailto();
        errPanel.removeAttribute('hidden');
        btn.disabled=false;
        btn.textContent=orig;
        errPanel.focus();
      }
    })
    .catch(function(){
      var ml=errPanel.querySelector('[data-error-mailto]');
      if(ml)ml.href=buildMailto();
      errPanel.removeAttribute('hidden');
      btn.disabled=false;
      btn.textContent=orig;
      errPanel.focus();
    });
});
})();
</script>

<style>
  /* ---- Section 01: Solicitud grid ---------------------------------------- */
  .solicitud-grid { display: grid; gap: 3rem; }
  .solicitud-panel { border-radius: var(--radius-edge); padding: 1.5rem; margin-bottom: 2rem; }
  .solicitud-panel--ok { background-color: #f0faf9; border: 1px solid #9dd4cc; }
  .solicitud-panel--err,
  .sol-error-summary { background-color: #fef2f2; border: 1px solid #fca5a5; border-radius: var(--radius-edge); }
  .sol-error-summary {
    padding: 0.875rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-ink-800);
  }
  .sol-error-summary:focus, .solicitud-panel--ok:focus { outline: 2px solid var(--color-teal-700); outline-offset: 2px; }
  .solicitud-panel--err:focus { outline: 2px solid #dc2626; outline-offset: 2px; }
  .sol-form { margin-top: 2rem; position: relative; }
  .sol-trap-wrap { position: absolute; opacity: 0; pointer-events: none; left: -9999px; top: 0; height: 0; overflow: hidden; }
  .sol-field { display: grid; gap: 0.375rem; margin-bottom: 1.25rem; }
  .sol-label { font-size: 0.9375rem; font-weight: 600; color: var(--color-ink-900); }
  .sol-input, .sol-textarea {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-edge);
    font-size: 0.9375rem;
    color: var(--color-ink-950);
    background-color: #fff;
    font-family: inherit;
  }
  .sol-input:focus, .sol-textarea:focus { outline: 2px solid var(--color-teal-700); outline-offset: 1px; border-color: var(--color-teal-700); }
  .sol-input[aria-invalid='true'], .sol-textarea[aria-invalid='true'] { border-color: #dc2626; }
  .sol-textarea { resize: vertical; min-height: 7rem; }
  .sol-field-error { font-size: 0.875rem; color: #dc2626; margin: 0; }
  .sol-optional { margin-bottom: 1.5rem; border: 1px solid var(--color-hairline); border-radius: var(--radius-edge); }
  .sol-optional__summary { padding: 0.75rem 1rem; cursor: pointer; list-style: none; color: var(--color-ink-600); }
  .sol-optional__summary::-webkit-details-marker { display: none; }
  .sol-optional__body { padding: 0.75rem 1rem 1rem; border-top: 1px solid var(--color-hairline); display: grid; gap: 0.75rem; }
  /* Steps in aside reuse .intake__item / .intake__num / .intake__body */
  .sol-steps { list-style: none; margin: 0 0 2rem; padding: 0; border-top: 1px solid var(--color-ink-950); }
  .sol-aside-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-bottom: 1.5rem; }
  @media (min-width: 768px) {
    .solicitud-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 4rem; align-items: start; }
  }

  /* ---- Section 02: Canales ----------------------------------------------- */
  .channels {
    display: grid;
    gap: 3rem;
  }
  .channels__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }
  .channels__hint {
    margin-top: 1.5rem;
    color: var(--color-ink-500);
    max-width: 52ch;
  }

  /* ---- Shared: details list ---------------------------------------------- */
  .details {
    margin: 0;
    border-top: 1px solid var(--color-ink-950);
  }
  .detail {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .detail dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }
  .detail dd {
    margin: 0;
    padding-left: 1.75rem;
    color: var(--color-ink-950);
    font-size: 0.9375rem;
  }
  .detail dd a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
  }

  /* ---- Section 03: Intake ------------------------------------------------ */
  .intake-head {
    display: grid;
    gap: 1.25rem;
  }
  .intake-head__body {
    max-width: 60ch;
  }
  .intake {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-ink-950);
  }
  .intake__item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .intake__num {
    color: var(--color-teal-800);
    font-size: 0.8125rem;
  }
  .intake__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink-950);
  }
  .intake__body {
    margin-top: 0.5rem;
    color: var(--color-ink-600);
    max-width: 60ch;
  }

  /* ---- Section 04: FAQ --------------------------------------------------- */
  .faq {
    margin-top: 3rem;
    border-top: 1px solid var(--color-ink-950);
    max-width: 52rem;
  }
  .faq__item {
    border-bottom: 1px solid var(--color-hairline);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.5rem;
    padding-block: 1rem;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-ink-950);
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__chevron {
    color: var(--color-ink-500);
    flex-shrink: 0;
  }
  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq__chevron {
      transition: transform 150ms;
    }
  }
  .faq__answer {
    padding-bottom: 1.5rem;
    color: var(--color-ink-600);
  }

  /* ---- Responsive adjustments -------------------------------------------- */
  @media (min-width: 768px) {
    .channels {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 4rem;
      align-items: start;
    }
    .intake-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 4rem;
      align-items: baseline;
    }
    .intake {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 4rem;
    }
    .intake__item {
      grid-template-columns: 3rem minmax(0, 1fr);
      padding-block: 1.75rem;
    }
  }
</style>

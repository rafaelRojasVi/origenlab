---
import Layout from '../../../layouts/Layout.astro';
import PageIntro from '../../../components/ui/PageIntro.astro';
import FamilyModels from '../../../components/product/FamilyModels.astro';
import FamilyConsult from '../../../components/product/FamilyConsult.astro';
import CompareTable from '../../../components/ui/CompareTable.astro';
import BrandLogo from '../../../components/ui/BrandLogo.astro';
import ExternalLink from '../../../components/ui/ExternalLink.astro';
import Notice from '../../../components/ui/Notice.astro';
import Icon from '../../../components/ui/Icon.astro';
import { getCollection } from 'astro:content';
import type { Modelo } from '../../../content.config';
import { getProductFamilyBySlug } from '../../../data/productFamilies';
import { categories } from '../../../data/categories';
import { getBrandById, getOrtoalresaCentrifuges } from '../../../lib/catalog';
import { itemListJsonLd } from '../../../lib/jsonld';

const family = getProductFamilyBySlug('centrifugas');
const products = getOrtoalresaCentrifuges();
const brand = getBrandById('ortoalresa');
/** Página propia de centrifugación (URL heredada), en el mismo lenguaje que las
 *  demás familias: tarjetas iluminadas → ficha, comparativa compacta y la banda
 *  «¿No sabe cuál?». Orden comercial dentro de `FamilyModels`/`CompareTable`. */
const models = (await getCollection('modelos'))
  .map((item) => item.data as Modelo)
  .filter((entry) => entry.family === 'centrifugacion');

/** Columnas de la comparativa: las tres decisiones de compra. El resto vive en cada ficha. */
const compareRows = ['Capacidad máxima', 'Velocidad máxima', 'Versión', 'Temperatura'];

/** Aplicaciones declaradas en las fichas, sin repetir, en orden de aparición. */
const applications = [...new Set(products.flatMap((product) => product.applications ?? []))];

const relatedCategories = categories.filter((category) =>
  family?.categorySlugs.includes(category.slug),
);
---

<Layout
  title="Centrífugas de laboratorio"
  description="Cinco modelos de centrífugas Ortoalresa: microcentrífugas ventiladas y refrigeradas, universales y de gran capacidad. Cotización a través de OrigenLab."
  jsonLd={[itemListJsonLd(products, 'Centrífugas Ortoalresa')]}
>
  <div class="shell">
    <PageIntro
      title={family?.name ?? 'Centrífugas'}
      lead={family?.description}
      crumbs={[{ label: 'Productos', href: '/productos/' }, { label: 'Centrífugas' }]}
    >
      <div slot="aside">
        {
          brand && (
            <a href={`/marcas/${brand.slug}/`} class="brand-link">
              <BrandLogo brand={brand} scale={1.3} />
              <span class="t-label brand-link__label">Marca del catálogo</span>
            </a>
          )
        }
      </div>
    </PageIntro>
  </div>

  <section class="shell cf-sec" aria-labelledby="modelos-title">
    <h2 id="modelos-title" class="sr-only">Modelos de centrífugas</h2>
    <FamilyModels models={models} eager={4} label="Modelos de centrífugas" />
  </section>

  <section class="shell cf-sec" aria-labelledby="comparativa-title">
    <h2 id="comparativa-title" class="t-h2">Compárelas<span class="dot">.</span></h2>
    <p class="lede cf-lede">
      La elección suele resolverse en tres decisiones: volumen por ciclo, si necesita control de
      temperatura y qué formatos de tubo va a usar.
    </p>
    <CompareTable
      models={models}
      family="centrifugacion"
      labels={compareRows}
      caption="Comparativa de especificaciones de las centrífugas Ortoalresa"
    />
  </section>

  <section class="shell cf-sec cf-rule" aria-labelledby="aplicaciones-title">
    <div class="cf-two">
      <div>
        <h2 id="aplicaciones-title" class="t-h2">Dónde se usan<span class="dot">.</span></h2>
        <p class="t-body cf-apps">{applications.join(', ')}.</p>
        <ul class="link-row mt-6">
          {
            relatedCategories.map((category) => (
              <li>
                <a href={`/categorias/${category.slug}/`} class="link-arrow">
                  {category.name}
                  <Icon name="arrow-right" size={18} class="arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        brand && (
          <div class="cf-brand">
            <BrandLogo brand={brand} scale={1.3} />
            <p class="t-body cf-brand__summary">{brand.summary}</p>
            <div class="cf-brand__links">
              <a href={`/marcas/${brand.slug}/`} class="link-arrow">
                Ver {brand.name}
                <Icon name="arrow-right" size={18} class="arrow" />
              </a>
              {brand.websiteUrl && (
                <ExternalLink href={brand.websiteUrl} context="sitio del fabricante">
                  Sitio del fabricante
                </ExternalLink>
              )}
            </div>
          </div>
        )
      }
    </div>
    {brand && <Notice class="mt-10">{brand.manufacturerAttribution} {brand.commercialNote}</Notice>}
  </section>

  <FamilyConsult brandName={brand?.name} />
</Layout>

<style>
  .brand-link {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    border-radius: var(--radius-edge);
  }
  .brand-link__label {
    color: var(--color-ink-500);
  }
  .cf-sec {
    padding-block: 2.5rem 4rem;
  }
  .cf-rule {
    border-top: 1px solid var(--color-hairline);
    padding-top: 4rem;
  }
  .cf-lede {
    margin: 0.75rem 0 2rem;
    max-width: 52ch;
  }
  .cf-two {
    display: grid;
    gap: 3rem;
  }
  .cf-apps {
    margin-top: 1rem;
    color: var(--color-ink-600);
    max-width: 62ch;
  }
  .cf-brand {
    padding: 2rem;
    border-radius: var(--radius-card);
    background: var(--color-tint-centrifugacion);
  }
  .cf-brand__summary {
    margin-top: 1.25rem;
    color: var(--color-ink-800);
  }
  .cf-brand__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 768px) {
    .cf-sec {
      padding-block: 3rem 6rem;
    }
    .cf-rule {
      padding-top: 6rem;
    }
  }
  @media (min-width: 1024px) {
    .cf-two {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: 5rem;
      align-items: start;
    }
  }
</style>

---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageIntro from '../../../components/ui/PageIntro.astro';
import SectionIndex from '../../../components/ui/SectionIndex.astro';
import ProductFigure from '../../../components/ui/ProductFigure.astro';
import KeyFacts from '../../../components/ui/KeyFacts.astro';
import SpecGroups from '../../../components/ui/SpecGroups.astro';
import ModelList from '../../../components/ui/ModelList.astro';
import ModelRow from '../../../components/ui/ModelRow.astro';
import ClosingQuoteBand from '../../../components/ui/ClosingQuoteBand.astro';
import ExternalLink from '../../../components/ui/ExternalLink.astro';
import Icon from '../../../components/ui/Icon.astro';
import FamilyMotif from '../../../components/home/FamilyMotif.astro';
import ProductStory from '../../../components/product/ProductStory.astro';
import { site } from '../../../config/site';
import { ctaLabels } from '../../../lib/ctaLabels';
import { buildWhatsAppQuoteUrl } from '../../../lib/whatsapp';
import { getProductFamilyBySlug } from '../../../data/productFamilies';
import {
  getBrandById,
  getOrtoalresaCentrifuges,
  getProductByFamilyAndSlug,
  keyFactsFor,
} from '../../../lib/catalog';
import { productJsonLd } from '../../../lib/jsonld';
import type { ProductStoryConfig } from '../../../lib/showroom/productStory';
import type { Modelo } from '../../../content.config';

export function getStaticPaths() {
  return getOrtoalresaCentrifuges().map((product) => ({ params: { slug: product.slug } }));
}

const { slug } = Astro.params;
const product = slug ? getProductByFamilyAndSlug('centrifugas', slug) : undefined;
if (!product) return Astro.redirect('/productos/centrifugas');

const brand = getBrandById(product.brandId);
const family = getProductFamilyBySlug('centrifugas');
const facts = keyFactsFor(product);
const related = getOrtoalresaCentrifuges().filter((item) => item.slug !== product.slug);
const whatsappHref = buildWhatsAppQuoteUrl({ productName: product.name, brandName: brand?.name });

/*
 * Centrifugación conserva estas fichas (`lib/modelos.ts`), pero si la ficha de
 * la colección `modelos` del mismo equipo (`entry.slug === product.id`) tiene
 * historia por scroll (`stories/<showroom_id>.ts`), esta página la monta en
 * lugar de la fotografía del hero. Sin historia, la página no cambia.
 */
const entry = (await getCollection('modelos')).map((item) => item.data as Modelo).find((item) => item.slug === product.id);
/* Los CTA llevan el modelo al formulario cuando la ficha existe en la colección. */
const quoteHref = entry ? `/contacto/?producto=${entry.slug}` : site.quoteHref;
const stories = import.meta.glob<{ story: ProductStoryConfig }>('../../../lib/showroom/stories/*.ts', { eager: true });
const story = entry?.showroom_id
  ? Object.entries(stories).find(([path]) => path.endsWith(`/${entry.showroom_id}.ts`))?.[1].story
  : undefined;
const poster =
  story && entry && existsSync(join(process.cwd(), 'public', 'products', `${entry.slug}-poster.jpg`))
    ? `/products/${entry.slug}-poster.jpg`
    : undefined;

/* Con historia, ella cuenta aplicaciones y ficha (como en la página de modelo): esas secciones no se repiten. */
const shown = {
  apps: !story && Boolean(product.applications?.length),
  specs: !story && Boolean(product.keySpecs?.length),
  related: true,
  conditions: true,
};
let counter = 0;
const index = Object.fromEntries(Object.entries(shown).map(([key, on]) => [key, on ? ++counter : 0])) as Record<
  keyof typeof shown,
  number
>;
const bandIndex = counter + 1;

const metaTitle = product.metaTitle
  ? product.metaTitle.replace(/\s*\|\s*OrigenLab\s*$/, '')
  : `${product.name}, ${product.equipmentType ?? 'centrífuga'}`;
const metaDescription = (
  product.metaDescription ??
  `${product.summary} Cotización a través de OrigenLab; disponibilidad sujeta a confirmación comercial.`
).slice(0, 158);
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[productJsonLd(product, brand)]}
  ogImagePath={poster}
>
  <div class="legacy-page">
  <div class="shell">
    <PageIntro
      title={product.name}
      crumbs={[
        { label: 'Productos', href: '/productos/' },
        { label: family?.name ?? 'Centrífugas', href: '/productos/centrifugas/' },
        { label: product.name },
      ]}
    />
  </div>

  <section class:list={['shell product-hero', story && 'product-hero--story']} aria-label={`${product.name}, resumen`}>
    {
      !story && (
        <div class="product-hero__media">
          <ProductFigure
            product={product}
            priority
            sizes="(min-width: 1024px) 460px, (min-width: 768px) 45vw, 82vw"
            caption={brand ? `${product.name}, ${brand.name}` : product.name}
          />
        </div>
      )
    }

    <div class="product-hero__body">
      <p class="t-label product-hero__type">{product.equipmentType}</p>
      {
        brand && (
          <p class="product-hero__brand">
            <a href={`/marcas/${brand.slug}/`} class="link-plain" translate="no">{brand.name}</a>
            {brand.legalName && <span class="product-hero__legal">{brand.legalName}</span>}
          </p>
        )
      }
      <p class="t-body product-hero__desc">{product.description ?? product.summary}</p>

      <KeyFacts facts={facts} class="product-hero__facts" />

      <div class="product-hero__actions">
        <a href={quoteHref} class="btn btn-primary">{ctaLabels.solicitarCotizacion}</a>
        <a href={whatsappHref} class="link-arrow" target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" size={18} />
          {ctaLabels.escribirWhatsapp}
          <span class="sr-only">
            {product.name} (abre WhatsApp en una pestaña nueva)
          </span>
        </a>
      </div>
    </div>
  </section>

  {/* La historia por scroll es el hero visual: el lienzo 3D sustituye a la fotografía. */}
  {story && entry && <ProductStory config={story} entry={entry} />}

  {
    shown.apps && product.applications && (
      <section class="shell section rule-top" aria-labelledby="aplicaciones-title">
        <SectionIndex index={index.apps} label="Aplicaciones" />
        <div class="product-apps__grid">
          <div>
            <h2 id="aplicaciones-title" class="t-h2">Para qué se usa</h2>
            <p class="t-body product-apps">{product.applications.join(', ')}.</p>
            <p class="t-small product-apps__note">{product.application}</p>
          </div>
          {/* El diagrama de la familia acompaña a la fotografía: la fotografía
              dice cómo es el equipo y el diagrama qué le hace a la muestra. */}
          {brand && (
            <div class="product-apps__motif">
              <FamilyMotif familyId={brand.familyId} />
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    shown.specs && product.keySpecs && (
      <section class="shell section rule-top" aria-labelledby="especificaciones-title">
        <SectionIndex index={index.specs} label="Especificaciones" />
        <h2 id="especificaciones-title" class="t-h2">Ficha técnica</h2>
        <div class="mt-10">
          <SpecGroups specs={product.keySpecs} attribution={product.specsAttribution} />
        </div>
        <div class="product-docs">
          {product.datasheetUrl && (
            <ExternalLink href={product.datasheetUrl} context="catálogo PDF del fabricante">
              <Icon name="file" size={18} />
              Catálogo PDF del fabricante
            </ExternalLink>
          )}
          {product.manufacturerUrl && (
            <ExternalLink href={product.manufacturerUrl} context="ficha en el sitio del fabricante">
              Ficha en el sitio del fabricante
            </ExternalLink>
          )}
        </div>
      </section>
    )
  }

  <section class="shell section rule-top" aria-labelledby="relacionados-title">
    <SectionIndex index={index.related} label="Modelos relacionados" />
    <h2 id="relacionados-title" class="t-h2">Otros modelos de la familia</h2>
    <ModelList class="mt-10">
      {related.map((item) => <ModelRow product={item} size="compact" />)}
    </ModelList>
    <a href="/productos/centrifugas/" class="link-arrow mt-8">
      Ver la familia y la comparativa
      <Icon name="arrow-right" size={18} class="arrow" />
    </a>
  </section>

  <section class="shell section rule-top" aria-labelledby="condiciones-title">
    <SectionIndex index={index.conditions} label="Condiciones" />
    <h2 id="condiciones-title" class="t-h2">Condiciones comerciales</h2>
    <div class="prose-block conditions">
      <p class="t-body">{product.commercialNote}</p>
      <p class="t-body">
        Equipo disponible bajo cotización a través de OrigenLab. Esta ficha no compromete plazos de
        entrega, stock ni términos de garantía: se confirman por escrito en la cotización.
      </p>
    </div>
  </section>

  {
    story && (
      <aside class="cta-bar" data-sticky-cta aria-label={`Cotizar ${product.name}`}>
        <div class="shell cta-bar__inner">
          <p class="cta-bar__name t-data" translate="no">{brand?.name} {product.name}</p>
          <a href={quoteHref} class="btn btn-primary" data-track="cotizacion_click" data-modelo={entry?.slug}>{ctaLabels.solicitarCotizacion}</a>
          <a href={whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-modelo={entry?.slug}>
            <Icon name="whatsapp" size={18} />
            WhatsApp
            <span class="sr-only">(abre WhatsApp en una pestaña nueva)</span>
          </a>
        </div>
      </aside>
    )
  }
  </div>

  <ClosingQuoteBand
    index={bandIndex}
    title={`Cotizar ${product.name}`}
    body="Comparta la aplicación, la configuración de rotor que necesita y su institución. Respondemos con alternativas y condiciones por escrito."
    productName={product.name}
    brandName={brand?.name}
    modelo={story ? entry?.slug : undefined}
    quoteHref={quoteHref}
  />
</Layout>

<script>
  /** Con historia por scroll la ficha mide los mismos clics que la página de modelo (`lib/stats.ts`). */
  import { installTrackClicks } from '../../../lib/stats';

  if (document.querySelector('[data-story]')) installTrackClicks();
</script>

<style>
  /* Barra fija de cotización de la historia: la misma de `ModelHero` (página de modelo). */
  .cta-bar {
    position: sticky;
    bottom: 0;
    z-index: 20;
    background-color: var(--color-paper);
    border-top: 1px solid var(--color-hairline);
  }
  .cta-bar__inner {
    display: flex;
    align-items: center;
    gap: 0.5rem 1rem;
    padding-block: 0.625rem;
  }
  .cta-bar__name {
    display: none;
    margin-right: auto;
    color: var(--color-ink-800);
  }
  .cta-bar .btn {
    min-height: 2.75rem;
    padding-inline: 1rem;
  }
  .cta-bar .btn-primary {
    flex: 1 1 auto;
  }
  :global(:root:has([data-sticky-cta])) {
    scroll-padding-bottom: 5rem;
  }
  @media (min-width: 760px) {
    .cta-bar__name {
      display: block;
    }
    .cta-bar .btn-primary {
      flex: none;
    }
    /* El escenario fijo de la historia termina sobre la barra, no debajo. */
    .legacy-page :global(.story__stage) {
      height: calc(100vh - 8rem);
    }
  }
  .product-hero {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 4rem;
  }
  .product-hero--story .product-hero__body {
    max-width: 48rem;
  }
  .product-hero__media {
    max-width: 22rem;
  }
  .product-hero__type {
    color: var(--color-ink-500);
    text-transform: none;
    letter-spacing: 0.01em;
  }
  .product-hero__brand {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }
  .product-hero__legal {
    margin-left: 0.75rem;
    color: var(--color-ink-500);
  }
  .product-hero__desc {
    margin-top: 1.5rem;
  }
  .product-hero__facts {
    margin-top: 2rem;
  }
  .product-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }

  .product-apps {
    margin-top: 1.25rem;
    color: var(--color-ink-800);
    max-width: 60ch;
  }
  .product-apps__note {
    margin-top: 1rem;
    color: var(--color-ink-600);
    max-width: 62ch;
  }
  .product-apps__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .product-apps__motif {
    max-width: 12rem;
    color: var(--color-ink-800);
  }
  .product-docs {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 2.5rem;
  }
  .conditions {
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .product-hero:not(.product-hero--story) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
      align-items: start;
      padding-bottom: 5rem;
    }
    .product-hero__media {
      max-width: none;
      position: sticky;
      top: 6rem;
    }
    .product-apps__grid {
      grid-template-columns: minmax(0, 1fr) 12rem;
      gap: 4rem;
    }
  }
</style>

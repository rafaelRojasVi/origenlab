---
import Layout from '../../../layouts/Layout.astro';
import PageIntro from '../../../components/ui/PageIntro.astro';
import SectionIndex from '../../../components/ui/SectionIndex.astro';
import ProductFigure from '../../../components/ui/ProductFigure.astro';
import KeyFacts from '../../../components/ui/KeyFacts.astro';
import SpecGroups from '../../../components/ui/SpecGroups.astro';
import ModelRow from '../../../components/ui/ModelRow.astro';
import ClosingQuoteBand from '../../../components/ui/ClosingQuoteBand.astro';
import ExternalLink from '../../../components/ui/ExternalLink.astro';
import Icon from '../../../components/ui/Icon.astro';
import { site } from '../../../config/site';
import { ctaLabels } from '../../../lib/ctaLabels';
import { buildWhatsAppQuoteUrl } from '../../../lib/whatsapp';
import { getProductFamilyBySlug } from '../../../data/productFamilies';
import {
  getBrandById,
  getOrtoalresaCentrifuges,
  getProductByFamilyAndSlug,
  keyFactsFor,
} from '../../../lib/catalog';
import { productJsonLd } from '../../../lib/jsonld';

export function getStaticPaths() {
  return getOrtoalresaCentrifuges().map((product) => ({ params: { slug: product.slug } }));
}

const { slug } = Astro.params;
const product = slug ? getProductByFamilyAndSlug('centrifugas', slug) : undefined;
if (!product) return Astro.redirect('/productos/centrifugas');

const brand = getBrandById(product.brandId);
const family = getProductFamilyBySlug('centrifugas');
const facts = keyFactsFor(product);
const related = getOrtoalresaCentrifuges().filter((item) => item.slug !== product.slug);
const whatsappHref = buildWhatsAppQuoteUrl({ productName: product.name, brandName: brand?.name });

const metaTitle = product.metaTitle
  ? product.metaTitle.replace(/\s*\|\s*OrigenLab\s*$/, '')
  : `${product.name}, ${product.equipmentType ?? 'centrífuga'}`;
const metaDescription = (
  product.metaDescription ??
  `${product.summary} Cotización a través de OrigenLab; disponibilidad sujeta a confirmación comercial.`
).slice(0, 158);
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[productJsonLd(product, brand)]}
>
  <div class="shell">
    <PageIntro
      title={product.name}
      crumbs={[
        { label: 'Productos', href: '/productos/' },
        { label: family?.name ?? 'Centrífugas', href: '/productos/centrifugas/' },
        { label: product.name },
      ]}
    />
  </div>

  <section class="shell product-hero" aria-label={`${product.name}, resumen`}>
    <div class="product-hero__media">
      <ProductFigure
        product={product}
        priority
        sizes="(min-width: 1024px) 460px, (min-width: 768px) 45vw, 82vw"
      />
    </div>

    <div class="product-hero__body">
      <p class="t-label product-hero__type">{product.equipmentType}</p>
      {
        brand && (
          <p class="product-hero__brand">
            <a href={`/marcas/${brand.slug}/`} class="link-plain" translate="no">{brand.name}</a>
            {brand.legalName && <span class="product-hero__legal">{brand.legalName}</span>}
          </p>
        )
      }
      <p class="t-body product-hero__desc">{product.description ?? product.summary}</p>

      <KeyFacts facts={facts} class="product-hero__facts" />

      <div class="product-hero__actions">
        <a href={site.quoteHref} class="btn btn-primary">{ctaLabels.solicitarCotizacion}</a>
        <a href={whatsappHref} class="link-arrow" target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" size={18} />
          Cotizar por WhatsApp
          <span class="sr-only">
            {product.name} (abre WhatsApp en una pestaña nueva)
          </span>
        </a>
      </div>
    </div>
  </section>

  {
    product.applications && product.applications.length > 0 && (
      <section class="shell section rule-top" aria-labelledby="aplicaciones-title">
        <SectionIndex index={1} label="Aplicaciones" />
        <h2 id="aplicaciones-title" class="t-h2">Para qué se usa</h2>
        <p class="t-body product-apps">{product.applications.join(', ')}.</p>
        <p class="t-small product-apps__note">{product.application}</p>
      </section>
    )
  }

  {
    product.keySpecs && product.keySpecs.length > 0 && (
      <section class="shell section rule-top" aria-labelledby="especificaciones-title">
        <SectionIndex index={2} label="Especificaciones" />
        <h2 id="especificaciones-title" class="t-h2">Ficha técnica</h2>
        <div class="mt-10">
          <SpecGroups specs={product.keySpecs} attribution={product.specsAttribution} />
        </div>
        <div class="product-docs">
          {product.datasheetUrl && (
            <ExternalLink href={product.datasheetUrl} context="catálogo PDF del fabricante">
              <Icon name="file" size={18} />
              Catálogo PDF del fabricante
            </ExternalLink>
          )}
          {product.manufacturerUrl && (
            <ExternalLink href={product.manufacturerUrl} context="ficha en el sitio del fabricante">
              Ficha en el sitio del fabricante
            </ExternalLink>
          )}
        </div>
      </section>
    )
  }

  <section class="shell section rule-top" aria-labelledby="relacionados-title">
    <SectionIndex index={3} label="Modelos relacionados" />
    <h2 id="relacionados-title" class="t-h2">Otros modelos de la familia</h2>
    <ul class="model-list">
      {related.map((item) => <ModelRow product={item} size="compact" />)}
    </ul>
    <a href="/productos/centrifugas/" class="link-arrow mt-8">
      Ver la familia y la comparativa
      <Icon name="arrow-right" size={18} class="arrow" />
    </a>
  </section>

  <section class="shell section rule-top" aria-labelledby="condiciones-title">
    <SectionIndex index={4} label="Condiciones" />
    <h2 id="condiciones-title" class="t-h2">Condiciones comerciales</h2>
    <div class="prose-block conditions">
      <p class="t-body">{product.commercialNote}</p>
      <p class="t-body">
        Equipo disponible bajo cotización a través de OrigenLab. Esta ficha no compromete plazos de
        entrega, stock ni términos de garantía: se confirman por escrito en la cotización.
      </p>
    </div>
  </section>

  <ClosingQuoteBand
    index={5}
    title={`Cotizar ${product.name}`}
    body="Comparta la aplicación, la configuración de rotor que necesita y su institución. Respondemos con alternativas y condiciones por escrito."
    productName={product.name}
    brandName={brand?.name}
  />
</Layout>

<style>
  .product-hero {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 4rem;
  }
  .product-hero__media {
    max-width: 22rem;
  }
  .product-hero__type {
    color: var(--color-ink-500);
    text-transform: none;
    letter-spacing: 0.01em;
  }
  .product-hero__brand {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }
  .product-hero__legal {
    margin-left: 0.75rem;
    color: var(--color-ink-500);
  }
  .product-hero__desc {
    margin-top: 1.5rem;
  }
  .product-hero__facts {
    margin-top: 2rem;
  }
  .product-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }

  .product-apps {
    margin-top: 1.25rem;
    color: var(--color-ink-800);
    max-width: 60ch;
  }
  .product-apps__note {
    margin-top: 1rem;
    color: var(--color-ink-600);
    max-width: 62ch;
  }
  .product-docs {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 2.5rem;
  }
  .model-list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-ink-950);
  }
  .conditions {
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .product-hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
      align-items: start;
      padding-bottom: 5rem;
    }
    .product-hero__media {
      max-width: none;
      position: sticky;
      top: 6rem;
    }
  }
</style>

---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SpecGroups from '../../../components/ui/SpecGroups.astro';
import ModelList from '../../../components/ui/ModelList.astro';
import ModelRow from '../../../components/ui/ModelRow.astro';
import ClosingQuoteBand from '../../../components/ui/ClosingQuoteBand.astro';
import ExternalLink from '../../../components/ui/ExternalLink.astro';
import Button from '../../../components/ui/Button.astro';
import Icon from '../../../components/ui/Icon.astro';
import FamilyMotif from '../../../components/home/FamilyMotif.astro';
import ModelHero from '../../../components/product/ModelHero.astro';
import ModelHeroCopy from '../../../components/product/ModelHeroCopy.astro';
import ProductStory from '../../../components/product/ProductStory.astro';
import AccessoryCards from '../../../components/product/AccessoryCards.astro';
import ModelFaq from '../../../components/product/ModelFaq.astro';
import TrustStrip from '../../../components/product/TrustStrip.astro';
import { publicClaim } from '../../../data/claims';
import { faqJsonLd, productJsonLd } from '../../../lib/jsonld';
import { familyInfo, modelSections } from '../../../lib/modelos';
import {
  getBrandById,
  getOrtoalresaCentrifuges,
  getProductByFamilyAndSlug,
} from '../../../lib/catalog';
import type { ProductStoryConfig } from '../../../lib/showroom/productStory';
import type { Modelo } from '../../../content.config';

export function getStaticPaths() {
  return getOrtoalresaCentrifuges().map((product) => ({ params: { slug: product.slug } }));
}

const { slug } = Astro.params;
const product = slug ? getProductByFamilyAndSlug('centrifugas', slug) : undefined;
if (!product) return Astro.redirect('/productos/centrifugas');

const brand = getBrandById(product.brandId);
const related = getOrtoalresaCentrifuges().filter((item) => item.slug !== product.slug);

/*
 * Centrifugación conserva estas fichas (`lib/modelos.ts`), pero su primera
 * pantalla es la de toda página de modelo (`ModelHero`): el texto sale de la
 * ficha de la colección `modelos` del mismo equipo (`entry.slug === product.id`)
 * y, si ésta tiene historia por scroll (`stories/<showroom_id>.ts`), el
 * escenario 3D la acompaña. Una centrífuga sin ficha en la colección detiene
 * el build. Quedan aquí las secciones propias de la ficha heredada: ficha por
 * grupos, lista de modelos y condiciones comerciales.
 */
const entry = (await getCollection('modelos')).map((item) => item.data as Modelo).find((item) => item.slug === product.id);
if (!entry) throw new Error(`centrifugas/${product.slug}: la centrífuga «${product.id}» no tiene ficha en la colección modelos`);
const family = familyInfo(entry.family);
const quoteHref = `/contacto/?producto=${entry.slug}`;
const stories = import.meta.glob<{ story: ProductStoryConfig }>('../../../lib/showroom/stories/*.ts', { eager: true });
const story = entry.showroom_id
  ? Object.entries(stories).find(([path]) => path.endsWith(`/${entry.showroom_id}.ts`))?.[1].story
  : undefined;
const poster = story && existsSync(join(process.cwd(), 'public', 'products', `${entry.slug}-poster.jpg`)) ? `/products/${entry.slug}-poster.jpg` : undefined;
const media = story ? 'story' : 'photo';
const { accessories, faqs } = modelSections(entry, story);
const sameDay = Boolean(publicClaim('cotizacion-mismo-dia-habil'));

const metaTitle = product.metaTitle
  ? product.metaTitle.replace(/\s*\|\s*OrigenLab\s*$/, '')
  : `${product.name}, ${product.equipmentType ?? 'centrífuga'}`;
const metaDescription = (
  product.metaDescription ??
  `${product.summary} Cotización a través de OrigenLab; disponibilidad sujeta a confirmación comercial.`
).slice(0, 158);
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[productJsonLd(product, brand), faqJsonLd(faqs.map((faq) => ({ question: faq.q, answer: faq.a })))]}
  ogImagePath={poster}
>
  <ModelHero entry={entry} brand={brand} family={family} media={media} quoteHref={quoteHref}>
    {
      story && (
        <ProductStory config={story} entry={entry}>
          <Fragment slot="intro">
            <ModelHeroCopy entry={entry} brand={brand} family={family} quoteHref={quoteHref} />
          </Fragment>
        </ProductStory>
      )
    }

    {
      product.applications?.length ? (
        <section class="msec msec--alt" aria-labelledby="aplicaciones-title">
          <div class="shell product-apps__grid rv">
            <div>
              <p class="t-label">Aplicaciones</p>
              <h2 id="aplicaciones-title" class="mh2">
                Para qué se usa el <span translate="no">{entry.name}</span>
              </h2>
              <p class="t-body product-apps">{product.applications.join(', ')}.</p>
              <p class="t-small product-apps__note">{product.application}</p>
            </div>
            {/* El diagrama de la familia acompaña a la fotografía: la fotografía
                dice cómo es el equipo y el diagrama qué le hace a la muestra. */}
            {brand && (
              <div class="product-apps__motif">
                <FamilyMotif familyId={brand.familyId} />
              </div>
            )}
          </div>
        </section>
      ) : null
    }

    {
      product.keySpecs?.length ? (
        <section class="msec" aria-labelledby="ficha-title">
          <div class="shell rv">
            <p class="t-label">Ficha técnica</p>
            <h2 id="ficha-title" class="mh2">Datos del fabricante</h2>
            <div class="mt-10">
              <SpecGroups specs={product.keySpecs} attribution={product.specsAttribution} />
            </div>
            <div class="product-docs">
              {product.datasheetUrl && (
                <ExternalLink href={product.datasheetUrl} context="catálogo PDF del fabricante">
                  <Icon name="file" size={18} />
                  Catálogo PDF del fabricante
                </ExternalLink>
              )}
              {product.manufacturerUrl && (
                <ExternalLink href={product.manufacturerUrl} context="ficha en el sitio del fabricante">
                  Ficha en el sitio del fabricante
                </ExternalLink>
              )}
            </div>
          </div>
        </section>
      ) : null
    }

    {
      accessories.length > 0 && (
        <section class="msec msec--alt" aria-labelledby="accesorios-title">
          <div class="shell rv">
            <p class="t-label">Accesorios e insumos</p>
            <h2 id="accesorios-title" class="mh2">Accesorios disponibles</h2>
            <AccessoryCards items={accessories} quoteHref={quoteHref} />
          </div>
        </section>
      )
    }

    <section class="msec" aria-labelledby="relacionados-title">
      <div class="shell rv">
        <p class="t-label">Modelos relacionados</p>
        <h2 id="relacionados-title" class="mh2">Otros modelos de la familia</h2>
        <ModelList class="mt-10">
          {related.map((item) => <ModelRow product={item} size="compact" />)}
        </ModelList>
        <Button href="/productos/centrifugas/" variant="tertiary" class="mt-8">Ver la familia y la comparativa</Button>
      </div>
    </section>

    <TrustStrip />

    <section class="msec" aria-labelledby="preguntas-title">
      <div class="shell rv">
        <ModelFaq faqs={faqs} />
      </div>
    </section>

    <section class="msec msec--alt" aria-labelledby="condiciones-title">
      <div class="shell rv">
        <p class="t-label">Condiciones</p>
        <h2 id="condiciones-title" class="mh2">Condiciones comerciales</h2>
        <div class="prose-block conditions">
          <p class="t-body">{product.commercialNote}</p>
          <p class="t-body">
            Equipo disponible bajo cotización a través de OrigenLab. Esta ficha no compromete plazos de
            entrega, stock ni términos de garantía: se confirman por escrito en la cotización.
          </p>
        </div>
      </div>
    </section>
  </ModelHero>

  <ClosingQuoteBand
    title={sameDay ? `Cuéntenos su muestra. Le cotizamos el ${entry.name} el mismo día hábil.` : `Cuéntenos su muestra y le cotizamos el ${entry.name}.`}
    body="Comparta la aplicación, la configuración de rotor que necesita y su institución. Respondemos con alternativas y condiciones por escrito."
    productName={product.name}
    brandName={brand?.name}
    modelo={entry.slug}
    quoteHref={quoteHref}
  />
</Layout>

<style is:global>
  .product-apps {
    margin-top: 1.25rem;
    color: var(--color-ink-800);
    max-width: 60ch;
  }
  .product-apps__note {
    margin-top: 1rem;
    color: var(--color-ink-600);
    max-width: 62ch;
  }
  .product-apps__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .product-apps__motif {
    max-width: 12rem;
    color: var(--color-ink-800);
  }
  .product-docs {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 2.5rem;
  }
  .conditions {
    margin-top: 1.5rem;
  }
  @media (min-width: 768px) {
    .product-apps__grid {
      grid-template-columns: minmax(0, 1fr) 12rem;
      gap: 4rem;
    }
  }
</style>

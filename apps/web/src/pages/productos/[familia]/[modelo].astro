---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SectionIndex from '../../../components/ui/SectionIndex.astro';
import ExternalLink from '../../../components/ui/ExternalLink.astro';
import ClosingQuoteBand from '../../../components/ui/ClosingQuoteBand.astro';
import ModelHero from '../../../components/product/ModelHero.astro';
import ProductStory from '../../../components/product/ProductStory.astro';
import RelatedModels from '../../../components/product/RelatedModels.astro';
import TrustStrip from '../../../components/product/TrustStrip.astro';
import { site } from '../../../config/site';
import { getBrandById } from '../../../lib/catalog';
import { faqJsonLd } from '../../../lib/jsonld';
import { familyHref, familyInfo, hasCollectionPages, imageForEntry, modelHref, relatedFor } from '../../../lib/modelos';
import { PRODUCT_IMAGE_WIDTHS, imageSourcesFor } from '../../../lib/productImage';
import { showroomEntry } from '../../../lib/showroom/catalog';
import type { ProductStoryConfig } from '../../../lib/showroom/productStory';
import type { Modelo } from '../../../content.config';

/**
 * Página de modelo: una por archivo de `src/content/modelos/`, en
 * `/productos/{family}/{slug}/` (centrifugación conserva sus fichas de
 * `/productos/centrifugas/`, ver `lib/modelos.ts`).
 *
 * Orden (plan del sitio, anatomía de la página de modelo): hero → aplicaciones
 * → ficha técnica → accesorios → preguntas → relacionados → cómo se compra →
 * banda de cierre. Con historia por scroll (`stories/<showroom_id>.ts`) la
 * historia cuenta aplicaciones, ficha, accesorios y preguntas, y la página
 * sigue con relacionados. Una sección sin contenido no se dibuja.
 */
export async function getStaticPaths() {
  const all = (await getCollection('modelos')).map((item) => item.data as Modelo);
  return all
    .filter((entry) => hasCollectionPages(entry.family))
    .map((entry) => ({ params: { familia: entry.family, modelo: entry.slug }, props: { entry, all } }));
}

const { entry, all } = Astro.props as { entry: Modelo; all: Modelo[] };
const brand = getBrandById(entry.brand);
const brandName = brand?.name ?? entry.brand;
const family = familyInfo(entry.family);
const href = modelHref(entry);
const quoteHref = `/contacto/?producto=${entry.slug}`;

const stories = import.meta.glob<{ story: ProductStoryConfig }>('../../../lib/showroom/stories/*.ts', { eager: true });
const story = entry.showroom_id
  ? Object.entries(stories).find(([path]) => path.endsWith(`/${entry.showroom_id}.ts`))?.[1].story
  : undefined;
const media = story ? 'story' : entry.showroom_id && showroomEntry(entry.showroom_id) ? 'showroom' : 'photo';

const related = relatedFor(entry, all);
const faqs = [...entry.faqs, ...(story?.faqs ?? [])];
const sources = [...new Set(entry.specs.map((spec) => spec.source))].filter((url) => url !== entry.official_url);
const verified = new Date(`${entry.verified_on}T12:00:00Z`).toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

/* Numeración de las secciones que se dibujan, en orden; la banda lleva el último. */
const shown = {
  apps: !story && entry.applications.length > 0,
  specs: !story && entry.specs.length > 0,
  accessories: !story && entry.accessories.length > 0,
  faqs: !story && faqs.length > 0,
  related: related.length > 0,
  trust: true,
};
let counter = 0;
const index = Object.fromEntries(
  Object.entries(shown).map(([key, on]) => [key, on ? ++counter : undefined]),
) as Record<keyof typeof shown, number | undefined>;
const bandIndex = counter + 1;

/* Datos estructurados: el equipo, sin oferta (no se publica precio). */
const photo = imageSourcesFor(imageForEntry(entry));
const poster = existsSync(join(process.cwd(), 'public', 'products', `${entry.slug}-poster.jpg`))
  ? `/products/${entry.slug}-poster.jpg`
  : undefined;
const image = photo?.src ?? poster;
// og:image: el póster 3D; sin él, la fotografía verificada en WebP (los rastreadores sociales no leen AVIF, el formato maestro).
const ogImage = poster ?? (photo ? photo.src.replace(/\.[a-z0-9]+$/, `-${Math.max(...PRODUCT_IMAGE_WIDTHS)}.webp`) : undefined);
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${brandName} ${entry.name}`,
  description: entry.lead,
  category: family.name,
  url: `${site.baseUrl}${href}`,
  ...(image ? { image: `${site.baseUrl}${image}` } : {}),
  brand: { '@type': 'Brand', name: brandName },
  manufacturer: {
    '@type': 'Organization',
    name: brand?.legalName ?? brandName,
    url: brand?.websiteUrl ?? entry.official_url,
  },
  additionalProperty: entry.specs.map((spec) => ({ '@type': 'PropertyValue', name: spec.label, value: spec.value })),
};
const jsonLd = [
  productLd,
  ...(faqs.length > 0 ? [faqJsonLd(faqs.map((faq) => ({ question: faq.q, answer: faq.a })))] : []),
];

const longTitle = `${entry.name} de ${brandName} en Chile`;
const title = longTitle.length + ' | OrigenLab'.length <= 70 ? longTitle : entry.name;
const fullDescription = `Cotice el ${entry.name} de ${brandName} en Chile. ${entry.lead}`;
const description =
  fullDescription.length <= 158 ? fullDescription : `${fullDescription.slice(0, 157).replace(/\s+\S*$/, '')}…`;
---

<Layout title={title} description={description} jsonLd={jsonLd} ogImagePath={ogImage}>
  <ModelHero entry={entry} brand={brand} family={family} media={media} quoteHref={quoteHref}>
    {story && <ProductStory config={story} entry={entry} />}

    {
      shown.apps && (
        <section class="shell section rule-top" aria-labelledby="aplicaciones-title">
          <SectionIndex index={index.apps!} label="Aplicaciones" />
          <h2 id="aplicaciones-title" class="t-h2">
            ¿Para qué se usa el <span translate="no">{entry.name}</span>?
          </h2>
          <ul class="model-apps">
            {entry.applications.map((item) => (
              <li class="rule-top">{item}</li>
            ))}
          </ul>
          <p class="t-body mt-8">
            ¿No sabe qué modelo necesita?{' '}
            <a href={familyHref(entry.family)} class="link-plain">Compare la familia</a> o cuéntenos su aplicación al
            cotizar.
          </p>
        </section>
      )
    }

    {
      shown.specs && (
        <section class="shell section rule-top" aria-labelledby="ficha-title">
          <SectionIndex index={index.specs!} label="Ficha técnica" />
          <h2 id="ficha-title" class="t-h2">Especificaciones técnicas</h2>
          <dl class="model-specs">
            {entry.specs.map((spec) => (
              <div class="rule-top">
                <dt>{spec.label}</dt>
                <dd class="t-data">{spec.value}</dd>
              </div>
            ))}
          </dl>
          <p class="t-small model-note">
            Especificaciones según el fabricante <span translate="no">{brandName}</span>, verificadas el {verified}. Se
            confirman en la cotización.
          </p>
          <ul class="link-row mt-8">
            {entry.official_pdf_url && (
              <li>
                <ExternalLink href={entry.official_pdf_url} context="ficha técnica del fabricante, PDF" data-track="pdf_download" data-modelo={entry.slug}>
                  Ficha técnica del fabricante (PDF)
                </ExternalLink>
              </li>
            )}
            <li>
              <ExternalLink href={entry.official_url} context="página del modelo en el sitio del fabricante">
                Ver en el sitio del fabricante
              </ExternalLink>
            </li>
            {sources.map((url) => (
              <li>
                <ExternalLink href={url} context="fuente de las cifras">
                  Fuente de las cifras
                </ExternalLink>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      shown.accessories && (
        <section class="shell section rule-top" aria-labelledby="accesorios-title">
          <SectionIndex index={index.accessories!} label="Accesorios" />
          <h2 id="accesorios-title" class="t-h2">Accesorios disponibles</h2>
          <ul class="model-apps">
            {entry.accessories.map((item) => (
              <li class="rule-top">{item}</li>
            ))}
          </ul>
          <p class="t-small model-note">Consulte disponibilidad en la cotización.</p>
        </section>
      )
    }

    {
      shown.faqs && (
        <section class="shell section rule-top" aria-labelledby="preguntas-title">
          <SectionIndex index={index.faqs!} label="Preguntas" />
          <h2 id="preguntas-title" class="t-h2">Preguntas frecuentes</h2>
          <div class="mt-8">
            {faqs.map((faq) => (
              <details class="rule-top model-faq">
                <summary>{faq.q}</summary>
                <p class="t-body">{faq.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <RelatedModels models={related} title="También de la misma familia" index={index.related} />
    <TrustStrip brand={brand} index={index.trust} />
  </ModelHero>

  <ClosingQuoteBand
    index={bandIndex}
    title={`Solicite cotización del ${entry.name}`}
    body="Cuéntenos su muestra, el volumen y su institución. Respondemos con alternativas y condiciones por escrito, y despachamos a todo Chile."
    productName={entry.name}
    brandName={brandName}
    quoteHref={quoteHref}
    modelo={entry.slug}
  />
</Layout>

<style>
  .model-apps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    max-width: 48rem;
  }
  .model-apps li {
    padding-block: 0.875rem;
    color: var(--color-ink-800);
  }
  .model-specs {
    margin: 2rem 0 0;
    max-width: 48rem;
  }
  .model-specs > div {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-block: 0.75rem;
  }
  .model-specs dt {
    color: var(--color-ink-600);
  }
  .model-specs dd {
    margin: 0;
    color: var(--color-ink-950);
  }
  .model-note {
    margin-top: 1.5rem;
    color: var(--color-ink-500);
    max-width: 62ch;
  }
  .model-faq {
    padding-block: 1rem;
  }
  .model-faq summary {
    font-weight: 600;
    cursor: pointer;
  }
  .model-faq p {
    margin-top: 0.75rem;
  }
  @media (min-width: 768px) {
    .model-specs > div {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
  }
</style>

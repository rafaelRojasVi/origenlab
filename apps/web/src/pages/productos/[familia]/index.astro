---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageIntro from '../../../components/ui/PageIntro.astro';
import ClosingQuoteBand from '../../../components/ui/ClosingQuoteBand.astro';
import Icon from '../../../components/ui/Icon.astro';
import FamilyScale from '../../../components/product/FamilyScale.astro';
import FamilyModels from '../../../components/product/FamilyModels.astro';
import FamilyConsult from '../../../components/product/FamilyConsult.astro';
import { publicClaim } from '../../../data/claims';
import { site } from '../../../config/site';
import { getBrandsByFamilyId } from '../../../lib/catalog';
import { byBrandAndName, familyInfo, familyOrder, hasCollectionPages, modelHref, type FamilySlug } from '../../../lib/modelos';
import type { Modelo } from '../../../content.config';

/**
 * Página de familia: una por familia con modelos en la colección, en
 * `/productos/{family}/`. Escala de comparación (si la familia tiene una cifra
 * que ordene sus modelos), tarjetas de modelo, bloque «¿No sabe cuál?» y las
 * marcas que los fabrican. Centrifugación tiene su página propia en
 * `/productos/centrifugas/` y no se genera aquí (ver `lib/modelos.ts`).
 */
export async function getStaticPaths() {
  const all = (await getCollection('modelos')).map((item) => item.data as Modelo);
  const families = [...new Set(all.map((entry) => entry.family))].filter(hasCollectionPages);
  return families.map((slug) => ({
    params: { familia: slug },
    props: { slug, models: familyOrder(all.filter((entry) => entry.family === slug).sort(byBrandAndName), slug) },
  }));
}

const { slug, models } = Astro.props as { slug: FamilySlug; models: Modelo[] };
const family = familyInfo(slug);
const brands = getBrandsByFamilyId(family.scopeId);
const brandNames = brands.map((brand) => brand.name).join(' y ');

const modelsTitle = slug === 'sonicacion' ? 'Elija por volumen de muestra.' : 'Modelos de la familia';
const bandTitle = publicClaim('cotizacion-mismo-dia-habil')
  ? 'Cuéntenos su aplicación. Cotizamos el mismo día hábil.'
  : 'Cuéntenos su aplicación.';

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: family.name,
  itemListElement: models.map((model, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${brands.find((brand) => brand.id === model.brand)?.name ?? model.brand} ${model.name}`,
    url: `${site.baseUrl}${modelHref(model)}`,
  })),
};

const fullDescription = `${family.purpose} Modelos de ${brandNames} con las cifras del fabricante y cotización en Chile a través de OrigenLab.`;
const description =
  fullDescription.length <= 158 ? fullDescription : `${fullDescription.slice(0, 157).replace(/\s+\S*$/, '')}…`;
---

<Layout title={family.name} description={description} jsonLd={[itemList]}>
  <div class="shell">
    <PageIntro
      title={family.short}
      lead={family.purpose}
      crumbs={[{ label: 'Productos', href: '/productos/' }, { label: family.short }]}
    />
    <p class="t-label fam-meta">
      {models.length} modelos{brandNames && <> · <span translate="no">{brandNames}</span></>}
    </p>
    {
      brands.length > 0 && (
        <ul class="link-row fam-brands" aria-label="Quién los fabrica">
          {brands.map((brand) => (
            <li>
              <a href={`/marcas/${brand.slug}/`} class="btn-tertiary">
                <span class="lbl" translate="no">{brand.name}</span>
                <Icon name="arrow-right" size={16} class="arrow" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <FamilyScale models={models} slug={slug} />
  <FamilyModels models={models} title={modelsTitle} />
  <FamilyConsult brandName={brands.length === 1 ? brands[0].name : undefined} />

  <ClosingQuoteBand
    title={bandTitle}
    body="Despacho a todo Chile, puesta en marcha y capacitación con fábrica. También vendemos por Mercado Público."
    brandName={brands.length === 1 ? brands[0].name : undefined}
  />
</Layout>

<style>
  .fam-meta {
    margin-top: 1.5rem;
  }
  .fam-brands {
    margin-top: 0.5rem;
  }
</style>

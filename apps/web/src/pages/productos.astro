---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import ClosingQuoteBand from '../components/ui/ClosingQuoteBand.astro';
import Notice from '../components/ui/Notice.astro';
import Icon from '../components/ui/Icon.astro';
import ApplicationList from '../components/ui/ApplicationList.astro';
import FamilyModels from '../components/product/FamilyModels.astro';
import { familiesInProductOrder } from '../data/equipmentScope';
import { company } from '../data/company';
import { getBrandsByFamilyId } from '../lib/catalog';
import { rankFamilies } from '../lib/ranking';
import { familyForScope, familyHref, familyInfo, familyTint } from '../lib/modelos';
import type { Modelo } from '../content.config';

/**
 * Productos: todas las familias con TODOS sus modelos a la vista (regla del
 * dueño, 2026-11-08): cada equipo es una tarjeta iluminada que lleva directo a
 * su ficha, sin pasar por la familia ni por la marca. Las familias van en el
 * orden comercial (`rankFamilies`) y los modelos también (`rankModels`, dentro
 * de `FamilyModels`): 3D primero, IKA al final.
 *
 * Arriba, un índice de saltos a cada familia en esta misma página (con su
 * tinte); cada familia enlaza además su propia página (SEO, comparativa).
 * Los modelos salen de la colección `modelos`, la misma de las fichas.
 */
const all = (await getCollection('modelos')).map((item) => item.data as Modelo);
const families = rankFamilies(
  familiesInProductOrder().flatMap((scope) => {
    const slug = familyForScope(scope.id);
    if (!slug) return [];
    const models = all.filter((entry) => entry.family === slug);
    if (models.length === 0) return [];
    return [{ scope, slug, info: familyInfo(slug), href: familyHref(slug), models, brands: getBrandsByFamilyId(scope.id) }];
  }),
  (family) => family.href.split('/')[2] ?? '',
);
---

<Layout
  title="Productos"
  description="Equipos de laboratorio por familia: sonicación, pesaje y humedad, centrifugación, osmometría, electroforesis y dispersión. Cada modelo con su ficha y cotización."
>
  <div class="shell">
    <PageIntro
      title="Productos"
      lead="Todos los equipos que cotizamos, por familia. Toque uno y llega directo a su ficha, con las cifras del fabricante y el botón para cotizar."
      crumbs={[{ label: 'Productos' }]}
    />
    <nav class="pf-jump" aria-label="Ir a una familia">
      <ul>
        {
          families.map(({ scope, info, models }) => (
            <li>
              <a href={`#${scope.id}`} style={`--t: ${familyTint(models[0])}`}>
                {info.short}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  {
    families.map(({ scope, info, href, models, brands }, i) => (
      <section id={scope.id} class="shell pf" aria-labelledby={`${scope.id}-title`}>
        <div class="pf__head">
          <div>
            <h2 id={`${scope.id}-title`} class="pf__name">
              {info.short}
              <span class="dot">.</span>
            </h2>
            <p class="pf__purpose">{scope.purpose}</p>
          </div>
          <p class="pf__links">
            <a href={href} class="link-arrow pf__fam">
              Ver la familia y compararlos
              <Icon name="arrow-right" size={18} class="arrow" />
            </a>
            <span class="pf__brands" translate="no">
              {brands.map((brand, j) => (
                <>
                  {j > 0 && ', '}
                  <a href={`/marcas/${brand.slug}/`}>{brand.name}</a>
                </>
              ))}
            </span>
          </p>
        </div>
        <FamilyModels models={models} eager={i === 0 ? 4 : 0} label={`Modelos de ${info.short.toLowerCase()}`} />
      </section>
    ))
  }

  <section class="shell pf pf--tipos" aria-labelledby="tipos-title">
    <h2 id="tipos-title" class="t-h2">Si prefiere partir del tipo de laboratorio<span class="dot">.</span></h2>
    <ApplicationList class="mt-10" />
    <Notice class="mt-10">
      {company.catalogNote} Cotización y disponibilidad sujetas a confirmación comercial. Los datos de
      cada ficha se redactaron desde la documentación pública del fabricante, enlazada en la ficha.
    </Notice>
  </section>

  <ClosingQuoteBand
    title="¿Busca un equipo que no está aquí?"
    body="Cotizamos según aplicación, capacidad y requisitos técnicos. Indique qué necesita hacer en el laboratorio y desde dónde escribe."
  />
</Layout>

<style>
  .pf-jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .pf-jump a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: var(--radius-btn);
    background: var(--t);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink-950);
    transition: box-shadow var(--ease-ui), transform var(--ease-ui);
  }
  .pf-jump a:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-1px);
  }
  .pf {
    padding-block: 3.5rem;
    scroll-margin-top: 4.5rem;
  }
  .pf + .pf {
    border-top: 1px solid var(--color-hairline);
  }
  .pf__head {
    display: grid;
    gap: 1rem 3rem;
    margin-bottom: 2rem;
  }
  .pf__name {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--color-ink-950);
  }
  .pf__purpose {
    margin-top: 0.875rem;
    max-width: 60ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink-600);
  }
  .pf__links {
    display: grid;
    gap: 0.25rem;
    align-content: end;
    justify-items: start;
  }
  .pf__fam {
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-teal-800);
  }
  .pf__brands {
    font-size: 0.9375rem;
    color: var(--color-ink-500);
  }
  .pf__brands a {
    color: var(--color-ink-600);
  }
  .pf__brands a:hover {
    color: var(--color-teal-800);
    text-decoration: underline;
  }
  @media (min-width: 1024px) {
    .pf {
      padding-block: 5rem;
    }
    .pf__head {
      grid-template-columns: minmax(0, 1fr) auto;
      margin-bottom: 2.75rem;
    }
    .pf__links {
      justify-items: end;
      text-align: right;
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import SectionIndex from '../components/ui/SectionIndex.astro';
import ModelRow from '../components/ui/ModelRow.astro';
import ClosingQuoteBand from '../components/ui/ClosingQuoteBand.astro';
import ProductFigure from '../components/ui/ProductFigure.astro';
import BrandLogo from '../components/ui/BrandLogo.astro';
import Notice from '../components/ui/Notice.astro';
import Icon from '../components/ui/Icon.astro';
import { productFamilies } from '../data/productFamilies';
import { categories } from '../data/categories';
import { company } from '../data/company';
import {
  getBrandById,
  getBrandBySlug,
  getOrtoalresaCentrifuges,
  getProductBySlug,
  getProductsByBrandId,
} from '../lib/catalog';

const family = productFamilies[0];
const centrifuges = getOrtoalresaCentrifuges();
const ortoalresa = getBrandById('ortoalresa');
const serva = getBrandBySlug('serva-electrophoresis');
const servaProducts = serva ? getProductsByBrandId(serva.id) : [];
const familyCover = getProductBySlug('digicen-22-r');
---

<Layout
  title="Productos"
  description="Centrífugas Ortoalresa y reactivos SERVA disponibles para cotización a través de OrigenLab, con asesoría técnica y atención en todo Chile."
>
  <div class="shell">
    <PageIntro
      title="Productos"
      lead="Catálogo publicado: una familia de equipos y una línea de reactivos. Fuera de catálogo cotizamos según la aplicación de su laboratorio."
      crumbs={[{ label: 'Productos' }]}
    />
  </div>

  <section class="shell section rule-top" aria-labelledby="familias-title">
    <SectionIndex index={1} label="Familias de equipos" />

    <div class="family">
      <div class="family__media">
        {familyCover && <ProductFigure product={familyCover} sizes="(min-width: 1024px) 400px, 60vw" />}
      </div>
      <div class="family__body">
        {ortoalresa && <BrandLogo brand={ortoalresa} scale={1.1} class="family__logo" />}
        <h2 id="familias-title" class="t-h2 family__title">{family.name}</h2>
        <p class="t-body family__desc">{family.description}</p>
        <p class="t-small family__meta">
          {centrifuges.length} modelos de catálogo, marca {ortoalresa?.name}.
        </p>
        <a href={`/productos/${family.slug}/`} class="btn btn-secondary family__cta">
          Ver la familia
        </a>
      </div>
    </div>

    <ul class="model-list">
      {centrifuges.map((product) => <ModelRow product={product} size="compact" />)}
    </ul>
  </section>

  {
    serva && servaProducts.length > 0 && (
      <section class="shell section rule-top" aria-labelledby="reactivos-title">
        <SectionIndex index={2} label="Reactivos e insumos" />
        <div class="sku-head">
          <div>
            <h2 id="reactivos-title" class="t-h2">SERVA Electrophoresis</h2>
            <p class="t-body sku-head__desc">{serva.summary}</p>
          </div>
          <BrandLogo brand={serva} scale={1.2} />
        </div>

        <dl class="sku-list">
          {servaProducts.map((product) => (
            <div class="sku">
              <dt>
                <span class="sku__name" translate="no">{product.name}</span>
                {product.sku && <span class="sku__code t-data">Ítem {product.sku}</span>}
              </dt>
              <dd class="t-small sku__desc">{product.summary}</dd>
            </div>
          ))}
        </dl>

        <a href={`/marcas/${serva.slug}/`} class="link-arrow mt-8">
          Condiciones y áreas de aplicación SERVA
          <Icon name="arrow-right" size={18} class="arrow" />
        </a>
      </section>
    )
  }

  <section class="shell section rule-top" aria-labelledby="por-aplicacion-title">
    <SectionIndex index={3} label="Por aplicación" />
    <h2 id="por-aplicacion-title" class="t-h2">Si no sabe qué equipo pedir</h2>
    <p class="t-lead mt-5">
      Describa el ensayo, el volumen de trabajo o la norma que maneja. Cotizamos equipamiento
      alineado a ese entorno aunque no esté publicado en el catálogo.
    </p>
    <ul class="app-links">
      {
        categories.map((category) => (
          <li>
            <a href={`/categorias/${category.slug}/`} class="link-arrow">
              {category.name}
              <Icon name="arrow-right" size={18} class="arrow" />
            </a>
          </li>
        ))
      }
    </ul>
    <Notice class="mt-10">
      {company.catalogNote} Cotización y disponibilidad sujetas a confirmación comercial.
    </Notice>
  </section>

  <ClosingQuoteBand
    index={4}
    title="¿Busca un equipo que no está en el catálogo?"
    body="Cotizamos según aplicación, capacidad y requisitos técnicos. Indique qué necesita hacer en el laboratorio y desde dónde escribe."
  />
</Layout>

<style>
  .family {
    display: grid;
    gap: 2rem;
    padding-bottom: 3rem;
  }
  .family__media {
    max-width: 17rem;
  }
  .family__logo {
    margin-bottom: 1.5rem;
  }
  .family__desc {
    margin-top: 1rem;
  }
  .family__meta {
    margin-top: 1rem;
    color: var(--color-ink-500);
    font-family: var(--font-mono);
  }
  .family__cta {
    margin-top: 2rem;
  }
  .model-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-ink-950);
  }

  .sku-head {
    display: grid;
    gap: 1.75rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }
  .sku-head__desc {
    margin-top: 1rem;
  }
  .sku-list {
    margin: 0;
    border-top: 1px solid var(--color-ink-950);
  }
  .sku {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .sku dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
  }
  .sku__name {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink-950);
  }
  .sku__code {
    font-size: 0.8125rem;
    color: var(--color-ink-500);
  }
  .sku__desc {
    margin: 0.5rem 0 0;
    color: var(--color-ink-600);
    max-width: 62ch;
  }

  .app-links {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .family {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: 3.5rem;
      padding-bottom: 4rem;
    }
    .family__media {
      max-width: none;
    }
    .sku-head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
    .app-links {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 2.5rem;
    }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import FamilyModels from '../../components/product/FamilyModels.astro';
import ClosingQuoteBand from '../../components/ui/ClosingQuoteBand.astro';
import Icon from '../../components/ui/Icon.astro';
import { categories } from '../../data/categories';
import { company } from '../../data/company';
import { documentsForCategory } from '../../data/documents';
import { getCategoryRelatedProducts } from '../../lib/catalog';
import { getCollection } from 'astro:content';
import type { Modelo } from '../../content.config';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug } }));
}

const { slug } = Astro.params;
const category = categories.find((item) => item.slug === slug);
if (!category) return Astro.redirect('/aplicaciones');

// Los equipos relacionados son fichas heredadas (`products.ts`); la tarjeta sale
// de la colección `modelos`, que usa el mismo id como slug.
const relatedIds = new Set(getCategoryRelatedProducts(category.slug).map((product) => product.id));
const related = (await getCollection('modelos')).map((item) => item.data as Modelo).filter((entry) => relatedIds.has(entry.slug));
const documents = documentsForCategory(category.slug);
const isClinical = category.slug === 'laboratorio-clinico';
const shortName = category.shortName;

const metaDescription =
  `${category.description ?? ''} Cotización y asesoría técnica a través de OrigenLab, con atención en todo Chile.`.slice(
    0,
    158,
  );
---

<Layout title={shortName} description={metaDescription}>
  <div class="shell">
    <PageIntro
      title={category.name}
      lead={category.description}
      crumbs={[{ label: 'Aplicaciones', href: '/aplicaciones/' }, { label: shortName }]}
    />
  </div>

  <section class="shell section rule-top" aria-labelledby="antes-title">
    <div class="guide">
      <div>
        <h2 id="antes-title" class="t-h2">Qué conviene traer a la conversación<span class="dot">.</span></h2>
        <p class="t-body guide__text">{category.buyerGuide}</p>
      </div>
      <ol class="checklist">
        {category.buyerBullets.map((bullet) => <li>{bullet}</li>)}
      </ol>
    </div>
  </section>

  <section class="shell section rule-top" aria-labelledby="equipos-title">
    {
      related.length > 0 ? (
        <>
          <h2 id="equipos-title" class="t-h2">Centrífugas Ortoalresa<span class="dot">.</span></h2>
          <p class="lede mt-4">
            Preparación de muestras y separación, según configuración de rotor y requerimientos del
            laboratorio.
          </p>
          <FamilyModels models={related} class="mt-10" label="Centrífugas para esta aplicación" />
          <a href="/productos/centrifugas/" class="link-arrow mt-8">
            Ver la familia y la comparativa
            <Icon name="arrow-right" size={18} class="arrow" />
          </a>
        </>
      ) : (
        <>
          <h2 id="equipos-title" class="t-h2">Por aplicación, no por listado<span class="dot">.</span></h2>
          <p class="lede mt-4">
            Para esta línea no publicamos un listado cerrado. Indique el ensayo, el volumen de trabajo
            y la norma asociada si aplica, y le respondemos con alternativas concretas del catálogo.
          </p>
          {isClinical && (
            <p class="t-body clinical">
              Algunos modelos de centrífugas pueden evaluarse para preparación de muestras en
              laboratorio clínico según configuración y requerimientos. Esto no implica
              certificación clínica ni idoneidad diagnóstica sin confirmación del responsable
              técnico y del fabricante.
            </p>
          )}
          <a href="/productos/" class="link-arrow mt-8">
            Ver todos los equipos
            <Icon name="arrow-right" size={18} class="arrow" />
          </a>
        </>
      )
    }
  </section>

  <section class="shell section rule-top" aria-labelledby="documentacion-title">
    <h2 id="documentacion-title" class="t-h2">Catálogos y fichas técnicas<span class="dot">.</span></h2>
    {
      documents.length > 0 ? (
        <ul class="doc-list">
          {documents.map((document) => (
            <li>
              <a href={document.fileUrl} class="link-arrow">
                <Icon name="file" size={18} />
                {document.title}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="t-lead mt-5">{company.catalogNote}</p>
      )
    }
  </section>

  <ClosingQuoteBand
    title={`Cotizar equipamiento para ${shortName.toLowerCase()}`}
    body="Indique el ensayo o la función que necesita cubrir, el volumen de trabajo y su institución. Con eso acotamos alternativas y preparamos la cotización."
  />
</Layout>

<style>
  .guide {
    display: grid;
    gap: 2.5rem;
  }
  .guide__text {
    margin-top: 1.25rem;
  }
  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: item;
    border-top: 1px solid var(--color-hairline-strong);
  }
  .checklist li {
    counter-increment: item;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-800);
    border-bottom: 1px solid var(--color-hairline);
  }
  .checklist li::before {
    content: counter(item, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-teal-800);
  }
  .clinical {
    margin-top: 1.75rem;
    color: var(--color-ink-600);
  }
  .doc-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .guide {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 4rem;
      align-items: start;
    }
  }
</style>

---
import Button from '../ui/Button.astro';
import ModelPhoto from '../ui/ModelPhoto.astro';
import Showroom from '../home/Showroom.astro';
import ModelHeroCopy from './ModelHeroCopy.astro';
import { ctaLabels } from '../../lib/ctaLabels';
import { buildWhatsAppQuoteUrl } from '../../lib/whatsapp';
import { imageForEntry, type FamilyInfo } from '../../lib/modelos';
import type { Brand } from '../../data/brands';
import type { Modelo } from '../../content.config';

/**
 * Marco de la página de modelo: primera pantalla, el resto en el slot y la
 * barra fija de cotización.
 *
 * `media` decide qué acompaña al texto de la primera pantalla (`ModelHeroCopy`):
 *   `story`    nada aquí: la página monta `ProductStory` en el slot y le pasa el
 *              texto en su slot `intro`; el escenario 3D es la primera pantalla
 *   `showroom` la sala 3D del equipo (`home/Showroom`), sin historia
 *   `photo`    la fotografía VERIFIED del registro
 * En los tres casos el bloque de entrada lleva `data-first-screen`.
 *
 * La barra fija (`[data-sticky-cta]`) está al final del slot, `position: sticky`
 * al pie. Con JavaScript queda escondida (`inert`, fuera de la pantalla) hasta
 * que `[data-first-screen]` sale de cuadro, y vuelve a esconderse si regresa;
 * sin JavaScript se ve como siempre.
 */
interface Props {
  entry: Modelo;
  brand: Brand | undefined;
  family: FamilyInfo;
  media: 'story' | 'showroom' | 'photo';
  quoteHref: string;
}

const { entry, brand, family, media, quoteHref } = Astro.props;
const brandName = brand?.name ?? entry.brand;
const whatsappHref = buildWhatsAppQuoteUrl({ productName: entry.name, brandName });
const photo = imageForEntry(entry);
---

<div class="model-page">
  {
    media !== 'story' && (
      <section class="shell mh-sec" data-first-screen aria-labelledby="modelo-titulo">
        <ModelHeroCopy entry={entry} brand={brand} family={family} quoteHref={quoteHref} />
        <div class="mh-sec__media">
          {media === 'showroom' && entry.showroom_id && <Showroom id={entry.showroom_id} />}
          {media === 'photo' && <ModelPhoto image={photo} brandName={brandName} size="hero" priority captioned ratio="4 / 5" />}
        </div>
      </section>
    )
  }

  <slot />

  <aside class="cta-bar" data-sticky-cta aria-label={`Cotizar ${entry.name}`}>
    <div class="shell cta-bar__inner">
      <p class="cta-bar__name" translate="no">
        <b>{entry.name}</b>
        <span class="t-label">{brandName} · {family.short}</span>
      </p>
      <div class="cta-bar__act">
        <Button href={quoteHref} size="sm" track="cotizacion_click" modelo={entry.slug}>{ctaLabels.solicitarCotizacion}</Button>
        <Button href={whatsappHref} size="sm" variant="whatsapp" external class="cta-bar__wa" track="whatsapp_click" modelo={entry.slug}>
          <span class="cta-bar__wa-t">{ctaLabels.whatsappCorto}</span>
        </Button>
      </div>
    </div>
  </aside>
</div>

<script>
  /**
   * Medición propia (`lib/stats.ts`): un solo escucha de clics para toda la
   * página de modelo: los botones de la primera pantalla, los de la barra fija,
   * los de la banda de cierre (`ClosingQuoteBand`) y los enlaces a la ficha del
   * fabricante. Después, la barra fija: aparece cuando la primera pantalla sale
   * de cuadro.
   */
  import { installTrackClicks } from '../../lib/stats';

  installTrackClicks();

  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const first = document.querySelector('[data-first-screen]');
  if (bar && first && 'IntersectionObserver' in window) {
    const hide = (hidden: boolean) => {
      bar.inert = hidden;
      bar.toggleAttribute('data-hidden', hidden);
    };
    hide(true);
    document.documentElement.dataset.barReady = '';
    new IntersectionObserver(([entry]) => hide(entry.isIntersecting)).observe(first);
  }
</script>

<style is:global>
  .model-page {
    --hd-h: 56px;
  }
  @media (min-width: 1024px) {
    .model-page {
      --hd-h: 72px;
    }
  }
  /* Secciones de la página de modelo (las dos páginas que usan este marco): aire, franja alterna y titular. */
  .model-page .msec {
    padding-block: clamp(5rem, 9vw, 7rem);
  }
  .model-page .msec--alt {
    background: var(--color-surface);
    border-block: 1px solid var(--color-hairline);
  }
  .model-page .mh2 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .mh-sec {
    display: grid;
    gap: 2rem;
    min-height: calc(100svh - var(--hd-h));
  }
  .mh-sec__media {
    align-self: center;
    max-width: 32rem;
  }
  @media (min-width: 760px) {
    .mh-sec {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 3rem;
    }
    .mh-sec__media {
      max-width: none;
      padding-block: 2rem;
    }
  }

  .cta-bar {
    position: sticky;
    bottom: 0;
    z-index: 20;
    background-color: var(--color-paper);
    border-top: 1px solid var(--color-hairline);
    box-shadow: 0 -8px 24px rgb(20 22 23 / 0.06);
  }
  .cta-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.5rem;
  }
  .cta-bar__name {
    display: none;
    align-items: baseline;
    gap: 0.875rem;
    min-width: 0;
  }
  .cta-bar__name b {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink-950);
  }
  .cta-bar__act {
    display: flex;
    gap: 0.625rem;
    flex: 1;
    justify-content: flex-end;
  }
  .cta-bar__act > .btn-primary {
    flex: 1 1 auto;
  }
  /* Con JavaScript la barra espera fuera de pantalla hasta salir de la primera. */
  html[data-bar-ready] .cta-bar[data-hidden] {
    transform: translateY(100%);
    box-shadow: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    html[data-bar-ready] .cta-bar {
      transition: transform 200ms ease-out;
    }
  }
  /* Lo enfocado con el teclado no queda escondido detrás de la barra. */
  :root:has([data-sticky-cta]) {
    scroll-padding-bottom: 5rem;
  }
  @media (max-width: 639.98px) {
    .cta-bar__act > .cta-bar__wa {
      width: var(--btn-h-sm);
      padding: 0;
    }
    .cta-bar__wa-t {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (min-width: 640px) {
    .cta-bar__name {
      display: flex;
    }
    .cta-bar__act {
      flex: none;
    }
    .cta-bar__act > .btn-primary {
      flex: none;
    }
  }
</style>

---
import { publicClaim } from '../../data/claims';

/**
 * Franja «Cómo trabajamos» de la página de modelo: las afirmaciones aprobadas
 * del registro (`claims.ts`), una por columna, con filete de tinta y numeral
 * mono, sin texto de apoyo. Una afirmación sin aprobar no se dibuja; sin
 * ninguna, la franja entera se omite. «Pago», «garantía» y el pilar de
 * distribuidor no están aquí: no son afirmaciones aprobadas.
 *
 * `index` se acepta por compatibilidad con las páginas que aún lo pasan; la
 * franja ya no lleva índice de sección.
 */
interface Props {
  index?: number;
}

const items = ['directo-con-el-fabricante', 'cotizacion-mismo-dia-habil', 'despacho-todo-chile', 'puesta-en-marcha-con-fabrica']
  .map(publicClaim)
  .filter((text): text is string => Boolean(text));
---

{
  items.length > 0 && (
    <section class="msec msec--alt" aria-labelledby="confianza-title">
      <div class="shell rv">
        <h2 id="confianza-title" class="t-label">Cómo trabajamos</h2>
        <ul class="trust">
          {items.map((text, i) => (
            <li>
              <span class="t-label">{String(i + 1).padStart(2, '0')}</span>
              <b>{text}</b>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style is:global>
  .trust {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .trust li {
    flex: 1 1 9.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-top: 1rem;
    border-top: 2px solid var(--color-ink-950);
  }
  .trust b {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-ink-950);
  }
  @media (max-width: 639.98px) {
    .trust li {
      flex-basis: 44%;
    }
  }
</style>

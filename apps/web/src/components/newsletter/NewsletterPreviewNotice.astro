---
import { isPreviewOnly, pendingNewsletterGates } from '../../data/newsletter';

/**
 * Marca de vista previa.
 *
 * Una compilación de revisión que se parezca a producción es exactamente el
 * error que las puertas de activación existen para evitar. Si el formulario se
 * dibuja porque alguien pidió la vista previa, la página lo dice y enumera lo
 * que falta. En producción esta marca no existe, porque `isPreviewOnly()` es
 * falsa cuando las ocho puertas están abiertas.
 */
const preview = isPreviewOnly();
const pending = preview ? pendingNewsletterGates() : [];
---

{
  preview && (
    <div class="preview" role="note" aria-label="Estado de la función">
      <p class="t-label preview__tag">Vista previa, no publicado</p>
      <p class="preview__body">
        Este formulario no está activo. Se dibuja sólo en una compilación de revisión para poder
        verlo y probarlo. No hay endpoint desplegado, no hay base de datos y no se envía ningún
        correo: un envío desde aquí falla y lo dice.
      </p>
      <ul class="preview__list">
        {pending.map((gate) => (
          <li>
            <span class="preview__owner">{gate.owner}</span>
            {gate.label}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .preview {
    margin-top: 1rem;
    padding: 1.5rem;
    background-color: var(--color-surface);
    border-left: 2px solid var(--color-family-pesaje);
  }
  .preview__tag {
    color: var(--color-family-pesaje);
  }
  .preview__body {
    margin-top: 0.75rem;
    line-height: 1.6;
    color: var(--color-ink-800);
    max-width: 66ch;
  }
  .preview__list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-ink-600);
  }
  .preview__owner {
    display: inline-block;
    min-width: 9rem;
    margin-right: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-500);
  }
  @media (min-width: 768px) {
    .preview {
      padding: 2rem;
    }
  }
</style>

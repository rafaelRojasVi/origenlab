---
import { site } from '../config/site';
import { contact } from '../data/contact';
import { APPROVED_BRAND_IDS } from '../data/brands';
import { equipmentScope } from '../data/equipmentScope';
import { legalRoutes } from '../data/legal';
import { getBrandById } from '../lib/catalog';
import { familyForScope, familyHref, familyInfo } from '../lib/modelos';
import { buildWhatsAppQuoteUrl } from '../lib/whatsapp';
import SiteLogo from './SiteLogo.astro';

/**
 * Pie en grafito (`surface`, un tono sobre el fondo de página; tablero HomeA): marca, las seis familias, las siete marcas en
 * el orden de la lista cerrada, la empresa y el contacto, y una fila legal.
 * Las marcas se enlazan todas: la regla de la portada que oculta una marca del
 * riel no alcanza al pie.
 *
 * LinkedIn sólo se dibuja cuando `site.linkedinUrl` tiene valor: hoy está vacío
 * y el enlace no existe.
 */
const year = new Date().getFullYear();
const whatsappHref = buildWhatsAppQuoteUrl();

const families = equipmentScope.flatMap((scope) => {
  const slug = familyForScope(scope.id);
  return slug ? [{ name: familyInfo(slug).short, href: familyHref(slug) }] : [];
});
const brandLinks = APPROVED_BRAND_IDS.flatMap((id) => {
  const brand = getBrandById(id);
  return brand ? [{ name: brand.name, href: `/marcas/${brand.slug}/` }] : [];
});
---

<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo" aria-label="OrigenLab, ir al inicio">
          <SiteLogo size={28} />
        </a>
        <p>Equipos de laboratorio para todo Chile. Trabajamos directo con el fabricante.</p>
      </div>

      <nav aria-label="Familias">
        <h2 class="t-label site-footer__heading">Familias</h2>
        <ul>
          {families.map((family) => <li><a href={family.href}>{family.name}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Marcas">
        <h2 class="t-label site-footer__heading">Marcas</h2>
        <ul>
          {brandLinks.map((brand) => <li><a href={brand.href}>{brand.name}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Empresa">
        <h2 class="t-label site-footer__heading">Empresa</h2>
        <ul>
          <li><a href="/como-comprar/">Cómo comprar</a></li>
          <li><a href="/servicios/">Servicios</a></li>
          <li><a href="/nosotros/">Nosotros</a></li>
          <li><a href="/aplicaciones/">Aplicaciones</a></li>
        </ul>
      </nav>

      <nav aria-label="Contacto">
        <h2 class="t-label site-footer__heading">Contacto</h2>
        <ul>
          <li><a href="/contacto/">Contacto</a></li>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li>
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
              WhatsApp
              <span class="sr-only">(abre WhatsApp en una pestaña nueva)</span>
            </a>
          </li>
          <li><a href="/como-comprar/#compras-publicas">Mercado Público</a></li>
          {
            site.linkedinUrl && (
              <li>
                <a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer">
                  LinkedIn
                  <span class="sr-only">(abre una pestaña nueva)</span>
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </div>

    <!--
      Fila legal. Las tres rutas se enlazan sin distintivo: son páginas breves
      que dicen lo que OrigenLab hace de verdad. Se sirven sin indexar mientras
      `legal.ts` no registre una revisión profesional, y eso es una decisión de
      publicación, no un mensaje para el visitante. El seguimiento interno vive
      en docs/design/CONTENT_NEEDED.md.
    -->
    <div class="site-footer__legal t-data">
      <span>&copy; {year} {site.name}</span>
      <nav aria-label="Información legal">
        <ul>
          {legalRoutes.map((route) => <li><a href={route.href}>{route.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-hairline);
    padding: 88px 0 40px;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }
  .site-footer__brand {
    grid-column: 1 / -1;
  }
  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border-radius: var(--radius-edge);
  }
  .site-footer__brand p {
    margin-top: 1rem;
    max-width: 22em;
    color: var(--color-ink-600);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .site-footer__heading {
    margin-bottom: 0.75rem;
    color: var(--color-ink-500);
  }
  .site-footer ul {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer li a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    min-width: 2.75rem;
    @media (width < 1024px) {
      min-height: 2.75rem;
    }
    color: var(--color-ink-800);
    font-size: 0.9375rem;
    transition: color var(--ease-ui);
    &:hover {
      color: var(--color-teal-700);
    }
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 4.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-hairline);
    color: var(--color-ink-500);
    font-size: 0.8125rem;
  }
  .site-footer .site-footer__legal ul {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }
  .site-footer .site-footer__legal li a {
    color: var(--color-ink-500);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    @media (width < 1024px) {
      min-height: 2.75rem;
    }
  }
  .site-footer .site-footer__legal li a:hover {
    color: var(--color-ink-950);
  }
  .site-footer__legal > span {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
  }
  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
      gap: 2rem;
    }
    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>

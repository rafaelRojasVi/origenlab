---
import { site } from '../config/site';
import { ctaLabels } from '../lib/ctaLabels';
import { buildWhatsAppQuoteUrl } from '../lib/whatsapp';
import SiteLogo from './SiteLogo.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';

/**
 * Cabecera fija. 72 px arriba, 56 px con scroll (sólo CSS donde existe
 * `animation-timeline: scroll()`; si no, un observador alterna `data-scrolled`).
 * `tone="ink"` la pinta de tinta para la portada.
 */
interface Props {
  tone?: 'paper' | 'ink';
}

const { tone = 'paper' } = Astro.props;
const path = Astro.url.pathname;
const whatsappUrl = buildWhatsAppQuoteUrl();

/** Las rutas de `site.nav` llevan barra final, igual que `Astro.url.pathname`. */
function isActive(href: string, matches?: readonly string[]): boolean {
  const prefixes = [href, ...(matches ?? [])];
  return prefixes.some((prefix) => path === prefix || path.startsWith(prefix));
}
---

<header class:list={['site-header', tone === 'ink' && 'on-ink']}>
  <div class="site-header__bar">
    <a href="/" class="site-header__home" aria-label="OrigenLab, ir al inicio">
      <SiteLogo motion tone={tone === 'ink' ? 'paper' : 'ink'} />
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href, item.matches) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button
        href={site.quoteHref}
        size="sm"
        class="site-header__cta"
        aria-label={ctaLabels.solicitarCotizacion}
      >
        <span class="site-header__cta-long">{ctaLabels.solicitarCotizacion}</span>
        <span class="site-header__cta-short">{ctaLabels.cotizar}</span>
      </Button>
      <Button
        href={whatsappUrl}
        variant="icon"
        size="sm"
        label={ctaLabels.escribirWhatsapp}
        external
        track="whatsapp_click"
        class="site-header__wa"
      >
        <Icon name="whatsapp" size={18} />
      </Button>
      <button
        type="button"
        class="btn btn-icon site-menu__btn"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Menú de navegación"
        data-menu-toggle
      >
        <span class="site-menu__open"><Icon name="menu" size={22} /></span>
        <span class="site-menu__close"><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>

  <div class="site-menu__panel on-ink" id="site-menu" data-menu-panel hidden>
    <nav aria-label="Navegación">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href, item.matches) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-menu__actions">
      <Button href={site.quoteHref}>{ctaLabels.solicitarCotizacion}</Button>
      <Button href={whatsappUrl} variant="whatsapp" external track="whatsapp_click">
        {ctaLabels.escribirWhatsapp}
      </Button>
    </div>
  </div>
</header>

<script>
  /* Menú móvil: botón con aria-expanded. Escape y el clic fuera lo cierran y el
     foco vuelve al botón, que es lo que espera quien navega con teclado. */
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  if (toggle && panel) {
    const set = (open: boolean, focus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (focus) toggle.focus();
    };
    toggle.addEventListener('click', () => set(panel.hidden));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && !panel.hidden && set(false, true));
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!panel.hidden && !toggle.contains(t) && !panel.contains(t)) set(false);
    });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && set(false));
  }

  /* Sin `animation-timeline: scroll()` (o con movimiento reducido, donde esa
     animación no se declara) un centinela de 1 px alterna `data-scrolled`. */
  const header = document.querySelector('.site-header');
  const sentinel = document.querySelector('[data-hd-sentinel]');
  if (
    header &&
    sentinel &&
    (!CSS.supports('animation-timeline: scroll()') || matchMedia('(prefers-reduced-motion: reduce)').matches)
  ) {
    new IntersectionObserver(([e]) => header.toggleAttribute('data-scrolled', !e.isIntersecting)).observe(sentinel);
  }

  /* La marca se repite al pasar el cursor. `pointerenter` y no `:hover`: así los
     1,2 s llegan al final aunque el puntero salga. */
  const logo = document.querySelector('[data-logo-motion]');
  logo?.addEventListener('pointerenter', () => {
    logo.classList.remove('is-playing');
    void logo.getBoundingClientRect();
    logo.classList.add('is-playing');
  });
</script>

<style is:global>
  @property --mk-k {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .site-header {
    --hd-h: 56px;
    --m: 24px; /* marca: 24 px, trazo ×1,25 y cuerpos ×1,12 (bajo 1024 px y con scroll) */
    --sw: 4.5;
    --k: 1.12;
    --nav: var(--color-ink-600);
    --nav-on: var(--color-ink-950);
    --hd-line: var(--color-hairline);
    --hd-glow: rgb(20 22 23 / 0.18);
    --hd-shadow: 0 1px 0 var(--hd-line), 0 10px 24px -14px var(--hd-glow);
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--hd-h);
    background-color: var(--color-paper);
    border-bottom: 1px solid var(--hd-line);
  }
  .site-header.on-ink {
    --nav: var(--color-onink-300);
    --nav-on: var(--color-onink-100);
    --hd-line: var(--color-onink-hairline);
    --hd-glow: rgb(0 0 0 / 0.5);
    background-color: var(--color-ink-950);
  }
  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 0.75rem;
    height: 100%;
    padding-inline: 1rem;
  }
  .site-header__home {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-edge);
  }

  .site-header .origen-mark {
    width: var(--m);
    height: var(--m);
    stroke-width: var(--sw);
    --mk-k: var(--k);
    overflow: visible;
  }
  /* --- Navegación (escritorio) --- */
  .site-header__nav {
    display: none;
  }
  .site-header__nav ul {
    display: flex;
  }
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.625rem;
    border-radius: var(--radius-edge);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: var(--nav);
    transition: color 150ms;
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--nav-on);
  }
  .site-header__nav a[aria-current='page'] {
    font-weight: 600;
  }

  /* --- Acciones --- */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-header__cta-long,
  .site-header .site-header__wa {
    display: none;
  }
  .site-menu__btn.btn {
    width: 2.75rem;
    height: 2.75rem;
  }
  .site-menu__close,
  .site-menu__btn[aria-expanded='true'] .site-menu__open {
    display: none;
  }
  .site-menu__btn[aria-expanded='true'] .site-menu__close {
    display: block;
  }

  /* --- Panel del menú móvil --- */
  .site-menu__panel {
    position: fixed;
    inset: var(--hd-h) 0 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1rem 1.25rem calc(2rem + env(safe-area-inset-bottom, 0px));
    background-color: var(--color-ink-950);
    border-top: 1px solid var(--color-onink-hairline);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .site-menu__panel[hidden] {
    display: none;
  }
  .site-menu__panel li + li {
    border-top: 1px solid var(--color-onink-hairline);
  }
  .site-menu__panel nav a {
    display: flex;
    align-items: center;
    min-height: 4rem;
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 2.125rem;
    letter-spacing: -0.015em;
    color: var(--color-onink-100);
  }
  .site-menu__panel nav a[aria-current='page'] {
    color: var(--color-teal-500);
  }
  .site-menu__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* --- Estado con scroll: 56 px, sin borde, sombra hairline --- */
  .site-header[data-scrolled] {
    --m: 24px;
    --sw: 4.5;
    --k: 1.12;
    height: 56px;
    border-bottom-color: transparent;
    box-shadow: var(--hd-shadow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports not (animation-timeline: scroll()) {
      .site-header,
      .site-header .origen-mark {
        transition: all 200ms ease-out;
      }
    }
    @supports (animation-timeline: scroll()) {
      .site-header,
      .site-header .origen-mark {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 120px;
      }
      .site-header {
        animation-name: hd-shrink;
      }
      .site-header .origen-mark {
        animation-name: mark-shrink;
      }
    }
    @keyframes hd-shrink {
      to {
        height: 56px;
        border-bottom-color: transparent;
        box-shadow: var(--hd-shadow);
      }
    }
    @keyframes mark-shrink {
      to {
        width: 24px;
        height: 24px;
        stroke-width: 4.5;
        --mk-k: 1.12;
      }
    }
  }

  @media (min-width: 640px) {
    .site-header__bar {
      padding-inline: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .site-header {
      --hd-h: 72px;
      --m: 30px;
      --sw: 3.6;
      --k: 1;
    }
    .site-header__bar {
      grid-template-columns: auto 1fr auto;
      column-gap: 1.5rem;
    }
    .site-header__nav {
      display: block;
      justify-self: center;
    }
    .site-header__cta-long {
      display: inline;
    }
    .site-header__cta-short,
    .site-menu__btn,
    .site-menu__panel {
      display: none;
    }
    .site-header .site-header__wa {
      display: inline-flex;
    }
  }
</style>

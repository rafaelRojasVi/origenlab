---
import Icon from '../ui/Icon.astro';
import { criterion } from '../../lib/showroom/content/sources';

/**
 * Avance de «Así se ve su cotización» para la portada: una hoja de papel
 * (CSS, sin imagen) con el formato real de la cotización de OrigenLab, que no
 * lleva fotos de equipos: línea teal, número, cliente, líneas de texto con su
 * código de modelo, montos desenfocados, totales y QR. Datos ficticios (los del
 * ejemplo completo); sin cifras legibles. Lleva a `/como-comprar/#cotizacion`
 * (`QuoteShowcase`), donde la hoja se arma sola.
 *
 * Detrás asoma la ficha técnica del fabricante que acompaña cada cotización
 * (la del MB120, primera línea del ejemplo): póster del estudio blanco y
 * criterios de `brandModels.ts`. Su contenido va en la franja que asoma.
 */
const lines = [
  { code: 'MB120', item: 'Analizador de humedad OHAUS' },
  { code: 'PX224', item: 'Balanza analítica OHAUS Pioneer' },
  { code: '', item: 'Platos de aluminio desechables (caja de 80)' },
];
const specs = ['Capacidad', 'Legibilidad', 'Calentamiento'].flatMap((label) => {
  const value = criterion('ohaus-mb120', label);
  return value ? [{ label, value }] : [];
});
---

<a class="qt" href="/como-comprar/#cotizacion">
  <span class="qt__stage" aria-hidden="true">
    <span class="qt__ficha">
      <span class="qt__fcol">
        <em>Ficha técnica · Del fabricante</em>
        <b>OHAUS MB120</b>
        <img class="pz" src="/products/ohaus-mb120-poster.jpg" alt="" width="1200" height="900" loading="lazy" decoding="async" />
        {
          specs.map((s) => (
            <span class="qt__fspec">
              <em>{s.label}</em>
              {s.value}
            </span>
          ))
        }
      </span>
    </span>
    <span class="qt__sheet">
      <span class="qt__top">
        <span class="qt__brand"><img src="/logo/origenlab-mark-light.svg" alt="" width="18" height="18" loading="lazy" />OrigenLab</span>
        <span class="qt__no"><b>Cotización</b>CN09876</span>
      </span>
      <span class="qt__meta">
        <span><em>Cliente</em>Instituto Ficticio de Biociencias</span>
        <span><em>Atención</em>Dra. Ana Pérez</span>
      </span>
      <span class="qt__lines">
        {
          lines.map((line) => (
            <span class="qt__line">
              <span>
                {line.item}
                {line.code && <b>{line.code}</b>}
              </span>
              <i>$ 0.000.000</i>
            </span>
          ))
        }
      </span>
      <span class="qt__totals">
        <span>Neto<i>$ 0.000.000</i></span>
        <span>IVA 19 %<i>$ 000.000</i></span>
        <span class="qt__total">Total<i>$ 0.000.000</i></span>
      </span>
      <span class="qt__foot">
        <span class="qt__qr"></span>
        <span class="qt__sign">Firmada por una persona</span>
      </span>
      <span class="qt__stamp">Ejemplo</span>
    </span>
  </span>
  <span class="qt__text">
    <span class="qt__h">Así se ve su cotización<i class="dot">.</i></span>
    <span class="qt__copy">Hecha para su institución: el modelo exacto, neto, IVA y total claros, y una persona que la firma.</span>
    <span class="qt__go">Ver el ejemplo <Icon name="arrow-right" size={16} class="arrow" /></span>
  </span>
</a>

<style>
  .qt {
    display: grid;
    grid-template-columns: 5fr 7fr;
    align-items: center;
    gap: 2.5rem;
    margin-top: clamp(4rem, 7vw, 6rem);
    color: var(--color-ink-950);
  }
  .qt__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    order: -1;
  }
  .qt__h {
    font-size: clamp(2.25rem, 4.4vw, 3.875rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .qt__copy {
    max-width: 36ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-ink-600);
  }
  .qt__go {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: var(--color-teal-700);
    font-weight: 600;
  }
  .qt:hover .qt__go {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .qt__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 32rem;
  }
  .qt__stage > * {
    grid-area: 1 / 1;
  }
  /* Ficha técnica detrás: girada al otro lado, más abajo y a la derecha, con
     sombra teal más suave. Su contenido va en la franja derecha, la que asoma.
     El póster (`.pz`) se funde con el papel: la ficha es su propio contexto de
     apilamiento y su fondo es el blanco. */
  .qt__ficha {
    display: flex;
    justify-content: flex-end;
    width: min(24.375rem, 100%);
    aspect-ratio: 1 / 1.414;
    padding: 1.875rem 1.25rem;
    border-radius: 6px;
    background:
      repeating-linear-gradient(#eef2f1 0 3px, transparent 3px 11px) 1.5rem 4.5rem / 48% 40% no-repeat,
      #fff;
    box-shadow: 0 1px 2px rgb(15 90 80 / 0.06), 0 24px 48px -24px rgb(15 90 80 / 0.2);
    translate: 25% 4%;
    rotate: 4deg;
    transition: rotate 900ms var(--ease-out), translate 900ms var(--ease-out);
  }
  .qt__fcol {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 33%;
    font-size: 0.5625rem;
    line-height: 1.35;
    color: var(--color-ink-800);
  }
  .qt__fcol > em,
  .qt__fspec em {
    display: block;
    font: 500 0.5rem/1.35 var(--font-mono);
    font-style: normal;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }
  .qt__fcol > em {
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-ink-950);
  }
  .qt__fcol b {
    font-size: 0.9375rem;
    line-height: 1.1;
    color: var(--color-ink-950);
  }
  .qt__fcol img {
    display: block;
    width: 100%;
    height: auto;
  }
  .qt__fspec {
    padding-top: 0.375rem;
    border-top: 1px solid var(--color-hairline);
  }
  /* Papel con sombra teal, levemente girado; se endereza al pasar. */
  .qt__sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(24.375rem, 100%);
    aspect-ratio: 1 / 1.414;
    padding: 1.875rem;
    border-top: 4px solid var(--color-teal-700);
    border-radius: 6px;
    background: #fff;
    box-shadow: var(--shadow-sheet);
    font-size: 0.625rem;
    line-height: 1.45;
    color: var(--color-ink-800);
    rotate: -3deg;
    translate: -12% 0;
    transition: rotate 900ms var(--ease-out), translate 900ms var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    .qt:hover .qt__sheet {
      rotate: -1deg;
      translate: -12% -6px;
    }
    .qt:hover .qt__ficha {
      rotate: 5deg;
      translate: 29% 4%;
    }
  }
  .qt__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .qt__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-ink-950);
  }
  .qt__no {
    text-align: right;
    font: 500 0.5625rem var(--font-mono);
    color: var(--color-ink-500);
  }
  .qt__no b {
    display: block;
    font: 700 0.8125rem var(--font-sans);
    color: var(--color-ink-950);
  }
  .qt__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
    margin: 0.875rem 0;
    padding: 0.625rem;
    border-radius: 6px;
    background: var(--color-surface);
  }
  .qt__meta em,
  .qt__totals em {
    display: block;
    font: 500 0.5rem var(--font-mono);
    font-style: normal;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }
  .qt__lines {
    display: grid;
    border-top: 1px solid var(--color-hairline);
  }
  .qt__line {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-hairline);
  }
  .qt__line b {
    margin-left: 0.375rem;
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-teal-700);
  }
  .qt__line i,
  .qt__totals i {
    flex: none;
    font-style: normal;
    font-family: var(--font-mono);
    filter: blur(3px);
  }
  .qt__totals {
    display: grid;
    gap: 0.25rem;
    width: 55%;
    margin: 0.75rem 0 0 auto;
  }
  .qt__totals > span {
    display: flex;
    justify-content: space-between;
  }
  .qt__total {
    padding-top: 0.375rem;
    border-top: 1px solid var(--color-hairline);
    font-weight: 700;
    color: var(--color-ink-950);
  }
  .qt__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-hairline);
    color: var(--color-ink-500);
  }
  .qt__qr {
    width: 2.75rem;
    height: 2.75rem;
    background:
      conic-gradient(var(--color-ink-950) 25%, transparent 0 50%, var(--color-ink-950) 0 75%, transparent 0) 0 0 / 6px 6px;
    opacity: 0.8;
    border: 3px solid #fff;
    outline: 3px solid var(--color-ink-950);
    outline-offset: -6px;
  }
  .qt__sign {
    padding-top: 0.25rem;
    border-top: 1px solid var(--color-ink-500);
  }
  .qt__stamp {
    position: absolute;
    right: 1.625rem;
    bottom: 6.875rem;
    rotate: -12deg;
    padding: 0.375rem 0.75rem;
    border: 2px solid var(--color-teal-500);
    border-radius: 8px;
    font: 600 0.9375rem var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-teal-700);
    opacity: 0.85;
  }
  @media (max-width: 899.98px) {
    .qt {
      grid-template-columns: minmax(0, 1fr);
    }
    .qt__stage {
      min-height: 0;
      padding-block: 1rem 2rem;
    }
    .qt__sheet,
    .qt__ficha {
      width: min(18rem, 78%);
      padding: 1.25rem;
      font-size: 0.5rem;
    }
    .qt__sheet,
    .qt:hover .qt__sheet {
      translate: -11% 0;
    }
    .qt__ficha,
    .qt:hover .qt__ficha {
      translate: 13% 3%;
      rotate: 3deg;
      padding-inline: 0.75rem;
    }
    .qt__fcol {
      width: 24%;
      gap: 0.375rem;
    }
    .qt__fcol > em,
    .qt__fspec {
      display: none;
    }
    .qt__fcol b {
      font-size: 0.6875rem;
    }
    .qt__stamp {
      font-size: 0.75rem;
      bottom: 5rem;
      right: 1rem;
    }
  }
</style>

    gap: 4px;
    max-width: 144px;
    text-align: center;
    font-size: 10px;
    line-height: 1.3;
    color: #000000;
  }
  .qs-wa svg {
    display: block;
    width: 84px;
    height: 84px;
  }

  /* ---- Construcción: sólo con script y sin movimiento reducido ------------
     Cada parte declara su animación (`--an`), duración (`--t`), curva (`--e`)
     y retraso (`--d`, en línea). `qs-in` es la entrada común: opacidad y un
     desplazamiento vertical `--y`. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .qs:not(.qs--play) :is(.qs-sheet, .qs-a) {
      opacity: 0;
    }
    .qs:not(.qs--play) .qs-sheet::before,
    .qs:not(.qs--play) .qs-stroke {
      transform: scaleX(0);
    }
    .qs--play :is(.qs-sheet, .qs-a),
    .qs--play .qs-sheet::before {
      animation: var(--an, qs-in) var(--t, 450ms) var(--e, cubic-bezier(0.2, 0.7, 0.2, 1)) var(--d, 0s) both;
    }
    /* Las variables se heredan: cada parte animada vuelve a los valores por
       defecto antes de declarar los suyos. */
    .qs-sheet {
      --y: 48px;
      --t: 900ms;
    }
    .qs-a {
      --an: qs-in;
      --t: 450ms;
      --y: 6px;
      --e: cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .qs-sheet::before,
    .qs-stroke {
      --an: qs-draw;
      --t: 600ms;
      --e: cubic-bezier(0.65, 0, 0.35, 1);
    }
    .qs-sheet::before {
      --d: 0.45s;
    }
    .qs-type {
      --an: qs-type;
      --e: steps(22, end);
    }
    .qs-drop {
      --y: -12px;
    }
    .qs-settle {
      --y: 10px;
    }
    .qs-glow {
      --an: qs-glow;
      --t: 1.1s;
    }
    .qs-blur {
      --an: qs-blur;
    }
    .qs-qr {
      --an: qs-wipe;
      --t: 850ms;
      --e: steps(var(--rows), end);
    }
    .qs-ficha {
      --an: qs-tuck;
      --t: 900ms;
    }
    .qs-pop {
      --an: qs-pop;
      --e: cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @media (min-width: 1100px) {
      .qs__callouts .qs-pop {
        --an: qs-slide;
      }
    }
  }
  @keyframes qs-in {
    from {
      opacity: 0;
      transform: translateY(var(--y, 6px));
    }
  }
  @keyframes qs-tuck {
    from {
      opacity: 0;
      transform: translateX(215px) rotate(3deg);
    }
  }
  @keyframes qs-draw {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes qs-type {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }
  @keyframes qs-wipe {
    from {
      clip-path: inset(0 0 100%);
    }
  }
  @keyframes qs-glow {
    30% {
      background-color: rgb(15 118 110 / 0.18);
      box-shadow: 0 0 0 3px rgb(15 118 110 / 0.18);
    }
  }
  @keyframes qs-blur {
    from {
      opacity: 0;
      filter: blur(12px);
    }
  }
  @keyframes qs-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }
  @keyframes qs-slide {
    from {
      opacity: 0;
      transform: translate(-12px, -50%);
    }
    to {
      transform: translateY(-50%);
    }
  }
</style>

<script>
  // Arma la hoja una sola vez, cuando entra en pantalla (el CSS hace el resto).
  for (const el of document.querySelectorAll<HTMLElement>('[data-qs]')) {
    const play = () => el.classList.add('qs--play');
    if (!('IntersectionObserver' in window)) play();
    else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            play();
          }
        },
        { threshold: 0.3 },
      );
      io.observe(el.querySelector('.qs-sheet') ?? el);
    }
  }
</script>

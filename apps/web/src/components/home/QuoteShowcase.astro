  .qs-model:focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: 2px;
  }
  .qs-note {
    display: block;
    margin-top: 3px;
    font-size: 12px;
    color: #4b5c57;
    white-space: pre-line;
  }
  /* Montos de relleno: siempre desenfocados (los precios son de cada cotización). */
  .qs-price {
    display: inline-block;
    filter: blur(3.6px);
    user-select: none;
  }
  .qs-totals {
    width: 300px;
    margin: 12px 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .qs-totals > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .qs-totals dt {
    color: #4b5c57;
  }
  .qs-totals dd {
    margin: 0;
  }
  .qs-totals .qs-total {
    align-items: baseline;
    margin-top: 2px;
    padding-top: 7px;
    border-top: 1px solid #14201d;
  }
  .qs-totals .qs-total dt {
    color: #14201d;
    font-weight: 700;
  }
  .qs-totals .qs-total dd {
    font-weight: 700;
  }
  .qs-h2 {
    margin: 12px 0 6px;
    font-size: 13px;
    font-weight: 700;
  }
  .qs-terms {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
  }
  .qs-terms > div {
    min-width: 0;
    padding-top: 7px;
    border-top: 1px solid #d9e2df;
  }
  .qs-terms dt {

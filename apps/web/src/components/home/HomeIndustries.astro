---
import { getCollection } from 'astro:content';
import type { Modelo } from '../../content.config';
import { applications } from '../../data/applications';
import { isShownOnHome } from '../../data/brands';
import { publicClaim } from '../../data/claims';
import { industries } from '../../data/industries';
import { familyHref, familyInfo, modelHref, type FamilySlug } from '../../lib/modelos';
import { modelThumb } from '../../lib/modelThumb';
import { rankFamilies, rankModels } from '../../lib/ranking';

/**
 * Industrias (portada): seis tiles pastel con el tinte de su primera familia.
 * Cada uno lleva el nombre del sector (enlace), una línea con lo que hace con
 * nuestros equipos y dos o tres miniaturas de modelo directo a su ficha.
 *
 * - Orden (marketing, 2026-11-08): alimentos y agro primero, después los
 *   compradores de industria y al final la academia y el sector público.
 * - Línea: el nombre de la aplicación que encabeza cada familia del sector
 *   (`applications.ts`); sin familias, la afirmación aprobada de Mercado
 *   Público. Nada redactado aquí.
 * - Miniaturas: con una familia, sus tres primeros modelos en el orden
 *   comercial (`rankModels`); con varias, el primero de cada una. El sector
 *   público muestra el primero de las tres primeras familias.
 */
const LEAD = ['Alimentos y agro', 'Salmón', 'Farma', 'Hospitales', 'Universidades', 'Sector público'];
const ordered = [...industries].sort(
  (a, b) => (LEAD.indexOf(a.name) + 1 || 99) - (LEAD.indexOf(b.name) + 1 || 99),
);

const all = (await getCollection('modelos')).map((item) => item.data as Modelo);
const ranked = rankModels(all.map((entry) => ({ id: entry.slug, entry })))
  .map(({ entry }) => entry)
  .filter((entry) => isShownOnHome(entry.brand) && modelThumb(entry));
const inFamily = (slug: FamilySlug) => ranked.filter((entry) => entry.family === slug);
const topFamilies = rankFamilies([...new Set(ranked.map((entry) => entry.family))], (slug) => familyHref(slug).split('/')[2] ?? '').slice(0, 3);

const leadApplication = (slug: FamilySlug) =>
  applications.find((application) => application.familyIds[0] === familyInfo(slug).scopeId)?.name;

const tiles = ordered.map((item) => {
  const families = item.families.length > 0 ? item.families : topFamilies;
  const models =
    families.length === 1 ? inFamily(families[0]!).slice(0, 3) : families.flatMap((slug) => inFamily(slug).slice(0, 1));
  const line =
    item.families.length > 0
      ? [...new Set(item.families.map(leadApplication).filter(Boolean))].join(' · ')
      : publicClaim('vende-mercado-publico');
  const first = item.families[0];
  const tint = first ? `var(--color-tint-${first === 'pesaje-humedad' ? 'humedad' : first})` : 'var(--color-tint)';
  return { ...item, models, line, tint };
});
---

<section class="shell home-sec home-ind" id="industrias" aria-labelledby="industrias-title">
  <div class="home-head rv">
    <h2 id="industrias-title" class="t-label">Industrias</h2>
  </div>
  <ul class="ind rv">
    {
      tiles.map((tile) => (
        <li data-industry style={`--tint: ${tile.tint}`}>
          <h3 class="ind__name">
            <a href={tile.href}>{tile.name}</a>
          </h3>
          {tile.line && <p class="ind__line">{tile.line}</p>}
          <ul class="ind__models">
            {tile.models.map((entry) => {
              const t = modelThumb(entry)!;
              return (
                <li>
                  <a href={modelHref(entry)} data-kind={t.kind}>
                    <img src={t.src} srcset={t.srcset} sizes={t.srcset ? '96px' : undefined} width={t.width} height={t.height} alt={t.alt} loading="lazy" decoding="async" />
                  </a>
                </li>
              );
            })}
          </ul>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .home-ind {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }
  /* Es una etiqueta, no un titular de sección: sin el aire de `.home-head`. */
  .home-ind .home-head {
    margin-bottom: 2rem;
  }
  .ind {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ind > li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    background: var(--tint);
  }
  .ind__name {
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .ind__name a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ind__line {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-ink-600);
  }
  .ind__models {
    display: flex;
    gap: 0.5rem;
    margin: auto 0 0;
    padding: 0.75rem 0 0;
    list-style: none;
  }
  /* Miniatura sobre un charco de luz blanca; se funde con el tinte (multiply). */
  .ind__models a {
    display: block;
    width: 6rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.75rem;
    background: radial-gradient(closest-side, #fff 35%, rgb(255 255 255 / 0)) center / 80% 90% no-repeat;
  }
  .ind__models img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(1.037);
    mix-blend-mode: multiply;
    transition: transform 600ms var(--ease-out);
  }
  .ind__models [data-kind='photo'] img {
    padding: 8%;
    object-fit: contain;
  }
  .ind__models a:hover img {
    transform: scale(1.08);
  }
  @media (max-width: 1023.98px) {
    .ind {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639.98px) {
    .ind {
      grid-template-columns: minmax(0, 1fr);
    }
    .ind > li {
      padding: 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ind__models img {
      transition: none;
    }
  }
</style>

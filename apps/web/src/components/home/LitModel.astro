---
import Turntable from '../ui/Turntable.astro';
import LightBox from '../ui/LightBox.astro';
import Icon from '../ui/Icon.astro';
import { getBrandById } from '../../lib/catalog';
import { imageForEntry, keyStats, modelHref } from '../../lib/modelos';
import { turntableFor } from '../../lib/turntable';
import type { Modelo } from '../../content.config';

/**
 * Tarjeta iluminada compacta de un modelo para la portada y `/aplicaciones/`:
 * toda la tarjeta es un enlace directo a la ficha (regla del dueño: ninguna
 * mención de un modelo pasa por una página intermedia).
 *
 * Con póster 3D, `Turntable` (gira al pasar el mouse o al enfocar la tarjeta);
 * sin él, la fotografía en `LightBox`. Debajo, marca, nombre y la primera cifra
 * de la ficha del fabricante (`keyStats`), sin cifras comerciales.
 *
 * Es la variante pequeña de la tarjeta del catálogo (`product/ModelCard`, Tarea 2);
 * al unir las ramas puede reemplazarse por aquélla si comparte el mismo contrato.
 */
interface Props {
  entry: Modelo;
  loading?: 'lazy' | 'eager';
}
const { entry, loading = 'lazy' } = Astro.props;
const brandName = getBrandById(entry.brand)?.name ?? entry.brand;
const has3d = turntableFor(entry.slug) !== null;
const image = imageForEntry(entry);
const stat = keyStats(entry, 1)[0];
---

<a href={modelHref(entry)} class="card-lit lit">
  <span class="lit__media">
    {
      has3d ? (
        <Turntable slug={entry.slug} alt={`${entry.name} de ${brandName}, modelo 3D`} loading={loading} />
      ) : (
        <LightBox image={image} brandName={brandName} size="card" />
      )
    }
  </span>
  <span class="lit__body">
    <span class="t-label lit__brand" translate="no">{brandName}</span>
    <span class="lit__name" translate="no">{entry.name}</span>
    {stat && <span class="t-data lit__stat">{stat.label} · {stat.value}</span>}
  </span>
  <Icon name="arrow-right" size={18} class="arrow lit__go" />
</a>

<style>
  .lit {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: var(--color-fg);
  }
  .lit__media {
    display: block;
    padding: 0.5rem 0.5rem 0;
  }
  .lit__media :global(.tt),
  .lit__media :global(.lightbox__plinth) {
    border-radius: calc(var(--radius-card) - 0.375rem);
  }
  .lit__media :global(.lightbox) {
    margin: 0;
  }
  .lit__media :global(figcaption) {
    display: none;
  }
  .lit__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem 1.25rem;
    padding-right: 3rem;
  }
  .lit__brand {
    color: var(--color-ink-600);
  }
  .lit__name {
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .lit__stat {
    margin-top: 0.25rem;
    color: var(--color-ink-500);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .lit :global(.lit__go) {
    position: absolute;
    right: 1.25rem;
    bottom: 1.375rem;
    color: var(--color-teal-700);
    transition: transform var(--ease-ui);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lit:hover :global(.lit__go),
    .lit:focus-visible :global(.lit__go) {
      transform: translateX(3px);
    }
  }
</style>

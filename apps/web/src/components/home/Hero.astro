---
import { ctaLabels } from '../../lib/ctaLabels';
import { equipmentScope } from '../../data/equipmentScope';
import { getBrandByFamilyId } from '../../lib/catalog';
import { publicClaim } from '../../data/claims';
import { site } from '../../config/site';
import Icon from '../ui/Icon.astro';
import OrigenMarkAnimated from '../logo/OrigenMarkAnimated.astro';

/**
 * Portada, primer momento.
 *
 * El hero tiene un trabajo por encima de cualquier otro: que en la primera
 * pantalla se vea que OrigenLab cotiza seis familias de equipo distintas, y no
 * una. La versión anterior nombraba cinco en un índice lateral; ésta las nombra
 * con su marca al lado, porque el nombre de la familia sin fabricante todavía
 * se lee como una promesa genérica.
 *
 * No se ilustra con fotografía. La única fotografía de producto con procedencia
 * en el repositorio es de centrífugas, y abrir con ella declararía que esto es
 * una casa de centrífugas: exactamente lo que el rediseño tiene que deshacer.
 * En su lugar abre la marca animada, que es material propio y dice lo mismo que
 * la página entera va a decir: una muestra que se mueve y tres cuerpos que la
 * acompañan.
 *
 * El recuento sale del registro de afirmaciones: si alguien retira la
 * aprobación, la línea desaparece sola.
 */
const familiesClaim = publicClaim('familias-de-equipo');

const families = equipmentScope.map((entry) => ({
  ...entry,
  brand: getBrandByFamilyId(entry.id),
}));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero__inner">
    <div class="hero__copy">
      <p class="t-label hero__eyebrow">{site.tagline}</p>
      <h1 id="hero-title" class="hero__title">
        Equipamiento científico para cada etapa de su muestra.
      </h1>
      <p class="hero__lead">
        Pesaje, dispersión, ultrasonido, centrifugación, osmometría y electroforesis. Seis
        familias de equipo de seis fabricantes, cotizadas a partir de lo que su laboratorio
        necesita hacer con la muestra.
      </p>
      <div class="hero__actions">
        <a href={site.quoteHref} class="btn btn-primary">{ctaLabels.contarAplicacion}</a>
        <a href="#familias" class="link-arrow">
          Ver las seis familias
          <Icon name="arrow-right" size={18} class="arrow" />
        </a>
      </div>
    </div>

    <div class="hero__mark" aria-hidden="true">
      <OrigenMarkAnimated size={180} />
    </div>
  </div>

  <!--
    El índice de familias cierra la primera pantalla. Es una tabla de alcance,
    no una rejilla de tarjetas: filete, nombre, fabricante y tipo de trabajo.
  -->
  <div class="shell">
    <div class="hero__index">
      <div class="hero__index-head">
        <h2 class="t-label" id="alcance-hero">Qué cotizamos</h2>
        {familiesClaim && <p class="t-data hero__count">{familiesClaim}</p>}
      </div>
      <ul class="scope-index" aria-labelledby="alcance-hero">
        {
          families.map((entry) => (
            <li class="scope-index__row">
              <span class="scope-index__name">{entry.name}</span>
              <span class="scope-index__brand t-data">{entry.brand?.name}</span>
              <span class="scope-index__work t-data">{entry.workType}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero__inner {
    display: grid;
    gap: 2.5rem;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .hero__eyebrow {
    margin-bottom: 1.25rem;
  }
  /*
   * La portada usa una escala de titular propia, mayor que `.t-display`. Es el
   * único sitio del sitio donde la tipografía trabaja como imagen, y ese salto
   * de escala es lo que separa la portada de una página interior.
   */
  .hero__title {
    font-size: clamp(2.125rem, 1.2rem + 3.7vw, 3.75rem);
    line-height: 1.03;
    letter-spacing: -0.028em;
    font-weight: 600;
    text-wrap: balance;
  }
  .hero__lead {
    margin-top: 1.75rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-ink-600);
    max-width: 52ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }

  /* En móvil la marca animada no entra: ocuparía la mitad de la primera
     pantalla y el mensaje es el titular, no el dibujo. */
  .hero__mark {
    display: none;
  }

  /* --- Índice de alcance ---------------------------------------------------
     Es un índice, no una tarjeta: filete superior grueso, filas con filete de
     un píxel y ninguna caja. */
  .hero__index {
    padding-bottom: 3rem;
  }
  .hero__index-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.875rem;
  }
  .hero__count {
    font-size: 0.8125rem;
    color: var(--color-ink-500);
  }
  .scope-index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-ink-950);
  }
  .scope-index__row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    padding-block: 0.8125rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .scope-index__name {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink-950);
  }
  .scope-index__brand {
    font-size: 0.8125rem;
    color: var(--color-teal-800);
    text-align: right;
  }
  /* El tipo de trabajo es la tercera columna sólo cuando hay sitio: en móvil
     repetiría información que la sección de familias ya agrupa. */
  .scope-index__work {
    display: none;
  }

  @media (min-width: 768px) {
    .hero__inner {
      padding-top: 3.5rem;
      padding-bottom: 3rem;
    }
    .scope-index__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 13rem) 12rem;
    }
    .scope-index__name {
      font-size: 1.0625rem;
    }
    .scope-index__brand {
      text-align: left;
    }
    .scope-index__work {
      display: block;
      font-size: 0.8125rem;
      color: var(--color-ink-500);
      text-align: right;
      /* Es una etiqueta, no una frase: partida en dos líneas desalinea toda la
         fila y se lee como si fueran dos datos distintos. */
      white-space: nowrap;
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 8fr) minmax(0, 3fr);
      align-items: center;
      gap: 4rem;
      padding-top: 4.5rem;
      padding-bottom: 3.5rem;
    }
    .hero__mark {
      display: flex;
      justify-content: flex-end;
    }
    .hero__index {
      padding-bottom: 4.5rem;
    }
  }
</style>

---
import { consultationProcess } from '../../data/consultation';
import { publicClaim } from '../../data/claims';
import Icon from '../ui/Icon.astro';

/**
 * De la consulta a la cotización.
 *
 * Secuencia vertical con filete continuo, no cuatro columnas iguales: es un
 * procedimiento, y se lee como tal.
 *
 * La rapidez se declara sólo con la redacción aprobada del registro de
 * afirmaciones. La promesa numérica existe en `claims.ts` como propuesta sin
 * aprobar y por tanto no se renderiza; `validate:dist` comprueba que su texto
 * literal no aparezca en el HTML construido. El párrafo que sigue separa a
 * propósito el tiempo de respuesta del plazo de la cotización formal.
 */
const speedClaim = publicClaim('respuesta-agil');
---

<section class="process" aria-labelledby="proceso-title">
  <div class="shell process__inner">
    <div class="process__head">
      <p class="t-label">Cómo trabajamos</p>
      <h2 id="proceso-title" class="t-h2 process__title">De la consulta a la cotización</h2>
      {speedClaim && <p class="process__speed">{speedClaim}.</p>}
      <p class="t-small process__caveat">
        Responder una consulta técnica y emitir una cotización formal son dos tiempos distintos. La
        propuesta puede depender de precio de fábrica, configuración, flete y confirmación de
        entrega, y no comprometemos una fecha antes de tenerla confirmada.
      </p>
    </div>

    <ol class="steps" data-reveal>
      {
        consultationProcess.map((step, i) => (
          <li class="step">
            <span class="step__num t-data" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="step__body">
              <h3 class="step__title">{step.title}</h3>
              <p class="t-small step__text">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <a href="/servicios/" class="link-arrow process__link">
      Soporte, garantía e instalación
      <Icon name="arrow-right" size={18} class="arrow" />
    </a>
  </div>
</section>

<style>
  .process {
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-hairline);
  }
  .process__inner {
    padding-block: 4rem;
  }
  .process__title {
    margin-top: 1rem;
  }
  /* La rapidez se afirma una vez y en grande, porque es una promesa cualitativa
     y no una cifra: si algún día se aprueba el plazo, ocupará este lugar. */
  .process__speed {
    margin-top: 1.5rem;
    font-size: clamp(1.25rem, 1.1rem + 0.65vw, 1.625rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 500;
    color: var(--color-teal-800);
    max-width: 22ch;
  }
  .process__caveat {
    margin-top: 1.25rem;
    color: var(--color-ink-600);
    max-width: 52ch;
  }

  /* Un solo filete recorre los cinco pasos: el proceso es uno, no cinco
     bloques sueltos. Los numerales cuelgan a la izquierda de la regla. */
  .steps {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-ink-950);
  }
  .step {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .step__num {
    font-size: 0.8125rem;
    color: var(--color-teal-800);
    line-height: 1.7;
  }
  .step__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink-950);
  }
  .step__text {
    margin-top: 0.375rem;
    color: var(--color-ink-600);
    max-width: 62ch;
  }
  /* Cierra la sección tras los cinco pasos, en la misma columna que ellos: es
     la continuación del procedimiento, no del encuadre de la izquierda. */
  .process__link {
    justify-self: start;
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .process__inner {
      padding-block: 6rem;
    }
    .step {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 1.5rem;
      padding-block: 1.5rem;
    }
  }

  /* El encuadre y la secuencia conviven en dos columnas sólo desde 1024 px; a
     768 px el encuadre quedaba en 250 px y la frase de rapidez se partía en
     cinco líneas. */
  @media (min-width: 1024px) {
    .process__inner {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: 4.5rem;
      row-gap: 0;
      align-items: start;
    }
    .process__head {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .steps {
      grid-column: 2;
      grid-row: 1;
      margin-top: 0;
    }
    .process__link {
      grid-column: 2;
      grid-row: 2;
      margin-top: 2rem;
    }
  }
</style>

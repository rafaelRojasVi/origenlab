---
import { publicClaim } from '../../data/claims';
import { contact } from '../../data/contact';
import StepList from '../ui/StepList.astro';
import Icon from '../ui/Icon.astro';

/**
 * Cómo comprar, en la portada: una franja de hechos y los cuatro pasos.
 *
 * La franja es la prueba que el sitio puede sostener, nada más. El número de
 * marcas sale del registro de afirmaciones; cobertura, puesta en marcha y
 * compras públicas son hechos del negocio sin cifra. Años en el mercado,
 * clientes y plazos de respuesta medidos están en `claims.ts` como
 * `unavailable` y no se escriben.
 *
 * Los pasos son el resumen de `/como-comprar/` (`buyingSteps`), con sólo el
 * título. La rapidez se declara con la redacción aprobada; la promesa numérica
 * existe en `claims.ts` como propuesta sin aprobar y `validate:dist` comprueba
 * que su texto literal no aparezca en el HTML construido.
 *
 * Sustituye a los cinco pasos de «De la consulta a la cotización»: la consulta
 * ya la cuenta la sección de asesoría, y dos procedimientos seguidos en la
 * misma portada se leían como uno repetido.
 */
const speedClaim = publicClaim('respuesta-agil');
const brandsClaim = publicClaim('marcas-con-las-que-trabajamos');

const facts = [
  brandsClaim && { label: 'Fabricantes', value: brandsClaim },
  { label: 'Cobertura', value: `Despacho a todo Chile desde ${contact.city}` },
  { label: 'Puesta en marcha', value: 'Con capacitación de fábrica' },
  { label: 'Compras públicas', value: 'Licitaciones y Compra Ágil' },
].filter((fact): fact is { label: string; value: string } => Boolean(fact));
---

<section class="process" aria-labelledby="proceso-title">
  <div class="shell process__inner">
    <dl class="facts" data-reveal>
      {
        facts.map((fact) => (
          <div class="facts__item">
            <dt class="t-label">{fact.label}</dt>
            <dd class="facts__value">{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="process__grid">
      <div class="process__head">
        <p class="t-label">Cómo comprar</p>
        <h2 id="proceso-title" class="t-h2 process__title">De la cotización a la puesta en marcha</h2>
        {speedClaim && <p class="process__speed">{speedClaim}.</p>}
        <p class="t-small process__caveat">
          Sin precios publicados: cada cotización se arma con la configuración, los accesorios y el
          flete que su caso pide, y no comprometemos una fecha de entrega antes de tenerla confirmada.
        </p>
      </div>

      <div>
        <StepList summary />
        <a href="/como-comprar/" class="link-arrow process__link">
          Cómo comprar, paso a paso
          <Icon name="arrow-right" size={18} class="arrow" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .process {
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-hairline);
  }
  .process__inner {
    padding-block: 4rem;
  }

  /* Franja de hechos: filetes y mono, sin fichas. Dos columnas en el teléfono,
     cuatro en una sola línea desde 1024 px. */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
    margin: 0 0 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .facts__item {
    padding-left: 1rem;
    border-left: 1px solid var(--color-teal-700);
  }
  .facts__value {
    margin: 0.5rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.35;
    font-weight: 500;
    color: var(--color-ink-950);
  }

  .process__grid {
    display: grid;
    gap: 2.5rem;
  }
  .process__title {
    margin-top: 1rem;
  }
  /* La rapidez se afirma una vez y en grande, porque es una promesa cualitativa
     y no una cifra: si algún día se aprueba el plazo, ocupará este lugar. */
  .process__speed {
    margin-top: 1.5rem;
    font-size: clamp(1.25rem, 1.1rem + 0.65vw, 1.625rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 500;
    color: var(--color-teal-800);
    max-width: 22ch;
  }
  .process__caveat {
    margin-top: 1.25rem;
    color: var(--color-ink-600);
    max-width: 52ch;
  }
  .process__link {
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .process__inner {
      padding-block: 6rem;
    }
    .facts {
      margin-bottom: 4.5rem;
      padding-bottom: 3rem;
    }
  }

  /* El encuadre y la secuencia conviven en dos columnas sólo desde 1024 px; a
     768 px el encuadre quedaba en 250 px y la frase de rapidez se partía en
     cinco líneas. */
  @media (min-width: 1024px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2.5rem;
    }
    .process__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: 4.5rem;
      align-items: start;
    }
  }
</style>

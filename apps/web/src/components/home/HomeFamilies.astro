---
import { getCollection } from 'astro:content';
import Icon from '../ui/Icon.astro';
import LitCard from '../ui/LitCard.astro';
import { publicClaim } from '../../data/claims';
import { isShownOnHome } from '../../data/brands';
import { homeFamilyCards, modelHref } from '../../lib/modelos';
import { rankFamilies, rankModels } from '../../lib/ranking';
import { turntableFor } from '../../lib/turntable';
import type { Modelo } from '../../content.config';

/**
 * «Elija el equipo» (portada, «Blanco con color»), en dos tiempos:
 *
 * 1. Fila de modelos: el primer modelo de cada una de las cuatro primeras
 *    familias en el orden comercial (`rankFamilies` / `rankModels`: 3D primero),
 *    cada uno una `LitCard` sobre el tinte de su familia, directo a la ficha.
 * 2. Las seis familias en una franja compacta: el verbo (enlace a la familia,
 *    `.home-family-card`) y los dos primeros modelos de la colección, cada uno
 *    enlazado a su ficha (regla del dueño).
 *
 * La etiqueta de cifras sale del registro de afirmaciones. Con el titular B en
 * la primera pantalla, este bloque lleva «Elija el equipo. Nosotros lo cotizamos.»
 */
interface Props {
  headlineB: boolean;
}
const { headlineB } = Astro.props;

const label = [publicClaim('familias-de-equipo'), publicClaim('marcas-con-las-que-trabajamos')]
  .filter(Boolean)
  .join(' · ');
const all = (await getCollection('modelos')).map((item) => item.data as Modelo);
const ranked = rankModels(all.map((entry) => ({ id: entry.slug, entry }))).map(({ entry }) => entry);
const families = rankFamilies(homeFamilyCards(all), (card) => card.href.split('/')[2] ?? '').map((card) => ({
  ...card,
  models: ranked.filter((entry) => entry.family === card.slug && isShownOnHome(entry.brand)).slice(0, 2),
}));
const row = families
  .map((family) => family.models.find((entry) => turntableFor(entry.slug)) ?? family.models[0])
  .filter((entry): entry is Modelo => Boolean(entry))
  .slice(0, 4);
---

<section class="shell home-sec" id="familias" aria-labelledby="familias-title">
  <div class="home-head rv">
    {label && <p class="t-label">{label}</p>}
    <h2 id="familias-title" class="home-h2">
      {
        headlineB ? (
          <>
            Elija el equipo<i class="dot">.</i>
            <br />
            Nosotros lo cotizamos<i class="dot">.</i>
          </>
        ) : (
          'Qué hace su laboratorio con la muestra'
        )
      }
    </h2>
    <p class="lede">Directo del fabricante, con la ficha técnica en cada cotización.</p>
  </div>

  <ul class="row rv">
    {
      row.map((entry) => (
        <li>
          <LitCard entry={entry} />
        </li>
      ))
    }
  </ul>

  <ul class="fam rv" aria-label="Familias de equipo">
    {
      families.map((family) => (
        <li style={`--fam-ink: var(${family.colorVar})`}>
          <h3 class="fam__verb">
            <a class="home-family-card" href={family.href}>
              <i aria-hidden="true" />
              {family.verb}
              <Icon name="arrow-right" size={16} class="arrow" />
            </a>
          </h3>
          <p class="fam__models">
            {family.models.map((entry, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={modelHref(entry)} translate="no">{entry.name}</a>
              </>
            ))}
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row > li {
    display: flex;
  }
  .row > li > :global(*) {
    flex: 1;
  }
  @media (max-width: 899.98px) {
    .row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 0.875rem;
    }
  }

  /* Las seis familias: una franja de verbos, cada uno con su punto de tinte. */
  .fam {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin: clamp(3.5rem, 6vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }
  .fam > li {
    padding-top: 1.25rem;
  }
  .fam__verb {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .home-family-card {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--color-ink-950);
  }
  .home-family-card i {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--fam-ink) 70%, #fff);
  }
  .home-family-card :global(.arrow) {
    color: var(--color-teal-700);
    transition: transform var(--ease-ui);
  }
  .home-family-card:hover {
    color: var(--color-teal-800);
  }
  @media (prefers-reduced-motion: no-preference) {
    .home-family-card:hover :global(.arrow) {
      transform: translateX(3px);
    }
  }
  .fam__models {
    font-size: 0.875rem;
    color: var(--color-ink-500);
    line-height: 1.4;
  }
  .fam__models a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-teal-800);
  }
  .fam__models a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 1023.98px) {
    .fam {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 639.98px) {
    .fam {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1rem;
    }
  }
</style>

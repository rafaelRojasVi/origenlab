---
import { getCollection } from 'astro:content';
import Icon from '../ui/Icon.astro';
import Turntable from '../ui/Turntable.astro';
import LightBox from '../ui/LightBox.astro';
import { publicClaim } from '../../data/claims';
import { isShownOnHome } from '../../data/brands';
import { getBrandById } from '../../lib/catalog';
import { homeFamilyCards, imageForEntry, modelHref } from '../../lib/modelos';
import { rankFamilies, rankModels } from '../../lib/ranking';
import { turntableFor } from '../../lib/turntable';
import type { Modelo } from '../../content.config';

/**
 * Las seis familias como tarjetas grandes iluminadas (tablero HomeA, showroom
 * oscuro). Cada tarjeta muestra el primer modelo de la familia en el estudio
 * oscuro (póster que gira al pasar el mouse; foto en caja de luz si no hay 3D),
 * dice qué hace el laboratorio con la muestra (el verbo, enlace a la familia) y
 * nombra hasta dos modelos de la colección `modelos`, cada uno enlazado directo
 * a su ficha (regla del dueño: ningún modelo pasa por una página intermedia).
 *
 * Orden comercial de `lib/ranking.ts`: familias por `rankFamilies` (sonicación
 * primero, dispersión al final), modelos por `rankModels` (3D primero).
 *
 * La etiqueta de cifras sale del registro de afirmaciones: si alguien retira la
 * aprobación, esa parte desaparece sola. Con el titular B en la primera
 * pantalla, el titular «Equipos para cada etapa de su muestra» baja aquí.
 */
interface Props {
  headlineB: boolean;
}
const { headlineB } = Astro.props;

const label = [publicClaim('familias-de-equipo'), publicClaim('marcas-con-las-que-trabajamos')]
  .filter(Boolean)
  .join(' · ');
const all = (await getCollection('modelos')).map((item) => item.data as Modelo);
const ranked = rankModels(all.map((entry) => ({ id: entry.slug, entry }))).map(({ entry }) => entry);
const cards = rankFamilies(homeFamilyCards(all), (card) => card.href.split('/')[2] ?? '').map((card, index) => {
  const models = ranked.filter((entry) => entry.family === card.slug && isShownOnHome(entry.brand)).slice(0, 2);
  const lead = models[0];
  return {
    ...card,
    numeral: String(index + 1).padStart(2, '0'),
    models,
    lead,
    leadBrand: lead ? (getBrandById(lead.brand)?.name ?? lead.brand) : '',
    has3d: lead ? turntableFor(lead.slug) !== null : false,
  };
});
---

<section class="shell home-sec" id="familias" aria-labelledby="familias-title">
  <div class="home-head rv">
    {label && <p class="t-label">{label}</p>}
    <h2 id="familias-title" class="home-h2">
      {headlineB ? 'Equipos para cada etapa de su muestra' : 'Qué hace su laboratorio con la muestra'}
    </h2>
  </div>
  <ul class="fam">
    {
      cards.map((card) => (
        <li class="card-lit fam__tile rv">
          {card.lead && (
            <a class="fam__media" href={modelHref(card.lead)}>
              {card.has3d ? (
                <Turntable slug={card.lead.slug} alt={`${card.lead.name} de ${card.leadBrand}, modelo 3D`} />
              ) : (
                <LightBox image={imageForEntry(card.lead)} brandName={card.leadBrand} size="card" />
              )}
            </a>
          )}
          <div class="fam__body">
            <span class="t-label fam__top">
              <b><i aria-hidden="true" style={`background-color:var(${card.colorVar})`} />{card.short}</b>
              <span aria-hidden="true">{card.numeral}</span>
            </span>
            <h3 class="fam__verb">
              <a class="home-family-card" href={card.href}>
                {card.verb}
                <Icon name="arrow-right" size={20} class="arrow" />
              </a>
            </h3>
            <p class="fam__line">{card.cardLine}</p>
            <p class="t-data fam__models">
              {card.models.map((entry, index) => (
                <>
                  {index > 0 && <span aria-hidden="true"> · </span>}
                  <a href={modelHref(entry)} translate="no">{entry.name}</a>
                </>
              ))}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .fam {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 1023.98px) {
    .fam {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639.98px) {
    .fam {
      grid-template-columns: 1fr;
    }
  }
  .fam__tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  /* El equipo en su vitrina: el estudio del póster llena el ancho de la tarjeta. */
  .fam__media {
    display: block;
    padding: 0.5rem 0.5rem 0;
  }
  .fam__media :global(.tt),
  .fam__media :global(.lightbox__plinth) {
    border-radius: calc(var(--radius-card) - 0.375rem);
  }
  .fam__media :global(.lightbox) {
    margin: 0;
  }
  .fam__media :global(figcaption) {
    display: none;
  }
  .fam__media:focus-visible {
    outline: 2px solid var(--color-teal-700);
    outline-offset: -2px;
    border-radius: var(--radius-card);
  }
  .fam__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .fam__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-ink-600);
  }
  .fam__top b {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }
  .fam__top i {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .fam__verb {
    margin-top: 0.875rem;
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.125rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .home-family-card {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.5rem;
    color: var(--color-fg);
  }
  .home-family-card :global(.arrow) {
    flex: none;
    color: var(--color-teal-700);
    transition: transform var(--ease-ui);
  }
  .home-family-card:hover {
    color: var(--color-teal-800);
  }
  @media (prefers-reduced-motion: no-preference) {
    .home-family-card:hover :global(.arrow) {
      transform: translateX(4px);
    }
  }
  .fam__line {
    margin-top: 0.625rem;
    color: var(--color-ink-600);
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }
  .fam__models {
    margin-top: auto;
    padding-top: 0.25rem;
    border-top: 1px solid var(--color-hairline);
    color: var(--color-ink-500);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }
  .fam__models a {
    display: inline-flex;
    align-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--color-teal-800);
    text-decoration: underline;
    text-decoration-color: var(--color-hairline-strong);
    text-underline-offset: 0.25em;
  }
  .fam__models a:hover {
    text-decoration-color: currentColor;
  }
</style>

---
import ModelPhoto from '../ui/ModelPhoto.astro';
import { brandModels } from '../../data/brandModels';
import { imageForModel } from '../../data/productImages';

/**
 * Sala de equipo de la portada: el Hielscher UP400St en 3D.
 *
 * El modelo está construido en código con las medidas del plano de dimensiones
 * oficial (`src/lib/showroom/up400st.ts`). Se puede girar, encender y recorrer
 * por vistas, y cuatro marcadores explican sus partes.
 *
 * Mejora progresiva estricta. Lo que llega en el HTML es la fotografía oficial
 * del equipo, con su fila VERIFIED, y el pie. La escena 3D sólo se carga si hay
 * WebGL, si el visitante no pidió movimiento reducido y cuando la figura está
 * cerca de la pantalla; hasta que dibuja su primer cuadro, la foto sigue ahí.
 * Sin JavaScript, la portada queda exactamente con la foto.
 *
 * Las cifras de los marcadores no se escriben aquí: salen de los criterios del
 * modelo en `brandModels.ts`, que citan su fuente oficial.
 */
const MODEL_ID = 'hielscher-up400st';
const model = brandModels.find((entry) => entry.id === MODEL_ID);
const image = imageForModel(MODEL_ID);
const criterion = (label: string) => model?.criteria.find((item) => item.label === label)?.value;

const hotspots = [
  {
    anchor: 'screen',
    title: 'Pantalla y registro',
    body: [criterion('Registro'), criterion('Amplitud') && `Amplitud: ${criterion('Amplitud')?.toLowerCase()}`],
    view: 'pantalla',
  },
  {
    anchor: 'tip',
    title: 'Sonotrodo intercambiable',
    body: [criterion('Sonotrodos'), criterion('Volumen de muestra')],
    view: 'sonotrodo',
  },
  {
    anchor: 'transducer',
    title: 'Potencia y frecuencia',
    body: [[criterion('Potencia'), criterion('Frecuencia')].filter(Boolean).join(' · ')],
    view: 'lateral',
  },
  {
    anchor: 'mount',
    title: 'Montaje en soporte',
    body: ['Se fija a la varilla del soporte con una perilla; el sonotrodo queda centrado sobre el vaso.'],
    view: 'general',
  },
].map((spot, index) => ({ ...spot, numeral: index + 1, body: spot.body.filter(Boolean) as string[] }));

const views = [
  { id: 'general', label: 'Vista general' },
  { id: 'pantalla', label: 'Pantalla' },
  { id: 'sonotrodo', label: 'Sonotrodo' },
  { id: 'lateral', label: 'Lateral' },
];
---

{
  model && image && (
    <figure class="showroom" data-showroom aria-labelledby="showroom-caption">
      <div class="showroom__stage">
        <div class="showroom__photo" data-showroom-photo>
          <ModelPhoto image={image} size="hero" priority ratio="4 / 5" />
        </div>
        <canvas class="showroom__canvas" data-showroom-canvas aria-hidden="true" hidden />
        <div class="showroom__hotspots" data-showroom-hotspots hidden>
          {hotspots.map((spot) => (
            <div class="hotspot" data-anchor={spot.anchor}>
              <button
                type="button"
                class="hotspot__dot"
                aria-expanded="false"
                aria-controls={`hotspot-${spot.anchor}`}
                data-view={spot.view}
              >
                <span aria-hidden="true">{spot.numeral}</span>
                <span class="sr-only">{spot.title}</span>
              </button>
              <div class="hotspot__note" id={`hotspot-${spot.anchor}`} role="note">
                <p class="hotspot__title">{spot.title}</p>
                {spot.body.map((line) => <p>{line}</p>)}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="showroom__bar" data-showroom-bar hidden>
        <button type="button" class="showroom__power" data-showroom-power aria-pressed="false">
          <span class="showroom__led" aria-hidden="true" />
          <span data-power-label>Encender</span>
        </button>
        <div class="showroom__views" role="group" aria-label="Vistas del equipo">
          {views.map((view, index) => (
            <button type="button" class="showroom__view" data-showroom-view={view.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              {view.label}
            </button>
          ))}
        </div>
      </div>

      <figcaption class="showroom__caption t-data" id="showroom-caption">
        <span class="showroom__model">Hielscher {model.name}</span>
        <span>Procesador ultrasónico</span>
        <span class="showroom__mode" data-showroom-mode>Fotografía oficial del fabricante</span>
      </figcaption>
    </figure>
  )
}

<style>
  .showroom {
    margin: 0;
  }
  .showroom__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 44rem;
    width: 100%;
  }
  .showroom__photo,
  .showroom__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .showroom__photo {
    transition: opacity 0.6s ease;
  }
  .showroom__photo :global(.model-photo__frame) {
    height: 100%;
    aspect-ratio: auto !important;
  }
  .showroom[data-ready] .showroom__photo {
    opacity: 0;
    pointer-events: none;
  }
  .showroom__canvas {
    display: block;
    cursor: grab;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .showroom[data-ready] .showroom__canvas {
    opacity: 1;
  }
  .showroom__canvas:active {
    cursor: grabbing;
  }

  /* --- marcadores ---------------------------------------------------------- */
  .showroom__hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hotspot {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }
  .hotspot[data-hidden] {
    opacity: 0;
    pointer-events: none;
  }
  .hotspot__dot {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin: -0.875rem 0 0 -0.875rem;
    border-radius: 999px;
    border: 1px solid var(--color-hairline);
    background: var(--color-paper);
    color: var(--color-family-sonicacion);
    font: 600 0.8125rem/1 var(--font-mono);
    cursor: pointer;
    box-shadow: 0 0 0 0.375rem rgb(29 79 124 / 0.12);
  }
  .hotspot__dot[aria-expanded='true'] {
    background: var(--color-family-sonicacion);
    border-color: var(--color-family-sonicacion);
    color: var(--color-paper);
  }
  .hotspot__dot:focus-visible {
    outline: 2px solid var(--color-teal-700);
    outline-offset: 3px;
  }
  .hotspot__note {
    position: absolute;
    left: 1.5rem;
    top: -0.75rem;
    width: 15rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-hairline);
    background: var(--color-paper);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-ink-600);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-0.25rem);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }
  .hotspot__title {
    color: var(--color-ink-950);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .hotspot__dot[aria-expanded='true'] + .hotspot__note,
  .hotspot__dot:hover + .hotspot__note {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* --- controles ----------------------------------------------------------- */
  .showroom__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-hairline);
  }
  .showroom__bar[hidden] {
    display: none;
  }
  .showroom__power,
  .showroom__view {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink-800);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  .showroom__power[aria-pressed='true'] {
    background: var(--color-ink-950);
    border-color: var(--color-ink-950);
    color: var(--color-paper);
  }
  .showroom__led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-hairline);
  }
  .showroom__power[aria-pressed='true'] .showroom__led {
    background: var(--color-teal-500);
  }
  .showroom__views {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .showroom__view[aria-pressed='true'] {
    border-color: var(--color-ink-950);
    color: var(--color-ink-950);
  }
  .showroom__power:focus-visible,
  .showroom__view:focus-visible {
    outline: 2px solid var(--color-teal-700);
    outline-offset: 2px;
  }
  .showroom__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-ink-500);
  }
  .showroom__model {
    color: var(--color-ink-800);
  }

  @media (prefers-reduced-motion: reduce) {
    .showroom__photo,
    .showroom__canvas,
    .hotspot,
    .hotspot__note {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Carga la escena 3D sólo cuando sirve: con WebGL, sin movimiento reducido y
   * con la figura cerca de la pantalla. Hasta su primer cuadro la fotografía
   * oficial sigue visible, de modo que un fallo de carga deja la portada como
   * estaba y no en blanco.
   */
  const figure = document.querySelector<HTMLElement>('[data-showroom]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function webglAvailable() {
    try {
      const probe = document.createElement('canvas');
      return Boolean(probe.getContext('webgl2') || probe.getContext('webgl'));
    } catch {
      return false;
    }
  }

  if (figure && !reduced && webglAvailable()) {
    const canvas = figure.querySelector<HTMLCanvasElement>('[data-showroom-canvas]')!;
    const hotspotLayer = figure.querySelector<HTMLElement>('[data-showroom-hotspots]')!;
    const bar = figure.querySelector<HTMLElement>('[data-showroom-bar]')!;
    const power = figure.querySelector<HTMLButtonElement>('[data-showroom-power]')!;
    const powerLabel = figure.querySelector<HTMLElement>('[data-power-label]')!;
    const mode = figure.querySelector<HTMLElement>('[data-showroom-mode]')!;
    const viewButtons = Array.from(figure.querySelectorAll<HTMLButtonElement>('[data-showroom-view]'));
    const spots = Array.from(figure.querySelectorAll<HTMLElement>('.hotspot'));

    const boot = async () => {
      try {
        await document.fonts.ready;
        const { createShowroom } = await import('../../lib/showroom/scene');
        canvas.hidden = false;
        const room = createShowroom(canvas);
        type View = Parameters<typeof room.goTo>[0];

        const setView = (id: View) => {
          room.goTo(id);
          for (const button of viewButtons) button.setAttribute('aria-pressed', String(button.dataset.showroomView === id));
        };
        for (const button of viewButtons) button.addEventListener('click', () => setView(button.dataset.showroomView as View));

        power.addEventListener('click', () => {
          const on = power.getAttribute('aria-pressed') !== 'true';
          power.setAttribute('aria-pressed', String(on));
          powerLabel.textContent = on ? 'Apagar' : 'Encender';
          room.setPower(on);
        });

        for (const spot of spots) {
          const dot = spot.querySelector<HTMLButtonElement>('.hotspot__dot')!;
          dot.addEventListener('click', () => {
            const open = dot.getAttribute('aria-expanded') === 'true';
            for (const other of spots) other.querySelector('.hotspot__dot')!.setAttribute('aria-expanded', 'false');
            if (!open) {
              dot.setAttribute('aria-expanded', 'true');
              setView(dot.dataset.view as View);
            }
          });
        }

        let first = true;
        room.onFrame((anchors) => {
          for (const spot of spots) {
            const at = anchors[spot.dataset.anchor as keyof typeof anchors];
            spot.toggleAttribute('data-hidden', !at);
            if (at) spot.style.transform = `translate(${at.x.toFixed(1)}px, ${at.y.toFixed(1)}px)`;
          }
          if (first) {
            first = false;
            figure.setAttribute('data-ready', '');
            hotspotLayer.hidden = false;
            bar.hidden = false;
            mode.textContent = 'Modelo 3D con las medidas del plano oficial · arrastre para girar';
          }
        });
      } catch (error) {
        canvas.hidden = true;
        console.warn('Sala 3D no disponible; queda la fotografía.', error);
      }
    };

    const near = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          near.disconnect();
          void boot();
        }
      },
      { rootMargin: '200px' },
    );
    near.observe(figure);
  }
</script>

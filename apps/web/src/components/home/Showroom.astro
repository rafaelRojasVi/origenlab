---
import ModelPhoto from '../ui/ModelPhoto.astro';
import { imageForModel, imageForProduct } from '../../data/productImages';
import { showroomEntry } from '../../lib/showroom/catalog';

/**
 * Sala de equipo: un equipo modelado en 3D sobre su fotografía oficial.
 *
 * Cada modelo está construido en código con las medidas de la documentación
 * del fabricante (`src/lib/showroom/models/`). Se puede girar, poner en marcha
 * y recorrer por vistas, y unos marcadores numerados explican sus partes.
 *
 * Mejora progresiva estricta. Lo que llega en el HTML es la fotografía oficial
 * del equipo, con su fila VERIFIED, y el pie. La escena 3D sólo se carga si hay
 * WebGL, si el visitante no pidió movimiento reducido y cuando la figura está
 * cerca de la pantalla; hasta que dibuja su primer cuadro, la foto sigue ahí.
 * Sin JavaScript, queda exactamente la foto.
 *
 * Los textos y las cifras de los marcadores no se escriben aquí: vienen de
 * `src/lib/showroom/content/<id>.ts`, que los lee de los datos con fuente.
 */
interface Props {
  id: string;
}
const entry = showroomEntry(Astro.props.id);
const image = entry && ('modelId' in entry.photo ? imageForModel(entry.photo.modelId) : imageForProduct(entry.photo.productId));
const hotspots = (entry?.hotspots ?? []).filter((spot) => spot.body.length > 0).map((spot, index) => ({ ...spot, numeral: index + 1 }));
const domId = (part: string) => `sala-${entry?.id}-${part}`;
---

{
  entry && image && (
    <figure class="showroom" data-showroom={entry.id} aria-labelledby={domId('pie')}>
      <div class="showroom__stage">
        <div class="showroom__photo" data-showroom-photo>
          <ModelPhoto image={image} size="hero" priority ratio="4 / 5" />
        </div>
        <canvas class="showroom__canvas" data-showroom-canvas aria-hidden="true" hidden />
        <div class="showroom__hotspots" data-showroom-hotspots hidden>
          {hotspots.map((spot) => (
            <div class="hotspot" data-anchor={spot.anchor}>
              <button
                type="button"
                class="hotspot__dot"
                aria-expanded="false"
                aria-controls={domId(spot.anchor)}
                data-view={spot.view}
              >
                <span aria-hidden="true">{spot.numeral}</span>
                <span class="sr-only">{spot.title}</span>
              </button>
              <div class="hotspot__note" id={domId(spot.anchor)} role="note">
                <p class="hotspot__title">{spot.title}</p>
                {spot.body.map((line) => <p>{line}</p>)}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="showroom__bar" data-showroom-bar hidden>
        {entry.power ? (
          <button type="button" class="showroom__power" data-showroom-power aria-pressed="false" data-on={entry.power.on} data-off={entry.power.off}>
            <span class="showroom__led" aria-hidden="true" />
            <span data-power-label>{entry.power.on}</span>
          </button>
        ) : <span />}
        <div class="showroom__views" role="group" aria-label="Vistas del equipo">
          {entry.views.map((view, index) => (
            <button type="button" class="showroom__view" data-showroom-view={view.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              {view.label}
            </button>
          ))}
        </div>
      </div>

      <figcaption class="showroom__caption t-data" id={domId('pie')}>
        <span class="showroom__model">{entry.brand} {entry.name}</span>
        <span>{entry.kind}</span>
        <span class="showroom__mode" data-showroom-mode>Fotografía oficial del fabricante</span>
      </figcaption>
    </figure>
  )
}

<style>
  .showroom {
    margin: 0;
  }
  .showroom__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 44rem;
    width: 100%;
  }
  .showroom__photo,
  .showroom__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .showroom__photo {
    transition: opacity 0.6s ease;
  }
  .showroom__photo :global(.model-photo__frame) {
    height: 100%;
    aspect-ratio: auto !important;
  }
  .showroom[data-ready] .showroom__photo {
    opacity: 0;
    pointer-events: none;
  }
  .showroom__canvas {
    display: block;
    cursor: grab;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .showroom[data-ready] .showroom__canvas {
    opacity: 1;
  }
  .showroom__canvas:active {
    cursor: grabbing;
  }

  /* --- marcadores ---------------------------------------------------------- */
  .showroom__hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hotspot {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }
  .hotspot[data-hidden] {
    opacity: 0;
    pointer-events: none;
  }
  .hotspot__dot {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin: -0.875rem 0 0 -0.875rem;
    border-radius: 999px;
    border: 1px solid var(--color-hairline);
    background: var(--color-paper);
    color: var(--color-family-sonicacion);
    font: 600 0.8125rem/1 var(--font-mono);
    cursor: pointer;
    box-shadow: 0 0 0 0.375rem rgb(29 79 124 / 0.12);
  }
  .hotspot__dot[aria-expanded='true'] {
    background: var(--color-family-sonicacion);
    border-color: var(--color-family-sonicacion);
    color: var(--color-paper);
  }
  .hotspot__dot:focus-visible {
    outline: 2px solid var(--color-teal-700);
    outline-offset: 3px;
  }
  .hotspot__note {
    position: absolute;
    left: 1.5rem;
    top: -0.75rem;
    width: 15rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-hairline);
    background: var(--color-paper);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-ink-600);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-0.25rem);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }
  .hotspot__title {
    color: var(--color-ink-950);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .hotspot__dot[aria-expanded='true'] + .hotspot__note,
  .hotspot__dot:hover + .hotspot__note {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* --- controles ----------------------------------------------------------- */
  .showroom__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-hairline);
  }
  .showroom__bar[hidden] {
    display: none;
  }
  .showroom__power,
  .showroom__view {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink-800);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  .showroom__power[aria-pressed='true'] {
    background: var(--color-ink-950);
    border-color: var(--color-ink-950);
    color: var(--color-paper);
  }
  .showroom__led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-hairline);
  }
  .showroom__power[aria-pressed='true'] .showroom__led {
    background: var(--color-teal-500);
  }
  .showroom__views {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .showroom__view[aria-pressed='true'] {
    border-color: var(--color-ink-950);
    color: var(--color-ink-950);
  }
  .showroom__power:focus-visible,
  .showroom__view:focus-visible {
    outline: 2px solid var(--color-teal-700);
    outline-offset: 2px;
  }
  .showroom__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-ink-500);
  }
  .showroom__model {
    color: var(--color-ink-800);
  }

  @media (prefers-reduced-motion: reduce) {
    .showroom__photo,
    .showroom__canvas,
    .hotspot,
    .hotspot__note {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Carga cada escena 3D sólo cuando sirve: con WebGL, sin movimiento reducido
   * y con la figura cerca de la pantalla. Hasta su primer cuadro la fotografía
   * oficial sigue visible, de modo que un fallo de carga deja la página como
   * estaba y no en blanco. Vale para una sala o para varias en la misma página.
   */
  import { modelLoaders } from '../../lib/showroom/loaders';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function webglAvailable() {
    try {
      const probe = document.createElement('canvas');
      return Boolean(probe.getContext('webgl2') || probe.getContext('webgl'));
    } catch {
      return false;
    }
  }

  async function boot(figure: HTMLElement) {
    const id = figure.dataset.showroom ?? '';
    const load = modelLoaders[id];
    if (!load) return;
    const canvas = figure.querySelector<HTMLCanvasElement>('[data-showroom-canvas]')!;
    const hotspotLayer = figure.querySelector<HTMLElement>('[data-showroom-hotspots]')!;
    const bar = figure.querySelector<HTMLElement>('[data-showroom-bar]')!;
    const power = figure.querySelector<HTMLButtonElement>('[data-showroom-power]');
    const powerLabel = figure.querySelector<HTMLElement>('[data-power-label]');
    const mode = figure.querySelector<HTMLElement>('[data-showroom-mode]')!;
    const viewButtons = Array.from(figure.querySelectorAll<HTMLButtonElement>('[data-showroom-view]'));
    const spots = Array.from(figure.querySelectorAll<HTMLElement>('.hotspot'));
    try {
      await document.fonts.ready;
      const [{ createShowroom }, module] = await Promise.all([import('../../lib/showroom/scene'), load()]);
      canvas.hidden = false;
      const room = createShowroom(canvas, module.build());

      const setView = (view: string) => {
        room.goTo(view);
        for (const button of viewButtons) button.setAttribute('aria-pressed', String(button.dataset.showroomView === view));
      };
      for (const button of viewButtons) button.addEventListener('click', () => setView(button.dataset.showroomView ?? 'general'));

      power?.addEventListener('click', () => {
        const on = power.getAttribute('aria-pressed') !== 'true';
        power.setAttribute('aria-pressed', String(on));
        if (powerLabel) powerLabel.textContent = (on ? power.dataset.off : power.dataset.on) ?? '';
        room.setPower(on);
      });

      for (const spot of spots) {
        const dot = spot.querySelector<HTMLButtonElement>('.hotspot__dot')!;
        dot.addEventListener('click', () => {
          const open = dot.getAttribute('aria-expanded') === 'true';
          for (const other of spots) other.querySelector('.hotspot__dot')!.setAttribute('aria-expanded', 'false');
          if (!open) {
            dot.setAttribute('aria-expanded', 'true');
            setView(dot.dataset.view ?? 'general');
          }
        });
      }

      let first = true;
      room.onFrame((anchors) => {
        for (const spot of spots) {
          const at = anchors[spot.dataset.anchor ?? ''];
          spot.toggleAttribute('data-hidden', !at);
          if (at) spot.style.transform = `translate(${at.x.toFixed(1)}px, ${at.y.toFixed(1)}px)`;
        }
        if (first) {
          first = false;
          figure.setAttribute('data-ready', '');
          hotspotLayer.hidden = false;
          bar.hidden = false;
          mode.textContent = 'Modelo 3D con las medidas del fabricante · arrastre para girar';
        }
      });
    } catch (error) {
      canvas.hidden = true;
      console.warn(`Sala 3D «${id}» no disponible; queda la fotografía.`, error);
    }
  }

  if (!reduced && webglAvailable()) {
    const near = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          near.unobserve(entry.target);
          void boot(entry.target as HTMLElement);
        }
      },
      { rootMargin: '200px' },
    );
    for (const figure of document.querySelectorAll<HTMLElement>('[data-showroom]')) near.observe(figure);
  }
</script>

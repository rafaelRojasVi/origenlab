---
import ModelPhoto from '../ui/ModelPhoto.astro';
import { imageForModel, imageForProduct } from '../../data/productImages';
import { showroomEntry } from '../../lib/showroom/catalog';
import type { ShowroomEntry } from '../../lib/showroom/content/types';

/**
 * Sala de equipo: equipos modelados en 3D sobre su fotografía oficial.
 *
 * Cada modelo está construido en código con las medidas de la documentación
 * del fabricante (`src/lib/showroom/models/`). Se puede girar, poner en marcha
 * y recorrer por vistas, y unos marcadores numerados explican sus partes.
 *
 * Con `id` muestra un equipo. Con `items` muestra varios en un solo escenario:
 * una fila de tareas («Sonicar», «Pesar»…) elige cuál, y el equipo cambia en
 * el mismo lienzo. Un solo WebGL dibuja a la vez, y cada modelo se descarga
 * sólo cuando se elige.
 *
 * Mejora progresiva estricta. Lo que llega en el HTML es la fotografía oficial
 * del equipo, con su fila VERIFIED, y el pie; sin 3D, la fila de tareas cambia
 * la fotografía. La escena 3D sólo se carga si hay WebGL, si el visitante no
 * pidió movimiento reducido ni ahorro de datos, si el dispositivo no declara
 * poca memoria y cuando la figura está cerca de la pantalla; hasta que dibuja
 * su primer cuadro, la foto sigue ahí.
 *
 * Los textos y las cifras de los marcadores no se escriben aquí: vienen de
 * `src/lib/showroom/content/<id>.ts`, que los lee de los datos con fuente.
 */
interface Props {
  id?: string;
  items?: { id: string; task: string }[];
}
const picks = Astro.props.items ?? (Astro.props.id ? [{ id: Astro.props.id, task: '' }] : []);
const entries = picks
  .map((pick) => ({ pick, entry: showroomEntry(pick.id) }))
  .filter((item): item is { pick: { id: string; task: string }; entry: ShowroomEntry } => Boolean(item.entry))
  .map(({ pick, entry }) => ({
    entry,
    task: pick.task,
    image: 'modelId' in entry.photo ? imageForModel(entry.photo.modelId) : imageForProduct(entry.photo.productId),
    hotspots: entry.hotspots.filter((spot) => spot.body.length > 0).map((spot, index) => ({ ...spot, numeral: index + 1 })),
  }))
  .filter((item) => item.image);
const selector = entries.length > 1;
const first = entries[0];
const domId = (entryId: string, part: string) => `sala-${entryId}-${part}`;
---

{
  first && (
    <figure
      class:list={['showroom', { 'showroom--selector': selector }]}
      data-showroom={selector ? 'selector' : first.entry.id}
      data-active={first.entry.id}
      aria-labelledby={domId(first.entry.id, 'pie')}
    >
      {selector && (
        <div class="showroom__tasks" role="group" aria-label="Elija una tarea de laboratorio">
          {entries.map((item, index) => (
            <button type="button" class="showroom__task" data-pick={item.entry.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              {item.task}
            </button>
          ))}
        </div>
      )}
      <div class="showroom__stage">
        {entries.map((item, index) => (
          <div class="showroom__photo" data-showroom-photo data-entry={item.entry.id} hidden={index > 0}>
            <ModelPhoto image={item.image} size="hero" priority={index === 0} ratio="4 / 5" />
          </div>
        ))}
        <canvas class="showroom__canvas" data-showroom-canvas aria-hidden="true" hidden />
        {entries.map((item) => (
          <div class="showroom__hotspots" data-showroom-hotspots data-entry={item.entry.id} hidden>
            {item.hotspots.map((spot) => (
              <div class="hotspot" data-anchor={spot.anchor}>
                <button
                  type="button"
                  class="hotspot__dot"
                  aria-expanded="false"
                  aria-controls={domId(item.entry.id, spot.anchor)}
                  data-view={spot.view}
                >
                  <span aria-hidden="true">{spot.numeral}</span>
                  <span class="sr-only">{spot.title}</span>
                </button>
                <div class="hotspot__note" id={domId(item.entry.id, spot.anchor)} role="note">
                  <p class="hotspot__title">{spot.title}</p>
                  {spot.body.map((line) => <p>{line}</p>)}
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>

      {entries.map((item) => (
        <div class="showroom__bar" data-showroom-bar data-entry={item.entry.id} hidden>
          {item.entry.power ? (
            <button type="button" class="showroom__power" data-showroom-power aria-pressed="false" data-on={item.entry.power.on} data-off={item.entry.power.off}>
              <span class="showroom__led" aria-hidden="true" />
              <span data-power-label>{item.entry.power.on}</span>
            </button>
          ) : <span />}
          <div class="showroom__views" role="group" aria-label="Vistas del equipo">
            {item.entry.views.map((view, index) => (
              <button type="button" class="showroom__view" data-showroom-view={view.id} aria-pressed={index === 0 ? 'true' : 'false'}>
                {view.label}
              </button>
            ))}
          </div>
        </div>
      ))}

      {entries.map((item, index) => (
        <figcaption class="showroom__caption t-data" id={domId(item.entry.id, 'pie')} data-entry={item.entry.id} hidden={index > 0}>
          <span class="showroom__model">{item.entry.brand} {item.entry.name}</span>
          <span>{item.entry.kind}</span>
          <span class="showroom__mode" data-showroom-mode>Fotografía oficial del fabricante</span>
        </figcaption>
      ))}
    </figure>
  )
}

<style>
  .showroom {
    margin: 0;
  }
  .showroom__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 44rem;
    width: 100%;
  }
  .showroom__photo,
  .showroom__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .showroom__photo {
    transition: opacity 0.6s ease;
  }
  /* La figura y su caja llenan el escenario: con alto automático la caja medía
     0 px y la foto de respaldo quedaba reducida a su relleno. */
  .showroom__photo :global(.model-photo),
  .showroom__photo :global(.model-photo__frame) {
    height: 100%;
    aspect-ratio: auto !important;
  }
  .showroom[data-ready] .showroom__photo {
    opacity: 0;
    pointer-events: none;
  }
  .showroom__canvas {
    display: block;
    cursor: grab;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .showroom[data-ready] .showroom__canvas {
    opacity: 1;
  }
  .showroom__canvas:active {
    cursor: grabbing;
  }

  /* --- marcadores ---------------------------------------------------------- */
  .showroom__hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hotspot {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }
  .hotspot[data-hidden] {
    opacity: 0;
    pointer-events: none;
  }
  .hotspot__dot {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin: -0.875rem 0 0 -0.875rem;
    border-radius: 999px;
    border: 1px solid var(--color-hairline);
    background: var(--color-paper);
    color: var(--color-family-sonicacion);
    font: 600 0.8125rem/1 var(--font-mono);
    cursor: pointer;
    box-shadow: 0 0 0 0.375rem rgb(29 79 124 / 0.12);
  }
  .hotspot__dot[aria-expanded='true'] {
    background: var(--color-family-sonicacion);
    border-color: var(--color-family-sonicacion);
    color: var(--color-paper);
  }
  .hotspot__dot:focus-visible {
    outline: 2px solid var(--color-teal-700);
    outline-offset: 3px;
  }
  .hotspot__note {
    position: absolute;
    left: 1.5rem;
    top: -0.75rem;
    width: 15rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-hairline);
    background: var(--color-paper);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-ink-600);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-0.25rem);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }
  .hotspot__title {
    color: var(--color-ink-950);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .hotspot__dot[aria-expanded='true'] + .hotspot__note,
  .hotspot__dot:hover + .hotspot__note {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* --- controles ----------------------------------------------------------- */
  .showroom__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-hairline);
  }
  .showroom__bar[hidden] {
    display: none;
  }
  .showroom__power,
  .showroom__view {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink-800);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  .showroom__power[aria-pressed='true'] {
    background: var(--color-ink-950);
    border-color: var(--color-ink-950);
    color: var(--color-paper);
  }
  .showroom__led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-hairline);
  }
  .showroom__power[aria-pressed='true'] .showroom__led {
    background: var(--color-teal-500);
  }
  .showroom__views {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .showroom__view[aria-pressed='true'] {
    border-color: var(--color-ink-950);
    color: var(--color-ink-950);
  }
  .showroom__power:focus-visible,
  .showroom__view:focus-visible {
    outline: 2px solid var(--color-teal-700);
    outline-offset: 2px;
  }
  .showroom__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-ink-500);
  }
  .showroom__model {
    color: var(--color-ink-800);
  }

  @media (prefers-reduced-motion: reduce) {
    .showroom__photo,
    .showroom__canvas,
    .hotspot,
    .hotspot__note {
      transition: none;
    }
  }

  /* --- selector de tareas -------------------------------------------------- */
  .showroom__tasks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }
  .showroom__task {
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink-600);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .showroom__task:hover {
    color: var(--color-ink-950);
    border-color: var(--color-ink-600);
  }
  .showroom__task[aria-pressed='true'] {
    background: var(--color-ink-950);
    border-color: var(--color-ink-950);
    color: var(--color-paper);
  }
  .showroom__task:focus-visible {
    outline: 2px solid var(--color-teal-700);
    outline-offset: 2px;
  }
  .showroom__canvas {
    transition: opacity 0.35s ease;
  }
  .showroom[data-swapping] .showroom__canvas {
    opacity: 0 !important;
  }
</style>

<script>
  /**
   * Carga la escena 3D sólo cuando sirve: con WebGL, sin movimiento reducido ni
   * ahorro de datos, sin poca memoria declarada y con la figura cerca de la
   * pantalla. Hasta su primer cuadro la fotografía oficial sigue visible, de
   * modo que un fallo de carga deja la página como estaba y no en blanco.
   *
   * Con selector, el equipo elegido cambia en el mismo lienzo: un solo WebGL.
   * Sin 3D, el selector cambia la fotografía.
   */
  import { modelLoaders } from '../../lib/showroom/loaders';
  import type { Showroom } from '../../lib/showroom/scene';

  type Nav = Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
  const nav = navigator as Nav;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lowEnd = (nav.deviceMemory !== undefined && nav.deviceMemory < 4) || nav.connection?.saveData === true;

  function webglAvailable() {
    try {
      const probe = document.createElement('canvas');
      return Boolean(probe.getContext('webgl2') || probe.getContext('webgl'));
    } catch {
      return false;
    }
  }
  const use3d = !reduced && !lowEnd && webglAvailable();

  function setup(figure: HTMLElement) {
    const canvas = figure.querySelector<HTMLCanvasElement>('[data-showroom-canvas]')!;
    const tasks = Array.from(figure.querySelectorAll<HTMLButtonElement>('[data-pick]'));
    const part = (selector: string, id: string) => figure.querySelector<HTMLElement>(`${selector}[data-entry="${id}"]`);
    let active = figure.dataset.active ?? '';
    let room: Showroom | null = null;
    let ready = false;
    let loading = 0;

    const show = (id: string) => {
      for (const el of figure.querySelectorAll<HTMLElement>('[data-entry]')) {
        const mine = el.dataset.entry === id;
        // Con 3D, la foto ya no se muestra; los marcadores y la barra sólo con 3D.
        if (el.matches('[data-showroom-photo]')) el.hidden = !mine || ready;
        else if (el.matches('[data-showroom-hotspots], [data-showroom-bar]')) el.hidden = !mine || !ready;
        else el.hidden = !mine;
      }
      for (const button of tasks) button.setAttribute('aria-pressed', String(button.dataset.pick === id));
      figure.dataset.active = id;
      figure.setAttribute('aria-labelledby', `sala-${id}-pie`);
    };

    const resetControls = (id: string) => {
      const bar = part('[data-showroom-bar]', id);
      const power = bar?.querySelector<HTMLButtonElement>('[data-showroom-power]');
      const label = power?.querySelector<HTMLElement>('[data-power-label]');
      if (power && label) {
        power.setAttribute('aria-pressed', 'false');
        label.textContent = power.dataset.on ?? '';
      }
      for (const button of bar?.querySelectorAll<HTMLButtonElement>('[data-showroom-view]') ?? []) {
        button.setAttribute('aria-pressed', String(button.dataset.showroomView === 'general'));
      }
      for (const dot of part('[data-showroom-hotspots]', id)?.querySelectorAll('.hotspot__dot') ?? []) dot.setAttribute('aria-expanded', 'false');
    };

    // Controles: cada barra y cada capa de marcadores actúa sobre la escena
    // sólo mientras su equipo es el elegido.
    for (const bar of figure.querySelectorAll<HTMLElement>('[data-showroom-bar]')) {
      const id = bar.dataset.entry ?? '';
      const views = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-showroom-view]'));
      const setView = (view: string) => {
        if (active !== id || !room) return;
        room.goTo(view);
        for (const button of views) button.setAttribute('aria-pressed', String(button.dataset.showroomView === view));
      };
      for (const button of views) button.addEventListener('click', () => setView(button.dataset.showroomView ?? 'general'));
      const power = bar.querySelector<HTMLButtonElement>('[data-showroom-power]');
      const label = power?.querySelector<HTMLElement>('[data-power-label]');
      power?.addEventListener('click', () => {
        if (active !== id || !room) return;
        const on = power.getAttribute('aria-pressed') !== 'true';
        power.setAttribute('aria-pressed', String(on));
        if (label) label.textContent = (on ? power.dataset.off : power.dataset.on) ?? '';
        room.setPower(on);
      });
      const spots = Array.from(part('[data-showroom-hotspots]', id)?.querySelectorAll<HTMLElement>('.hotspot') ?? []);
      for (const spot of spots) {
        const dot = spot.querySelector<HTMLButtonElement>('.hotspot__dot')!;
        dot.addEventListener('click', () => {
          const open = dot.getAttribute('aria-expanded') === 'true';
          for (const other of spots) other.querySelector('.hotspot__dot')!.setAttribute('aria-expanded', 'false');
          if (!open) {
            dot.setAttribute('aria-expanded', 'true');
            setView(dot.dataset.view ?? 'general');
          }
        });
      }
    }

    const onFrame = (anchors: Record<string, { x: number; y: number } | null>) => {
      const layer = part('[data-showroom-hotspots]', active);
      for (const spot of layer?.querySelectorAll<HTMLElement>('.hotspot') ?? []) {
        const at = anchors[spot.dataset.anchor ?? ''];
        spot.toggleAttribute('data-hidden', !at);
        if (at) spot.style.transform = `translate(${at.x.toFixed(1)}px, ${at.y.toFixed(1)}px)`;
      }
      if (!ready) {
        ready = true;
        figure.setAttribute('data-ready', '');
        for (const mode of figure.querySelectorAll<HTMLElement>('[data-showroom-mode]')) {
          mode.textContent = 'Modelo 3D con las medidas del fabricante · arrastre para girar';
        }
        show(active);
      }
    };

    const boot = async () => {
      const load = modelLoaders[active];
      if (!load) return;
      try {
        await document.fonts.ready;
        const [{ createShowroom }, module] = await Promise.all([import('../../lib/showroom/scene'), load()]);
        canvas.hidden = false;
        room = createShowroom(canvas, module.build());
        room.onFrame(onFrame);
      } catch (error) {
        canvas.hidden = true;
        console.warn('Sala 3D no disponible; queda la fotografía.', error);
      }
    };

    const pick = async (id: string) => {
      if (id === active) return;
      const previous = active;
      active = id;
      show(id);
      resetControls(id);
      if (!room || !modelLoaders[id]) return;
      const ticket = ++loading;
      figure.setAttribute('data-swapping', '');
      try {
        const [module] = await Promise.all([modelLoaders[id](), new Promise((done) => setTimeout(done, 350))]);
        if (ticket !== loading) return;
        room.setModel(module.build());
      } catch (error) {
        console.warn(`Sala 3D «${id}» no disponible.`, error);
        active = previous;
        show(previous);
      } finally {
        if (ticket === loading) figure.removeAttribute('data-swapping');
      }
    };
    for (const button of tasks) button.addEventListener('click', () => void pick(button.dataset.pick ?? ''));

    if (use3d) {
      const near = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            near.disconnect();
            void boot();
          }
        },
        { rootMargin: '200px' },
      );
      near.observe(figure);
    }
  }

  for (const figure of document.querySelectorAll<HTMLElement>('[data-showroom]')) setup(figure);
</script>

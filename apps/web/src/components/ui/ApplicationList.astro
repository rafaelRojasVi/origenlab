---
import Icon from './Icon.astro';
import { categories } from '../../data/categories';

/**
 * Las tres líneas comerciales como lista numerada. Se usa en la portada y en el
 * índice de aplicaciones; el numeral es contenido (son tres líneas concretas del
 * negocio), no la etiqueta estructural de SectionIndex.
 */
interface Props {
  /** Tamaño del nombre de cada línea. */
  size?: 'lg' | 'md';
  class?: string;
  [key: string]: unknown;
}

const { size = 'md', class: className = '', ...rest } = Astro.props;
---

<ol class:list={['line-list', `line-list--${size}`, className]} {...rest}>
  {
    categories.map((category, i) => (
      <li>
        <a href={`/categorias/${category.slug}/`}>
          <span class="line-list__num t-data" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="line-list__body">
            <span class="line-list__name">{category.shortName}</span>
            <span class="line-list__desc t-small">{category.description}</span>
          </span>
          <span class="line-list__go" aria-hidden="true">
            <Icon name="arrow-right" size={20} />
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .line-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-ink-950);
  }
  .line-list li {
    border-bottom: 1px solid var(--color-hairline);
  }
  .line-list a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.5rem;
    transition: background-color 150ms;
  }
  .line-list a:hover {
    background-color: var(--color-surface);
  }
  .line-list__num {
    color: var(--color-ink-500);
    font-size: 0.8125rem;
  }
  .line-list__name {
    display: block;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-ink-950);
    letter-spacing: -0.015em;
  }
  .line-list--lg .line-list__name {
    font-size: 1.5rem;
  }
  .line-list__desc {
    display: block;
    margin-top: 0.375rem;
    color: var(--color-ink-600);
    max-width: 56ch;
  }
  .line-list__go {
    align-self: center;
    justify-self: end;
    color: var(--color-ink-500);
  }
  .line-list a:hover .line-list__go {
    color: var(--color-teal-800);
  }
  @media (min-width: 768px) {
    .line-list a {
      grid-template-columns: 3.5rem minmax(0, 1fr) 2rem;
      gap: 2rem;
      padding-block: 2rem;
    }
    .line-list--lg a {
      padding-block: 2.25rem;
    }
  }
</style>

---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site } from '../../config/site';
import { buildWhatsAppQuoteUrl } from '../../lib/whatsapp';
import { ctaLabels } from '../../lib/ctaLabels';

/**
 * Banda de cierre (tablero HomeA): la banda elevada (`--color-band`, grafito con
 * velo teal y un foco suave arriba a la izquierda) dentro de los márgenes de la
 * página, con el titular a la izquierda y las dos acciones apiladas a la
 * derecha. Conserva `.band` (qa:contrast la mide) y `.on-ink`.
 *
 * El correo y el teléfono ya no se repiten aquí: viven en el pie.
 *
 * `primary` decide cuál de las dos acciones lleva el relleno: el formulario de
 * cotización (por omisión, y siempre en la portada) o WhatsApp.
 */
interface Props {
  title: string;
  body: string;
  /** Contexto para prellenar el mensaje de WhatsApp. */
  productName?: string;
  brandName?: string;
  /** Destino del botón; las páginas de modelo llevan el modelo (`/contacto/?producto=<slug>`). */
  quoteHref?: string;
  primary?: 'quote' | 'whatsapp';
  /**
   * Slug del modelo en las páginas de modelo. Sólo ahí el escucha de clics de
   * `ModelHero` (medición propia, `lib/stats.ts`) cuenta los botones de la banda.
   */
  modelo?: string;
}

const { title, body, productName, brandName, quoteHref = site.quoteHref, primary = 'quote', modelo } = Astro.props;
const whatsappHref = buildWhatsAppQuoteUrl({ productName, brandName });
const whatsappFirst = primary === 'whatsapp';
---

<section class="shell band-wrap" aria-labelledby="band-title">
  <div class="band on-ink rv">
    <div>
      <h2 id="band-title" class="band__title">{title}</h2>
      <p class="band__body">{body}</p>
    </div>
    <div class="band__actions">
      {
        whatsappFirst ? (
          <>
            <Button href={whatsappHref} tone="ink" external arrow={false} track="whatsapp_click" modelo={modelo}>
              <Icon name="whatsapp" size={18} />
              {ctaLabels.escribirWhatsapp}
            </Button>
            <Button href={quoteHref} variant="secondary" tone="ink" track="cotizacion_click" modelo={modelo}>
              {ctaLabels.solicitarCotizacion}
            </Button>
          </>
        ) : (
          <>
            <Button href={quoteHref} tone="ink" track="cotizacion_click" modelo={modelo}>
              {ctaLabels.solicitarCotizacion}
            </Button>
            <Button href={whatsappHref} variant="whatsapp" tone="ink" external track="whatsapp_click" modelo={modelo}>
              {ctaLabels.escribirWhatsapp}
            </Button>
          </>
        )
      }
    </div>
  </div>
</section>

<style>
  .band-wrap {
    margin-top: clamp(4rem, 8vw, 8rem);
  }
  .band {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    align-items: end;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 6vw, 5.5rem);
    border: 1px solid var(--color-band-line);
    border-radius: var(--radius-band);
    background:
      radial-gradient(60% 90% at 12% 0%, var(--color-glow), transparent 70%),
      var(--color-band);
    color: var(--color-onink-100);
  }
  .band__title {
    color: var(--color-fg);
    font-size: clamp(2.125rem, 4.6vw, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .band__body {
    max-width: 30em;
    margin-top: 1.25rem;
    color: var(--color-onink-300);
  }
  .band__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  @media (max-width: 1023.98px) {
    .band {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>

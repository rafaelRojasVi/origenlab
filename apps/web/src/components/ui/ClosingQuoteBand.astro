---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site } from '../../config/site';
import { buildWhatsAppQuoteUrl } from '../../lib/whatsapp';
import { ctaLabels } from '../../lib/ctaLabels';

/**
 * Banda de cierre («Blanco con color»): un lavado teal/aqua claro a ancho
 * completo (`.surface-band`) justo antes del pie oscuro, con el titular grande
 * a la izquierda y, a la derecha, la línea y las dos acciones en fila. Texto
 * tinta. Conserva `.band` (qa:contrast la mide).
 *
 * El correo y el teléfono ya no se repiten aquí: viven en el pie.
 *
 * `primary` decide cuál de las dos acciones lleva el relleno: el formulario de
 * cotización (por omisión, y siempre en la portada) o WhatsApp.
 *
 * Slot opcional: una línea bajo las acciones (la ficha de modelo enlaza ahí
 * el ejemplo de cotización, `/como-comprar/#cotizacion`).
 */
interface Props {
  title: string;
  body: string;
  /** Contexto para prellenar el mensaje de WhatsApp. */
  productName?: string;
  brandName?: string;
  /** Destino del botón; las páginas de modelo llevan el modelo (`/contacto/?producto=<slug>`). */
  quoteHref?: string;
  primary?: 'quote' | 'whatsapp';
  /**
   * Slug del modelo en las páginas de modelo. Sólo ahí el escucha de clics de
   * `ModelHero` (medición propia, `lib/stats.ts`) cuenta los botones de la banda.
   */
  modelo?: string;
}

const { title, body, productName, brandName, quoteHref = site.quoteHref, primary = 'quote', modelo } = Astro.props;
const whatsappHref = buildWhatsAppQuoteUrl({ productName, brandName });
const whatsappFirst = primary === 'whatsapp';
---

<section class="band band-wrap surface-band" aria-labelledby="band-title">
  <div class="shell band__in">
    <h2 id="band-title" class="band__title">{title}</h2>
    <div>
      <p class="band__body">{body}</p>
      <div class="band__actions">
        {
          whatsappFirst ? (
            <>
              <Button href={whatsappHref} external arrow={false} track="whatsapp_click" modelo={modelo}>
                <Icon name="whatsapp" size={18} />
                {ctaLabels.escribirWhatsapp}
              </Button>
              <Button href={quoteHref} variant="secondary" track="cotizacion_click" modelo={modelo}>
                {ctaLabels.solicitarCotizacion}
              </Button>
            </>
          ) : (
            <>
              <Button href={quoteHref} track="cotizacion_click" modelo={modelo}>
                {ctaLabels.solicitarCotizacion}
              </Button>
              <Button href={whatsappHref} variant="whatsapp" external track="whatsapp_click" modelo={modelo}>
                {ctaLabels.escribirWhatsapp}
              </Button>
            </>
          )
        }
      </div>
      <slot />
    </div>
  </div>
</section>

<style>
  .band {
    margin-top: clamp(5rem, 10vw, 8rem);
  }
  .band__in {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 2.5rem;
    align-items: end;
    padding-block: clamp(5.25rem, 9vw, 8rem);
  }
  .band__title {
    max-width: 14ch;
    color: var(--color-ink-950);
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .band__body {
    max-width: 32ch;
    color: var(--color-ink-600);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
  }
  .band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .band__actions :global(.btn-whatsapp),
  .band__actions :global(.btn-secondary) {
    background-color: rgb(255 255 255 / 0.5);
  }
  @media (max-width: 1023.98px) {
    .band__in {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }
</style>

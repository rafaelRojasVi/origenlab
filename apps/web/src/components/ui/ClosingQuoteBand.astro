---
import Icon from './Icon.astro';
import { site } from '../../config/site';
import { contact, telUrl } from '../../data/contact';
import { buildWhatsAppQuoteUrl } from '../../lib/whatsapp';
import { ctaLabels } from '../../lib/ctaLabels';
import SectionIndex from './SectionIndex.astro';

/**
 * Banda de cierre. Única superficie invertida de cada página (además del pie).
 * Un solo botón primario; los canales de apoyo van como enlaces de texto.
 */
interface Props {
  /**
   * Numeral del índice de sección. Se omite en la portada, que no se numera:
   * es una portada, no un capítulo del documento.
   */
  index?: number;
  title: string;
  body: string;
  /** Contexto para prellenar el mensaje de WhatsApp. */
  productName?: string;
  brandName?: string;
}

const { index, title, body, productName, brandName } = Astro.props;
const whatsappHref = buildWhatsAppQuoteUrl({ productName, brandName });
---

<section class="band on-ink" aria-labelledby="band-title">
  <div class="shell band__inner">
    {index === undefined ? (
      <p class="t-label band__label">Solicitar cotización</p>
    ) : (
      <SectionIndex index={index} label="Solicitar cotización" class="band__index" />
    )}
    <div class="band__grid">
      <div>
        <h2 id="band-title" class="t-h2 band__title">{title}</h2>
        <p class="t-body band__body">{body}</p>
      </div>
      <div class="band__actions">
        <a href={site.quoteHref} class="btn btn-invert">{ctaLabels.solicitarCotizacion}</a>
        <ul class="band__channels">
          <li>
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" size={18} />
              WhatsApp {contact.phoneDisplay}
              <span class="sr-only">(abre WhatsApp en una pestaña nueva)</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${contact.email}`}>
              <Icon name="mail" size={18} />
              {contact.email}
            </a>
          </li>
          <li>
            <a href={telUrl()}>
              <Icon name="phone" size={18} />
              {contact.phoneDisplay}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    background-color: var(--color-ink-950);
    color: var(--color-onink-100);
    margin-top: 6rem;
  }
  .band__inner {
    padding-block: 4rem;
  }
  .band__index :global(.section-index__rule) {
    background-color: var(--color-onink-hairline);
  }
  .band__index :global(.section-index__numeral) {
    color: var(--color-teal-500);
  }
  .band__index {
    color: var(--color-onink-500);
  }
  .band__label {
    margin-bottom: 1.5rem;
    color: var(--color-onink-500);
  }
  @media (min-width: 768px) {
    .band__label {
      margin-bottom: 2rem;
    }
  }
  .band__title {
    color: #fff;
  }
  .band__body {
    margin-top: 1rem;
    color: var(--color-onink-300);
    max-width: 46ch;
  }
  .band__grid {
    display: grid;
    gap: 2.5rem;
  }
  .band__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }
  .band__channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .band__channels a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.5rem;
    font-size: 0.9375rem;
    color: var(--color-onink-300);
    transition: color 150ms;
  }
  .band__channels a:hover {
    color: #fff;
  }
  @media (min-width: 768px) {
    .band {
      margin-top: 8rem;
    }
    .band__inner {
      padding-block: 5.5rem;
    }
    .band__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4rem;
      align-items: start;
    }
  }
</style>

---
import { applications } from '../../data/applications';
import { publicClaim } from '../../data/claims';
import { industries } from '../../data/industries';
import { familyInfo, type FamilySlug } from '../../lib/modelos';

/**
 * Industrias en seis tiles de texto (portada y /aplicaciones/, dueña
 * 2026-11-08): el sector, una línea con lo que hace con nuestros equipos y
 * «Ver equipos →» hacia el bloque de su aplicación en /aplicaciones/. Sin
 * miniaturas ni nombres de producto.
 *
 * - Orden (marketing, 2026-11-08): alimentos y agro primero, después los
 *   compradores de industria y al final la academia y el sector público.
 * - Línea: el nombre de la aplicación que encabeza cada familia del sector
 *   (`applications.ts`); sin familias, la afirmación aprobada de Mercado
 *   Público y el enlace a cómo comprar por esa vía. Nada redactado aquí.
 * - `headingLevel`: nivel del nombre de cada tile según la página.
 */
interface Props {
  headingLevel?: 'h3' | 'h4';
}
const { headingLevel: Heading = 'h3' } = Astro.props;

const LEAD = ['Alimentos y agro', 'Salmón', 'Farma', 'Hospitales', 'Universidades', 'Sector público'];
const ordered = [...industries].sort(
  (a, b) => (LEAD.indexOf(a.name) + 1 || 99) - (LEAD.indexOf(b.name) + 1 || 99),
);
const leadApplication = (slug: FamilySlug) =>
  applications.find((application) => application.familyIds[0] === familyInfo(slug).scopeId);

const tiles = ordered.map((item) => {
  const apps = [...new Set(item.families.map(leadApplication).filter((app) => app !== undefined))];
  return apps.length > 0
    ? { name: item.name, line: apps.map((app) => app.name).join(' · '), href: `/aplicaciones/#${apps[0]!.slug}`, go: 'Ver equipos' }
    : { name: item.name, line: publicClaim('vende-mercado-publico'), href: item.href, go: 'Cómo cotizar' };
});
---

<ul class="ind">
  {
    tiles.map((tile) => (
      <li data-industry>
        <Heading class="ind__name">{tile.name}</Heading>
        {tile.line && <p class="ind__line">{tile.line}</p>}
        <a class="ind__go" href={tile.href}>
          {tile.go} <span aria-hidden="true">→</span>
          <span class="sr-only"> para {tile.name.toLowerCase()}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .ind {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(2rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ind > li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 0 2.25rem;
    border-top: 1px solid var(--color-hairline);
  }
  .ind__name {
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink-950);
  }
  .ind__line {
    max-width: 34ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-600);
  }
  .ind__go {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    align-self: flex-start;
    min-height: 2.75rem;
    margin-top: auto;
    color: var(--color-teal-700);
    font-weight: 600;
  }
  .ind__go:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 1023.98px) {
    .ind {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639.98px) {
    .ind {
      grid-template-columns: minmax(0, 1fr);
    }
    .ind > li {
      padding: 1.25rem 0 0.75rem;
    }
  }
</style>

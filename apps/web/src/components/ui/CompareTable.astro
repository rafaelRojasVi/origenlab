---
import type { Product } from '../../data/products';
import { productPageHref } from '../../lib/catalog';

/**
 * Comparativa de la familia. Tabla real en escritorio con región desplazable y
 * nombre accesible; bajo 768 px pasa a una lista de definición por modelo, que
 * es la única forma en que una tabla de seis columnas es usable en teléfono.
 */
interface Props {
  products: readonly Product[];
  rows: readonly string[];
  caption: string;
}

const { products, rows, caption } = Astro.props;

const NOT_STATED = 'No indicado';

function value(product: Product, label: string): string {
  return product.keySpecs?.find((spec) => spec.label === label)?.value ?? NOT_STATED;
}
---

<div class="compare">
  <div
    class="compare__scroll"
    role="region"
    aria-label={caption}
    tabindex="0"
  >
    <table>
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr>
          <th scope="col">Especificación</th>
          {
            products.map((product) => (
              <th scope="col">
                <a href={productPageHref(product)} class="link-plain">{product.name}</a>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((label) => (
            <tr>
              <th scope="row">{label}</th>
              {products.map((product) => {
                const cell = value(product, label);
                return (
                  <td class:list={['t-data', cell === NOT_STATED && 'is-unstated']}>{cell}</td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <ul class="compare__stack">
    {
      products.map((product) => (
        <li>
          <h3 class="t-h3">
            <a href={productPageHref(product)} class="link-plain">{product.name}</a>
          </h3>
          <dl>
            {rows.map((label) => {
              const cell = value(product, label);
              return (
                <div>
                  <dt>{label}</dt>
                  <dd class:list={['t-data', cell === NOT_STATED && 'is-unstated']}>{cell}</dd>
                </div>
              );
            })}
          </dl>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .compare__scroll {
    display: none;
  }
  .compare__stack {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-ink-950);
  }
  .compare__stack > li {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  /* Los nombres de modelo son objetivos táctiles reales, no texto corrido. */
  .compare a {
    display: inline-block;
    padding-block: 0.25rem;
  }
  .compare__stack dl {
    margin: 1rem 0 0;
  }
  .compare__stack dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1rem;
    padding-block: 0.375rem;
  }
  .compare__stack dt {
    font-size: 0.875rem;
    color: var(--color-ink-600);
  }
  .compare__stack dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-950);
  }

  @media (min-width: 768px) {
    .compare__stack {
      display: none;
    }
    .compare__scroll {
      display: block;
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }
    .compare table {
      width: 100%;
      border-collapse: collapse;
      font-variant-numeric: tabular-nums;
    }
    .compare th,
    .compare td {
      text-align: left;
      vertical-align: top;
      padding: 0.875rem 1.25rem 0.875rem 0;
      font-size: 0.9375rem;
    }
    .compare thead th {
      border-bottom: 1px solid var(--color-ink-950);
      color: var(--color-ink-950);
      font-weight: 600;
      white-space: nowrap;
    }
    .compare tbody th {
      color: var(--color-ink-600);
      font-weight: 400;
      white-space: nowrap;
      padding-right: 2.5rem;
    }
    .compare tbody tr + tr th,
    .compare tbody tr + tr td {
      border-top: 1px solid var(--color-hairline);
    }
    .compare tbody td {
      color: var(--color-ink-950);
    }
  }
</style>

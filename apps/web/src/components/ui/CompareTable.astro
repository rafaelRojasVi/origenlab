---
import { modelHref, SCALE_SPEC, type FamilySlug } from '../../lib/modelos';
import { rankModels } from '../../lib/ranking';
import type { Modelo } from '../../content.config';

/**
 * Comparativa compacta de una familia, debajo de las tarjetas: una fila por
 * modelo (orden comercial, `rankModels`) y tres o cuatro cifras del fabricante
 * en columnas. Las columnas salen de la ficha: la cifra que ordena la familia
 * (`SCALE_SPEC`) primero, después las etiquetas que más modelos comparten. Un
 * valor que la ficha no trae dice «En la ficha». El nombre lleva a la ficha.
 *
 * Bajo 768 px cada fila pasa a un bloque con sus cifras en dos columnas (la
 * etiqueta sale de `data-label`): una tabla de cuatro columnas no se lee en
 * un teléfono.
 */
interface Props {
  models: readonly Modelo[];
  family: FamilySlug;
  caption: string;
  /** Columnas fijas; sin ellas se eligen solas. */
  labels?: readonly string[];
  max?: number;
}

const { models, family, caption, labels, max = 3 } = Astro.props;
const ranked = rankModels(models.map((entry) => ({ id: entry.slug, entry }))).map(({ entry }) => entry);

function pick(): string[] {
  const count = new Map<string, number>();
  for (const entry of ranked) for (const spec of entry.specs) count.set(spec.label, (count.get(spec.label) ?? 0) + 1);
  const shared = [...count].filter(([, n]) => n >= 2).sort((a, b) => b[1] - a[1]).map(([label]) => label);
  const lead = SCALE_SPEC[family];
  return [...new Set([...(lead && count.has(lead) ? [lead] : []), ...shared])].slice(0, max);
}
const columns = labels ? [...labels] : pick();
const value = (entry: Modelo, label: string) => entry.specs.find((spec) => spec.label === label)?.value;
---

{
  columns.length > 0 && (
    <div class="cmp" role="region" aria-label={caption} tabindex="0" data-family-compare>
      <table>
        <caption class="sr-only">{caption}</caption>
        <thead>
          <tr>
            <th scope="col">Modelo</th>
            {columns.map((label) => <th scope="col">{label}</th>)}
          </tr>
        </thead>
        <tbody>
          {ranked.map((entry) => (
            <tr>
              <th scope="row">
                <a href={modelHref(entry)} translate="no">{entry.name}</a>
              </th>
              {columns.map((label) => {
                const cell = value(entry, label);
                return (
                  <td data-label={label} class:list={[!cell && 'is-off']}>
                    {cell ?? 'En la ficha'}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

<style>
  .cmp {
    border-radius: var(--radius-card);
  }
  .cmp table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .cmp thead {
    display: none;
  }
  .cmp tbody tr {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
    padding-block: 1.125rem;
    border-top: 1px solid var(--color-hairline);
  }
  .cmp tbody th {
    grid-column: 1 / -1;
    text-align: left;
  }
  .cmp td::before {
    content: attr(data-label);
    display: block;
    font-size: 0.8125rem;
    color: var(--color-ink-500);
  }
  .cmp a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-block: -0.5rem;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink-950);
    text-decoration: underline 1px transparent;
    text-underline-offset: 0.3em;
  }
  .cmp a:hover {
    color: var(--color-teal-800);
    text-decoration-color: currentColor;
  }
  .cmp td {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-ink-800);
  }
  .cmp .is-off {
    color: var(--color-ink-500);
  }
  @media (min-width: 768px) {
    .cmp {
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }
    .cmp thead {
      display: table-header-group;
    }
    .cmp tbody tr {
      display: table-row;
    }
    .cmp th,
    .cmp td {
      padding: 1rem 1.5rem 1rem 0;
      text-align: left;
      vertical-align: top;
    }
    .cmp thead th {
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--color-ink-500);
      white-space: nowrap;
    }
    .cmp td::before {
      content: none;
    }
  }
</style>

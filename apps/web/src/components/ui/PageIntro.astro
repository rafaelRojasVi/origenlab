---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

/**
 * Cabecera estándar de página interior: ruta, H1 y una frase de contexto.
 * Todas las páginas interiores usan esta composición; no hay variantes por página.
 */
interface Props {
  title: string;
  lead?: string;
  crumbs?: readonly Crumb[];
  /** Contenido opcional a la derecha en escritorio (logotipo, dato clave). */
  aside?: boolean;
}

const { title, lead, crumbs } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<header class="page-intro">
  {crumbs && <Breadcrumbs items={crumbs} />}
  <div class:list={['page-intro__body', hasAside && 'page-intro__body--split']}>
    <div>
      <h1 class="page-intro__title">{title}</h1>
      {lead && <p class="lede page-intro__lead">{lead}</p>}
    </div>
    {hasAside && (
      <div class="page-intro__aside">
        <slot name="aside" />
      </div>
    )}
  </div>
  <slot />
</header>

<style>
  /* Migas, titular grande del sitio claro (800, apretado) y la frase. Un
     resplandor teal/aqua suave detrás, como la primera pantalla de la portada. */
  .page-intro {
    position: relative;
    isolation: isolate;
    padding-top: 2rem;
    padding-bottom: 3.5rem;
  }
  .page-intro::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -4rem;
    right: -10%;
    width: min(56rem, 90vw);
    height: 30rem;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 38% 50%, var(--color-glow-teal) 0%, transparent 100%),
      radial-gradient(closest-side at 64% 46%, var(--color-glow-aqua) 0%, transparent 100%);
    opacity: 0.7;
    pointer-events: none;
  }
  .page-intro__title {
    max-width: 16ch;
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--color-ink-950);
    overflow-wrap: anywhere;
  }
  .page-intro__lead {
    margin-top: 1.25rem;
    max-width: 52ch;
  }
  .page-intro__body {
    margin-top: 1.5rem;
  }
  .page-intro__aside {
    margin-top: 2.5rem;
  }
  @media (min-width: 768px) {
    .page-intro {
      padding-top: 3rem;
    }
    .page-intro__body--split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 3rem;
    }
    .page-intro__aside {
      margin-top: 0;
    }
  }
</style>

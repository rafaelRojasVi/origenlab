---
import { TURNTABLE_FRAMES, turntableFor } from '../../lib/turntable';

/**
 * Equipo en 3D para una tarjeta del catálogo, sin WebGL: el póster horneado
 * sobre el estudio oscuro y, al pasar el mouse, al enfocar la tarjeta o al
 * arrastrar con el dedo, la tira de giro (24 cuadros, una vuelta) que
 * `npm run posters` genera junto al póster.
 *
 * - No es un control: no tiene tabulación propia ni rol. Gira cuando se enfoca
 *   el enlace que la contiene (el `<a>` de la tarjeta, o un ancestro con
 *   `data-tt-host`). La imagen lleva el `alt`; la tira es decorativa.
 * - Mouse: al entrar gira sola (~2 s por vuelta); al mover el puntero, el giro
 *   sigue al desplazamiento horizontal y retoma solo al quedarse quieto.
 *   Dedo: arrastre horizontal (el vertical desplaza la página). Al salir vuelve
 *   al póster.
 * - La tira (≤ 120 kB) se descarga en la primera intención, nunca al cargar.
 * - Con movimiento reducido queda el póster quieto.
 * - Caja 4:3 con fondo `--color-studio`, el mismo sobre el que se hornean
 *   póster y tira: sin salto de diseño y sin rectángulo visible. Hereda el
 *   radio del contenedor.
 *
 * Sin póster no dibuja nada: la plantilla elige antes con `turntableFor(slug)`
 * (`lib/turntable.ts`) y usa `LightBox` para los modelos sólo con fotografía.
 */
interface Props {
  /** Slug del modelo (`src/content/modelos/<slug>.json`). */
  slug: string;
  /** Texto alternativo del póster, p. ej. «MB32 de OHAUS, modelo 3D». */
  alt: string;
  /** `eager` sólo si la tarjeta está en la primera pantalla. */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { slug, alt, loading = 'lazy', class: className = '' } = Astro.props;
const files = turntableFor(slug);
---

{
  files && (
    <div class:list={['tt', className]} data-tt={files.strip ?? undefined} data-frames={TURNTABLE_FRAMES}>
      <img class="tt__poster" src={files.poster} width="1200" height="900" alt={alt} loading={loading} decoding="async" />
      {files.strip && <span class="tt__strip" aria-hidden="true" />}
    </div>
  )
}

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  for (const el of document.querySelectorAll<HTMLElement>('[data-tt]')) {
    const n = Number(el.dataset.frames) || 24;
    const strip = el.querySelector<HTMLElement>('.tt__strip')!;
    const host = el.closest<HTMLElement>('a, [data-tt-host]') ?? el;
    let ready: Promise<unknown> | null = null;
    let f = 0;
    let base = 0;
    let x0 = -1;
    let spin = 0;
    let rest = 0;
    const show = (i: number) => {
      f = ((Math.round(i) % n) + n) % n;
      strip.style.backgroundPositionX = `${(f * 100) / (n - 1)}%`;
    };
    const load = () =>
      (ready ??= new Promise((done) => {
        const img = new Image();
        img.onload = () => {
          strip.style.backgroundImage = `url(${el.dataset.tt})`;
          done(0);
        };
        img.src = el.dataset.tt!;
      }));
    const play = () => {
      clearInterval(spin);
      spin = window.setInterval(() => show(f + 1), 85);
    };
    const on = (auto: boolean) => {
      if (still.matches) return;
      load().then(() => {
        if (!host.matches(':hover, :focus-within') && x0 < 0) return;
        el.dataset.on = '';
        if (auto) play();
      });
    };
    const off = () => {
      clearInterval(spin);
      clearTimeout(rest);
      x0 = -1;
      delete el.dataset.on;
      show(0);
    };
    host.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && on(true));
    host.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && off());
    host.addEventListener('focusin', () => on(true));
    host.addEventListener('focusout', off);
    el.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') {
        x0 = e.clientX;
        base = f;
        on(false);
      }
    });
    el.addEventListener('pointermove', (e) => {
      if (!el.hasAttribute('data-on')) return;
      if (e.pointerType === 'mouse') {
        if (x0 < 0) {
          x0 = e.clientX;
          base = f;
        }
        clearInterval(spin);
        clearTimeout(rest);
        rest = window.setTimeout(() => {
          x0 = -1;
          play();
        }, 700);
      } else if (x0 < 0) return;
      show(base + ((e.clientX - x0) / el.clientWidth) * n);
    });
    for (const type of ['pointerup', 'pointercancel'])
      el.addEventListener(type, (e) => {
        if ((e as PointerEvent).pointerType !== 'mouse') rest = window.setTimeout(off, 1200);
      });
  }
</script>

<style>
  .tt {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: inherit;
    background-color: var(--color-studio);
    touch-action: pan-y;
  }
  .tt__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tt__strip {
    position: absolute;
    inset: 0;
    background: no-repeat 0 0 / 2400% 100%;
    opacity: 0;
    transition: opacity 0.2s ease-out;
    pointer-events: none;
  }
  .tt[data-on] .tt__strip {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .tt__strip {
      display: none;
    }
  }
</style>

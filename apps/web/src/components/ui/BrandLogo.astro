---
import type { Brand } from '../../data/brands';

/**
 * Logotipo de marca a tinta única. Las alturas ópticas viven en `brands.ts`
 * porque dependen del lockup de cada fabricante, no del contexto de uso.
 */
interface Props {
  brand: Brand;
  /** Multiplicador sobre la altura óptica declarada en los datos. */
  scale?: number;
  class?: string;
  [key: string]: unknown;
}

const { brand, scale = 1, class: className = '', ...rest } = Astro.props;
const height = Math.round((brand.logoDisplayHeight ?? 30) * scale);
const ratio = (brand.logoWidth ?? 1) / (brand.logoHeight ?? 1);
const width = Math.round(height * ratio);
---

{
  brand.logoPath && (
    <img
      src={brand.logoPath}
      alt={brand.logoAlt ?? `Logotipo de ${brand.name}`}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      style={`height:${height}px;width:auto`}
      class:list={['brand-logo', className]}
      {...rest}
    />
  )
}

<style>
  .brand-logo {
    display: block;
    max-width: 100%;
    object-fit: contain;
  }
</style>

---
import type { Brand } from '../../data/brands';

/**
 * Logotipo de marca a tinta única. Las alturas ópticas viven en `brands.ts`
 * porque dependen del lockup de cada fabricante, no del contexto de uso.
 *
 * Los siete archivos de `public/brands/` son una sola tinta grafito sobre
 * transparencia (`npm run build:brand-logos`). Sobre el showroom oscuro se
 * dibujan claros (`tone="light"`, por omisión): un filtro lleva la tinta a
 * `fg` sin tocar la transparencia, así que no hay caja blanca ni segundo juego
 * de archivos. `tone="ink"` deja la tinta original, sólo para una superficie
 * clara (la caja de luz).
 */
interface Props {
  brand: Brand;
  /** Multiplicador sobre la altura óptica declarada en los datos. */
  scale?: number;
  /**
   * Diferido por omisión. `eager` sólo donde el logotipo entra en la primera
   * pantalla o puede entrar en cuadro por movimiento sin que el visitante
   * desplace la página, que es el caso del riel de la portada: allí un
   * logotipo aún sin cargar aparecería en blanco al llegar a cuadro.
   */
  loading?: 'lazy' | 'eager';
  /** `light` (por omisión) sobre grafito; `ink` sobre una superficie clara. */
  tone?: 'light' | 'ink';
  class?: string;
  [key: string]: unknown;
}

const { brand, scale = 1, loading = 'lazy', tone = 'light', class: className = '', ...rest } = Astro.props;
const height = Math.round((brand.logoDisplayHeight ?? 30) * scale);
const ratio = (brand.logoWidth ?? 1) / (brand.logoHeight ?? 1);
const width = Math.round(height * ratio);
---

{
  brand.logoPath && (
    <img
      src={brand.logoPath}
      alt={brand.logoAlt ?? `Logotipo de ${brand.name}`}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      style={`height:${height}px;width:auto`}
      class:list={['brand-logo', tone === 'light' && 'brand-logo--light', className]}
      {...rest}
    />
  )
}

<style>
  .brand-logo {
    display: block;
    max-width: 100%;
    object-fit: contain;
  }
  /* Tinta grafito → clara (≈ `--color-fg`): negro y luego invertido al 93 %.
     `--brand-logo-filter` permite a la base retocar el tratamiento en un solo
     sitio si cambia el fondo. */
  .brand-logo--light {
    filter: var(--brand-logo-filter, brightness(0) invert(0.93));
  }
</style>

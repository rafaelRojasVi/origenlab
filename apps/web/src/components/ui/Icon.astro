---
/**
 * Iconografía del sitio: trazos de Tabler Icons (MIT), 24x24, stroke 1.5.
 * Un solo set, inline, sin dependencia en tiempo de ejecución. Añadir un icono
 * significa copiar su trazo oficial desde tabler.io/icons, no dibujarlo.
 */
export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'external'
  | 'whatsapp'
  | 'mail'
  | 'phone'
  | 'clock'
  | 'map-pin'
  | 'file'
  | 'chevron-down'
  | 'menu'
  | 'close';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  [key: string]: unknown;
}

/**
 * `rest` reenvía el atributo de ámbito que Astro añade a las etiquetas de
 * componente. Sin él, una clase pasada desde el padre queda sin estilo porque
 * el selector generado exige ese atributo en el elemento.
 */
const { name, size = 20, class: className = '', ...rest } = Astro.props;

const PATHS: Record<IconName, readonly string[]> = {
  'arrow-right': ['M5 12l14 0', 'M13 18l6 -6', 'M13 6l6 6'],
  'arrow-up-right': ['M17 7l-10 10', 'M8 7l9 0l0 9'],
  external: [
    'M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6',
    'M11 13l9 -9',
    'M15 4h5v5',
  ],
  whatsapp: [
    'M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9',
    'M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1',
  ],
  mail: [
    'M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z',
    'M3 7l9 6l9 -6',
  ],
  phone: [
    'M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2',
  ],
  clock: ['M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0', 'M12 7v5l3 3'],
  'map-pin': [
    'M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0',
    'M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z',
  ],
  file: [
    'M14 3v4a1 1 0 0 0 1 1h4',
    'M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z',
    'M9 13l6 0',
    'M9 17l6 0',
  ],
  'chevron-down': ['M6 9l6 6l6 -6'],
  menu: ['M4 8l16 0', 'M4 16l16 0'],
  close: ['M18 6l-12 12', 'M6 6l12 12'],
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['shrink-0', className]}
  {...rest}
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>

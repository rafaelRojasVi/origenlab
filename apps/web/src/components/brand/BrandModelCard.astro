---
import Turntable from '../ui/Turntable.astro';
import LightBox from '../ui/LightBox.astro';
import Button from '../ui/Button.astro';
import { ctaLabels } from '../../lib/ctaLabels';
import { familyInfo, imageForEntry, keyStats, modelHref } from '../../lib/modelos';
import { has3d } from '../../lib/brandShowcase';
import type { Modelo } from '../../content.config';

/**
 * Modelo iluminado de las páginas de marca (Tarea 3 del showroom oscuro).
 *
 * Construido directamente sobre `Turntable` (póster 3D + tira de giro) y
 * `LightBox` (fotografía de fabricante sobre el plinto claro), sin pasar por
 * `ModelCard`, que la Tarea 2 rediseña en paralelo; el controlador los unifica
 * al fusionar.
 *
 * - `card` (`/marcas/<slug>/`): tarjeta iluminada. Escenario, familia, nombre,
 *   primera frase de la ficha, dos cifras del fabricante, «Ver ficha» y
 *   «Cotizar» (el formulario recibe el modelo). El escenario es un enlace a la
 *   ficha fuera del orden de tabulación (el nombre y «Ver ficha» ya lo son):
 *   así el giro sigue al puntero y al dedo sobre la imagen.
 * - `tile` (`/marcas/`): escenario, nombre y una cifra; todo es un enlace, y
 *   enfocarlo hace girar el modelo.
 *
 * Las cifras salen de las especificaciones con fuente de la ficha
 * (`keyStats`), nunca de texto escrito aquí.
 */
interface Props {
  entry: Modelo;
  brandName: string;
  variant: 'card' | 'tile';
  /** Sólo la primera fila visible sin desplazar. */
  loading?: 'lazy' | 'eager';
}

const { entry, brandName, variant, loading = 'lazy' } = Astro.props;
const href = modelHref(entry);
const family = familyInfo(entry.family);
const spins = has3d(entry);
const image = spins ? undefined : imageForEntry(entry);
const alt = `${entry.name} de ${brandName}, modelo 3D`;
const stats = keyStats(entry, 2);
const firstSentence = entry.lead.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? entry.lead;
const familyTone = entry.family === 'pesaje-humedad' ? 'pesaje' : entry.family;
---

{
  variant === 'tile' ? (
    <a href={href} class="bmt">
      <div class="bmt__stage">
        {spins ? <Turntable slug={entry.slug} alt={alt} loading={loading} /> : <LightBox image={image} brandName={brandName} size="sheet" />}
        {spins && <span class="bm-badge" aria-hidden="true">3D</span>}
      </div>
      <span class="bmt__name" translate="no">{entry.name}</span>
      {stats[0] && <span class="bmt__fact">{stats[0].value}</span>}
    </a>
  ) : (
    <article class="bmc card-lit" style={`--bm-family: var(--color-family-${familyTone})`}>
      <a href={href} class="bmc__stage" tabindex="-1" aria-hidden="true">
        {spins ? <Turntable slug={entry.slug} alt={alt} loading={loading} /> : <LightBox image={image} brandName={brandName} size="card" />}
        {spins && <span class="bm-badge">3D</span>}
      </a>
      <div class="bmc__body">
        <p class="bmc__kicker">{family.short}</p>
        <h3 class="bmc__name" translate="no">
          <a href={href}>{entry.name}</a>
        </h3>
        <p class="bmc__lead">{firstSentence}</p>
        {stats.length > 0 && (
          <dl class="bmc__facts">
            {stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
        )}
        <div class="bmc__acts">
          <Button href={href} variant="tertiary">{ctaLabels.viewProductDetail}</Button>
          <Button href={`/contacto/?producto=${entry.slug}`} variant="secondary" size="sm" arrow={false}>
            {ctaLabels.cotizar}
          </Button>
        </div>
      </div>
    </article>
  )
}

<style>
  /* Rótulo «3D» sobre el estudio: sólo en los modelos que giran. */
  .bm-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-band-line);
    border-radius: 999px;
    background: rgb(13 15 16 / 0.6);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--color-teal-700);
    pointer-events: none;
  }

  /* --- tile (índice de marcas) ------------------------------------------- */
  .bmt {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    border-radius: 0.75rem;
  }
  .bmt__stage {
    position: relative;
    margin-bottom: 0.75rem;
    border-radius: 0.75rem;
    overflow: hidden;
    outline: 1px solid var(--color-hairline);
    transition: outline-color var(--ease-ui);
  }
  .bmt:is(:hover, :focus-visible) .bmt__stage {
    outline-color: var(--color-ink-500);
  }
  .bmt__name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink-950);
  }
  .bmt:hover .bmt__name {
    color: var(--color-teal-800);
  }
  .bmt__fact {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-600);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* --- card (página de marca) -------------------------------------------- */
  .bmc {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.5rem;
  }
  .bmc__stage {
    position: relative;
    display: block;
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .bmc__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1rem 1rem;
  }
  .bmc__kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-600);
  }
  .bmc__kicker::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--bm-family, var(--color-accent));
  }
  .bmc__name {
    margin-top: 0.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
    color: var(--color-ink-950);
  }
  .bmc__name a:hover {
    color: var(--color-teal-800);
  }
  .bmc__lead {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-600);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .bmc__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-hairline);
  }
  .bmc__facts dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }
  .bmc__facts dd {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink-900);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .bmc__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }
</style>

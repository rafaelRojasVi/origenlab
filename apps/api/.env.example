# apps/api environment example — placeholders only. Never commit real values.
#
# Core backend (see README.md for the full production checklist):
# ORIGENLAB_API_BACKEND=sqlite
# ORIGENLAB_POSTGRES_URL=postgresql+psycopg://user:CHANGE_ME@127.0.0.1:5433/origenlab_test
#
# Durable CRM writes (restricted writer role; never fall back to the read URL):
# ORIGENLAB_COMMERCIAL_OPERATIONS_WRITES_ENABLED=true
# ORIGENLAB_POSTGRES_WRITE_URL=postgresql+psycopg://crm_writer:CHANGE_ME@127.0.0.1:5433/origenlab_test

# ---------------------------------------------------------------------------
# CRM-Q1 — quote Drive workspace provisioning (all fail closed until set).
# Child folders inherit access from the configured root folder; the adapter
# performs no sharing/permission mutations.
#
# Hierarchy (CRM-Q1D): the root is never a creation target. Every new quote
# workspace folder is created under the Pendientes container instead:
#
#   Cotizaciones/                        <- ROOT_FOLDER_ID
#   |-- Pendientes/                      <- PENDING_FOLDER_ID (create target)
#   |   `-- <quote number> - <customer>/
#   |       `-- <template copy>
#   `-- Enviadas/                        <- SENT_FOLDER_ID (optional; unused
#                                            until a `sent` lifecycle exists)
#
# Two authentication modes are supported (ORIGENLAB_DRIVE_AUTH_MODE) because
# a bare service account has no My Drive storage quota and cannot own files
# there -- it is valid only against a Shared Drive destination:
#
#   authorized_user_my_drive     -- an authorized-user credentials JSON with
#                                    an offline refresh token, acting as a
#                                    human Google identity. Required when the
#                                    quotations root/template live in a
#                                    personal My Drive (the current
#                                    production destination).
#   service_account_shared_drive -- a service-account credentials JSON,
#                                    valid only when
#                                    ORIGENLAB_DRIVE_SHARED_DRIVE_ID is also
#                                    set and the root folder actually lives
#                                    inside that Shared Drive. Otherwise
#                                    fails closed as
#                                    drive_auth_mode_incompatible before any
#                                    Drive mutation.
#
# Requires the optional credential dependency (uv sync --extra drive); the
# production Docker image installs it by default -- see apps/api/Dockerfile.
# A local dev shell needs the same: uv sync --extra drive
#
# ORIGENLAB_DRIVE_EXPECTED_PRINCIPAL_EMAIL, when set, makes the read-only
# preflight check verify (via Drive about.get) that the credentials in use
# actually belong to that account -- fails closed as drive_principal_mismatch
# on any other identity, before any mutation.
#
# Before activating, run the read-only preflight check (no Drive mutation):
#   cd apps/api && uv run python scripts/drive_preflight.py
# ---------------------------------------------------------------------------
# Drive folder ID of the OrigenLab quotations root folder (e.g. Cotizaciones):
# ORIGENLAB_DRIVE_QUOTES_ROOT_FOLDER_ID=REPLACE_WITH_DRIVE_FOLDER_ID
# Drive folder ID under which every new quote workspace is created (e.g.
# Cotizaciones/Pendientes); must be a direct child of the root above.
# ORIGENLAB_DRIVE_QUOTES_PENDING_FOLDER_ID=REPLACE_WITH_DRIVE_FOLDER_ID
# Optional: Drive folder ID for quotes after being sent (e.g.
# Cotizaciones/Enviadas). Verified read-only by preflight when set; no
# `sent` lifecycle exists yet, so nothing writes here today.
# ORIGENLAB_DRIVE_QUOTES_SENT_FOLDER_ID=REPLACE_WITH_DRIVE_FOLDER_ID
# Drive file ID of the master quotation spreadsheet template:
# ORIGENLAB_DRIVE_QUOTE_TEMPLATE_FILE_ID=REPLACE_WITH_TEMPLATE_FILE_ID
# Auth mode: authorized_user_my_drive | service_account_shared_drive
# ORIGENLAB_DRIVE_AUTH_MODE=authorized_user_my_drive
# Path to the credentials JSON file for the configured auth mode.
# ORIGENLAB_DRIVE_CREDENTIALS_FILE=/secure/path/origenlab-drive-credentials.json
# Expected Drive identity; the preflight check fails closed on a mismatch.
# ORIGENLAB_DRIVE_EXPECTED_PRINCIPAL_EMAIL=contacto@origenlab.cl
# Shared Drive ID -- required in service_account_shared_drive mode, optional
# (scopes discovery) in authorized_user_my_drive mode:
# ORIGENLAB_DRIVE_SHARED_DRIVE_ID=REPLACE_WITH_SHARED_DRIVE_ID

# ---------------------------------------------------------------------------
# CRM-Q1 — quote numbering activation. This is the recorded business
# decision for the durable quote-number series. The allocated serial powers
# two distinct identifiers: the human customer-facing quote_number
# (<serial>-<2-digit issue year>, e.g. "01183-26") and the separate Drive
# document_number (<document prefix><serial>, e.g. "CN01183").
# ORIGENLAB_QUOTE_DOCUMENT_PREFIX is NEVER part of quote_number. Until ALL
# THREE are set (and valid), quote creation fails closed as
# quote_numbering_not_configured. The seed applies only on the very first
# allocation; afterwards the durable
# commercial.customer_quote_number_series row is the counter truth.
#
# (Pre-CRM-Q1D env names ORIGENLAB_QUOTE_NUMBER_PREFIX/_PAD_WIDTH/
# _SEED_NEXT_SERIAL collapsed the document prefix into the human number and
# are no longer recognized -- setting them has no effect and numbering
# stays unconfigured.)
# ---------------------------------------------------------------------------
# ORIGENLAB_QUOTE_DOCUMENT_PREFIX=CN
# ORIGENLAB_QUOTE_SERIAL_PAD_WIDTH=5
# ORIGENLAB_QUOTE_SEED_NEXT_SERIAL=REPLACE_WITH_NEXT_SERIAL

# apps/api environment example — placeholders only. Never commit real values.
#
# Core backend (see README.md for the full production checklist):
# ORIGENLAB_API_BACKEND=sqlite
# ORIGENLAB_POSTGRES_URL=postgresql+psycopg://user:CHANGE_ME@127.0.0.1:5433/origenlab_test
#
# Durable CRM writes (restricted writer role; never fall back to the read URL):
# ORIGENLAB_COMMERCIAL_OPERATIONS_WRITES_ENABLED=true
# ORIGENLAB_POSTGRES_WRITE_URL=postgresql+psycopg://crm_writer:CHANGE_ME@127.0.0.1:5433/origenlab_test

# ---------------------------------------------------------------------------
# CRM-Q1 — quote Drive workspace provisioning (all fail closed until set).
# Child folders inherit access from the configured root folder; the adapter
# performs no sharing/permission mutations.
#
# Hierarchy (CRM-Q1D): the root is never a creation target. Every new quote
# workspace folder is created under the Pendientes container instead:
#
#   Cotizaciones/                        <- ROOT_FOLDER_ID
#   |-- Pendientes/                      <- PENDING_FOLDER_ID (create target)
#   |   `-- <quote number> - <customer>/
#   |       `-- <template copy>
#   `-- Enviadas/                        <- SENT_FOLDER_ID (optional; unused
#                                            until a `sent` lifecycle exists)
#
# Two authentication modes are supported (ORIGENLAB_DRIVE_AUTH_MODE) because
# a bare service account has no My Drive storage quota and cannot own files
# there -- it is valid only against a Shared Drive destination:
#
#   authorized_user_my_drive     -- an authorized-user credentials JSON with
#                                    an offline refresh token, acting as a
#                                    human Google identity. Required when the
#                                    quotations root/template live in a
#                                    personal My Drive (the current
#                                    production destination).
#   service_account_shared_drive -- a service-account credentials JSON,
#                                    valid only when
#                                    ORIGENLAB_DRIVE_SHARED_DRIVE_ID is also
#                                    set and the root folder actually lives
#                                    inside that Shared Drive. Otherwise
#                                    fails closed as
#                                    drive_auth_mode_incompatible before any
#                                    Drive mutation.
#
# Requires the optional credential dependency (uv sync --extra drive); the
# production Docker image installs it by default -- see apps/api/Dockerfile.
# A local dev shell needs the same: uv sync --extra drive
#
# ORIGENLAB_DRIVE_EXPECTED_PRINCIPAL_EMAIL, when set, makes the read-only
# preflight check verify (via Drive about.get) that the credentials in use
# actually belong to that account -- fails closed as drive_principal_mismatch
# on any other identity, before any mutation.
#
# Before activating, run the read-only preflight check (no Drive mutation):
#   cd apps/api && uv run python scripts/drive_preflight.py
# ---------------------------------------------------------------------------
# Drive folder ID of the OrigenLab quotations root folder (e.g. Cotizaciones):
# ORIGENLAB_DRIVE_QUOTES_ROOT_FOLDER_ID=REPLACE_WITH_DRIVE_FOLDER_ID
# Drive folder ID under which every new quote workspace is created (e.g.
# Cotizaciones/Pendientes); must be a direct child of the root above.
# ORIGENLAB_DRIVE_QUOTES_PENDING_FOLDER_ID=REPLACE_WITH_DRIVE_FOLDER_ID
# Optional: Drive folder ID for quotes after being sent (e.g.
# Cotizaciones/Enviadas). Verified read-only by preflight when set; no
# `sent` lifecycle exists yet, so nothing writes here today.
# ORIGENLAB_DRIVE_QUOTES_SENT_FOLDER_ID=REPLACE_WITH_DRIVE_FOLDER_ID
# Drive file ID of the master quotation spreadsheet template:
# ORIGENLAB_DRIVE_QUOTE_TEMPLATE_FILE_ID=REPLACE_WITH_TEMPLATE_FILE_ID
# Explicit activation gate for template-document provisioning. Fail-safe
# default false: while off, a generated quote's Drive workspace folder is
# still created under Pendientes and the durable quote/CRM card still land
# normally -- only the template copy step is skipped. Turn this on only
# once the master template is finalized and ORIGENLAB_DRIVE_QUOTE_TEMPLATE_FILE_ID
# points at a real, copyable file.
# ORIGENLAB_DRIVE_QUOTE_TEMPLATE_PROVISIONING_ENABLED=false
# Auth mode: authorized_user_my_drive | service_account_shared_drive
# ORIGENLAB_DRIVE_AUTH_MODE=authorized_user_my_drive
# Path to the credentials JSON file for the configured auth mode.
# ORIGENLAB_DRIVE_CREDENTIALS_FILE=/secure/path/origenlab-drive-credentials.json
# Expected Drive identity; the preflight check fails closed on a mismatch.
# ORIGENLAB_DRIVE_EXPECTED_PRINCIPAL_EMAIL=contacto@origenlab.cl
# Shared Drive ID -- required in service_account_shared_drive mode, optional
# (scopes discovery) in authorized_user_my_drive mode:
# ORIGENLAB_DRIVE_SHARED_DRIVE_ID=REPLACE_WITH_SHARED_DRIVE_ID

# ---------------------------------------------------------------------------
# CRM-Q1 — quote numbering activation. This is the recorded business
# decision for the durable quote-number series. The allocated serial powers
# two distinct identifiers: the human customer-facing quote_number
# (<serial>-<2-digit issue year>, e.g. "01183-26") and the separate Drive
# document_number (<document prefix><serial>, e.g. "CN01183").
# ORIGENLAB_QUOTE_DOCUMENT_PREFIX is NEVER part of quote_number. Until ALL
# THREE are set (and valid), quote creation fails closed as
# quote_numbering_not_configured. The seed applies only on the very first
# allocation; afterwards the durable
# commercial.customer_quote_number_series row is the counter truth.
#
# (Pre-CRM-Q1D env names ORIGENLAB_QUOTE_NUMBER_PREFIX/_PAD_WIDTH/
# _SEED_NEXT_SERIAL collapsed the document prefix into the human number and
# are no longer recognized -- setting them has no effect and numbering
# stays unconfigured.)
# ---------------------------------------------------------------------------
# ORIGENLAB_QUOTE_DOCUMENT_PREFIX=CN
# ORIGENLAB_QUOTE_SERIAL_PAD_WIDTH=5
# ORIGENLAB_QUOTE_SEED_NEXT_SERIAL=REPLACE_WITH_NEXT_SERIAL

# --- V2 durable read boundary (/v2/*) ---------------------------------------
# Both are unset by default. Without ORIGENLAB_V2_DATABASE_URL the /v2 router is
# not mounted at all, so an unconfigured deployment gets no V2 surface rather
# than one that errors on every request.
#
# Locally, generate the DSN with:
#   supabase/scripts/dev_db.sh api-login
# It writes ~/data/origenlab-v2-local/api.env (mode 0600, outside Git). Never
# paste a real DSN into this file.
# ORIGENLAB_V2_DATABASE_URL=postgresql://origenlab_api:CHANGE_ME@127.0.0.1:54332/origenlab_dev
#
# When set, Supabase Auth JWKS verification is used and the local development
# identity adapter is never constructed. Unset while the hosted phase is frozen
# (docs/OPERATIONS.md 1.1); JWKS verification itself arrives with slice 1.
# ORIGENLAB_V2_JWKS_URL=
# ORIGENLAB_V2_STATEMENT_TIMEOUT_MS=15000
# Mercado Público ticket for opening a tender by code (secret; falls back to CHILECOMPRA_API_TICKET).
# Without it «Nueva licitación» asks for the buyer by hand.
# ORIGENLAB_V2_CHILECOMPRA_TICKET=CHANGE_ME
#
# --- Dashboard login for /v2 (docs/PRODUCTION_AUTH.md, "Google Workspace login") -
# With ORIGENLAB_V2_DATABASE_URL set, ONE of the two must be switched on or the API
# refuses to start. Neither is on by default.
#
# (a) Local development header login. Resolves the operator from the
#     X-OriginLab-Operator-Email header the Vite dev server injects from
#     ORIGENLAB_DEV_OPERATOR_EMAIL. Loopback database only; refused when
#     ORIGENLAB_ENV=production.
# ORIGENLAB_DEV_LOGIN_ENABLED=true
#
# (b) Google Workspace sign-in (scopes: openid email profile — nothing else).
#     Secrets go in ~/data/origenlab-v2-local/api.env or a secret store, never here.
# ORIGENLAB_GOOGLE_AUTH_ENABLED=true
# ORIGENLAB_GOOGLE_CLIENT_ID=
# ORIGENLAB_GOOGLE_CLIENT_SECRET=
# ORIGENLAB_GOOGLE_WORKSPACE_DOMAIN=origenlab.cl
#     Where the browser reaches /auth/*. Local: the Vite dev server.
# ORIGENLAB_AUTH_PUBLIC_BASE_URL=http://localhost:5173
#     At least 32 characters: python -c 'import secrets; print(secrets.token_urlsafe(48))'
#     Also keys the opaque address_ref; required in production whenever V2 is configured.
# ORIGENLAB_AUTH_SESSION_SECRET=
# ORIGENLAB_AUTH_SESSION_TTL_SECONDS=28800
#
# (c) Shared Workspace login with operator profiles (docs/PRODUCTION_AUTH.md). Off by default.
# ORIGENLAB_PROFILE_LOGIN_ENABLED=false
# ORIGENLAB_PROFILE_PIN_PEPPER=          # secret, >= 32 chars, never the session secret
# ORIGENLAB_DEV_PROFILE_PRINCIPAL_EMAIL= # local only, an invented *.test / *.invalid address

# ---------------------------------------------------------------------------
# SQLite / recovery mode (uncommon; usually only ORIGENLAB_SQLITE_PATH is set).
# Recovery mode requires all three together — any two is an error.
# ---------------------------------------------------------------------------
# ORIGENLAB_SQLITE_IMMUTABLE_RO=false        # open SQLite with immutable=1 (read-only compacted copy)
# ORIGENLAB_SQLITE_CONFIRM_OFFLINE_COPY=false # confirm the file is an offline copy (prevents accidents)
# ORIGENLAB_SQLITE_COMPACTION_MANIFEST=      # path to the completed compaction manifest JSON

# ---------------------------------------------------------------------------
# Tender terms and import directories (email-pipeline integration).
# ORIGENLAB_TENDER_TERMS_DIR holds processed T1/T2 term files per procurement.
# ---------------------------------------------------------------------------
# ORIGENLAB_TENDER_TERMS_DIR=                       # absolute path; defaults to canonical T1
# ORIGENLAB_OPERATOR_TENDER_IMPORT_DIR=             # drop folder for operator-imported tender packages

# ---------------------------------------------------------------------------
# Additional SQLite paths used by the API mirror.
# ---------------------------------------------------------------------------
# ORIGENLAB_ACTIVE_CURRENT=                  # path to the current active emails.sqlite
# ORIGENLAB_INSTITUTION_PROSPECT_DIR=        # directory of per-institution prospect data

# ---------------------------------------------------------------------------
# Disable dotenv loading (used in production images that inject all values
# as real environment variables).
# ---------------------------------------------------------------------------
# ORIGENLAB_DISABLE_DOTENV=false

# ---------------------------------------------------------------------------
# V2 Postgres pool tuning (defaults are appropriate for most deployments).
# ---------------------------------------------------------------------------
# ORIGENLAB_POSTGRES_STATEMENT_TIMEOUT_MS=30000
# ORIGENLAB_POSTGRES_POOL_SIZE=5
# ORIGENLAB_V2_POOL_MIN_SIZE=4
# ORIGENLAB_V2_POOL_MAX_SIZE=8

# ---------------------------------------------------------------------------
# V2 remote database (hosted phase; requires explicit opt-in).
# Set only when ORIGENLAB_V2_DATABASE_URL points at a remote Supabase host.
# ---------------------------------------------------------------------------
# ORIGENLAB_V2_DATABASE_REMOTE=false
# ORIGENLAB_V2_DATABASE_EXPECTED_HOST=       # exact pooler host name
# ORIGENLAB_V2_DATABASE_SSLROOTCERT=         # absolute path to the CA PEM file

# ---------------------------------------------------------------------------
# V2 feature switches (all false by default; each activates one route group).
# ---------------------------------------------------------------------------
# ORIGENLAB_V2_COMMANDS_ENABLED=false           # POST /v2/commands/*
# ORIGENLAB_V2_AUTO_MAIL_RULES_INTERVAL_SECONDS=300  # 0 = never start the timer
# ORIGENLAB_V2_AUTO_RULE_R14_ENABLED=false
# ORIGENLAB_V2_AUTO_RULE_R15_ENABLED=false
# ORIGENLAB_V2_CAMPAIGN_DRAFTS_ENABLED=false    # POST /v2/commands/{create,save}-campaign-draft
# ORIGENLAB_V2_CRM_AUTHORING_ENABLED=false      # POST /v2/commands/create/update-person/org
# ORIGENLAB_V2_QUOTING_ENABLED=false            # GET/POST /v2/catalog/*
# ORIGENLAB_V2_CAMPAIGN_TEST_SEND_ENABLED=false # POST /v2/commands/send-campaign-test
# ORIGENLAB_V2_WEB_QUOTE_FORM_ENABLED=false     # POST /v2/web/quote-request
# ORIGENLAB_V2_AUDIENCE_FREEZE_ENABLED=false    # POST /v2/commands/freeze-campaign-audience
# ORIGENLAB_V2_RECONTACT_REVIEW_ENABLED=false   # W12 recontact approval inside freeze
# ORIGENLAB_V2_CAMPAIGN_PLANNING_ENABLED=false  # POST /v2/commands/set-campaign-planning
# ORIGENLAB_V2_CAMPAIGN_BLOCKS_ENABLED=false    # POST /v2/commands/block/unblock-campaign
# ORIGENLAB_V2_UNSUBSCRIBE_APPLY_ENABLED=false  # POST /v2/commands/apply-unsubscribe-replies

# ---------------------------------------------------------------------------
# V2 Banco Central FX credentials (needed for /v2/catalog/fx).
# A BDE API key token (Mi Cuenta → Apikey Token at si3.bcentral.cl; valid one year) is
# preferred over user + password. Either pair grants access.
# ---------------------------------------------------------------------------
# ORIGENLAB_V2_BDE_USER=                     # BDE web-service username
# ORIGENLAB_V2_BDE_PASSWORD=                 # BDE web-service password (secret)
# ORIGENLAB_V2_BDE_TOKEN=                    # BDE API key token (preferred; secret)
# ORIGENLAB_V2_BDE_SERIES_USD=F073.TCO.PRE.Z.D    # dólar observado series (default)
# ORIGENLAB_V2_BDE_SERIES_EUR=F072.CLP.EUR.N.O.D  # euro series (default)

# ---------------------------------------------------------------------------
# V2 Supabase Storage (product images for /v2/catalog/images/*).
# ---------------------------------------------------------------------------
# ORIGENLAB_V2_STORAGE_URL=https://<ref>.supabase.co   # project origin
# ORIGENLAB_V2_STORAGE_SECRET_KEY=CHANGE_ME              # sb_secret_… service key (secret)

# ---------------------------------------------------------------------------
# V2 Gmail send token (for send-campaign-test and the web quote-form reply).
# Written by scripts/gmail_send_authorize.py; path goes here, never the token itself.
# ---------------------------------------------------------------------------
# ORIGENLAB_V2_GMAIL_SEND_TOKEN_FILE=/secure/path/origenlab-gmail-send-token.json

# ---------------------------------------------------------------------------
# API production / security settings.
# ---------------------------------------------------------------------------
# ORIGENLAB_ENV=                             # production | prod (enables stricter checks)
# ORIGENLAB_API_AUTH_TOKEN=                  # bearer token for non-public routes in production
# ORIGENLAB_API_CORS_ORIGINS=               # comma-separated browser origins (no wildcards)
# ORIGENLAB_API_ALLOWED_HOSTS=              # comma-separated Host header values
# ORIGENLAB_API_DISABLE_DOCS=false          # hide /docs, /redoc, /openapi.json

# ---------------------------------------------------------------------------
# Drive «Casos» quick-link (links «Hoy»'s «Drive casos» button; same value
# as ORIGENLAB_WORKER_DRIVE_CASOS_FOLDER_ID in the worker).
# ---------------------------------------------------------------------------
# ORIGENLAB_DRIVE_CASOS_FOLDER_ID=REPLACE_WITH_DRIVE_FOLDER_ID

# ---------------------------------------------------------------------------
# V2 local-review-only directories (never set in production).
# ---------------------------------------------------------------------------
# ORIGENLAB_V2_IMPORT_REVIEW_PLAN_DIR=       # quote-crm-import dry-run directory
# ORIGENLAB_V2_IMPORT_REVIEW_DOCUMENTS_ROOT= # PDF root for the import plan
# ORIGENLAB_V2_CASE_ARCHIVE_DIR=            # case-migration dry-run directory
# ORIGENLAB_V2_CASE_ARCHIVE_UPLOAD_REPORTS= # comma-separated upload report paths
# ORIGENLAB_V2_DRIVE_ARCHIVE_LEDGERS=       # comma-separated archive_links.jsonl paths
# ORIGENLAB_V2_V1_LANE_CONTENT_DIR=         # V1-lane campaign HTML directory
# ORIGENLAB_V2_ORG_SUGGESTIONS_FILE=        # per-institution web-research facts JSON

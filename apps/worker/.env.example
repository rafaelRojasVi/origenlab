# apps/worker environment example — placeholders only. Never commit real values.
#
# All variables are required unless marked optional.
# Production values go in Render secret files or environment groups, never here.

# ---------------------------------------------------------------------------
# V2 database connection (Supabase Supavisor session pooler).
# The worker connects as origenlab_worker.<project-ref> with sslmode=verify-full.
# ---------------------------------------------------------------------------
# ORIGENLAB_WORKER_DATABASE_URL=postgresql://origenlab_worker.CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/postgres
# ORIGENLAB_WORKER_DATABASE_EXPECTED_HOST=CHANGE_ME          # exact pooler host (validation)
# ORIGENLAB_WORKER_DATABASE_CA_PEM=                          # Supabase CA certificate (PEM text, not a path)

# ---------------------------------------------------------------------------
# Gmail capture (OAuth 2.0 Internal app — contacto@origenlab.cl).
# ---------------------------------------------------------------------------
# ORIGENLAB_WORKER_GMAIL_CLIENT_ID=CHANGE_ME
# ORIGENLAB_WORKER_GMAIL_CLIENT_SECRET=CHANGE_ME             # secret
# ORIGENLAB_WORKER_GMAIL_REFRESH_TOKEN=CHANGE_ME             # secret; generated by gmail_send_authorize.py
# ORIGENLAB_WORKER_GMAIL_SYNC_ENABLED=true                   # false (or anything else) pauses; exit 0

# ---------------------------------------------------------------------------
# Drive filing (contacto@'s OAuth consent — archives PDFs to Cotizaciones/Casos).
# ---------------------------------------------------------------------------
# ORIGENLAB_WORKER_DRIVE_CLIENT_ID=CHANGE_ME
# ORIGENLAB_WORKER_DRIVE_CLIENT_SECRET=CHANGE_ME             # secret
# ORIGENLAB_WORKER_DRIVE_REFRESH_TOKEN=CHANGE_ME             # secret
# ORIGENLAB_WORKER_DRIVE_CASOS_FOLDER_ID=REPLACE_WITH_DRIVE_FOLDER_ID  # Cotizaciones/Casos
# ORIGENLAB_WORKER_DRIVE_PROTECTED_FOLDER_IDS=               # optional, comma-separated legacy folders
# ORIGENLAB_WORKER_DRIVE_EXPECTED_PRINCIPAL=contacto@origenlab.cl  # optional; default shown
# ORIGENLAB_WORKER_DRIVE_FILING_ENABLED=true                 # false (or anything else) pauses; exit 0

# ---------------------------------------------------------------------------
# Quote reader (Claude API — reads PDF quotations and records neto).
# ---------------------------------------------------------------------------
# ORIGENLAB_WORKER_QUOTE_READ_ENABLED=false                  # true to enable quote reading
# ORIGENLAB_WORKER_QUOTE_READ_MODEL=CHANGE_ME                # Claude model ID
# ORIGENLAB_WORKER_ANTHROPIC_API_KEY=CHANGE_ME               # secret

# ---------------------------------------------------------------------------
# Supabase Storage (S3-compatible; used by the worker for asset uploads).
# ---------------------------------------------------------------------------
# ORIGENLAB_WORKER_STORAGE_S3_ENDPOINT=https://CHANGE_ME.supabase.co/storage/v1/s3
# ORIGENLAB_WORKER_STORAGE_S3_REGION=CHANGE_ME
# ORIGENLAB_WORKER_STORAGE_S3_ACCESS_KEY_ID=CHANGE_ME
# ORIGENLAB_WORKER_STORAGE_S3_SECRET_ACCESS_KEY=CHANGE_ME   # secret

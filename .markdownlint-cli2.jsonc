{
  // Ignore generated or environment paths.
  "ignores": [
    ".venv/**",
    "**/.venv/**",
    "node_modules/**",
    "**/node_modules/**",
    "docs/sources/kraken-llms.txt"
  ],
  "config": {
    // Long API paths, commands, URLs, and audit prose are intentionally unwrapped.
    "MD013": false,
    // Generated/link-index style docs may intentionally contain bare URLs.
    "MD034": false
  }
}
